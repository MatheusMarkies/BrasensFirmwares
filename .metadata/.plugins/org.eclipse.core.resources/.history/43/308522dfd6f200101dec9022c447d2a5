/**
 * @brief Envia comando ISO15693 e recebe resposta
 */
static HAL_StatusTypeDef ISO15693_SendCommand(ST25DV_Handle *dev,
                                              const uint8_t *cmd,
                                              uint16_t cmd_len,
                                              uint8_t *response,
                                              uint16_t *resp_len,
                                              uint32_t timeout_ms)
{
    HAL_StatusTypeDef status;
    ST25R300_Handle *reader = dev->reader;
    uint16_t fifo_bytes;

    // 1. Parar atividades anteriores
    status = ST25R300_DirectCommand(reader, ST25R300_CMD_STOP_ALL);
    if (status != HAL_OK) return status;

    // 2. Limpar FIFO
    status = ST25R300_DirectCommand(reader, ST25R300_CMD_CLEAR_FIFO);
    if (status != HAL_OK) return status;

    // 3. Limpar IRQs
    status = ST25R300_ClearIRQ(reader);
    if (status != HAL_OK) return status;

    // 4. Configurar número de bytes a transmitir (página 69)
    // TX Frame Config: ntx[12:5]
    status = ST25R300_WriteRegister(reader, ST25R300_REG_TX_FRAME_CONFIG1,
                                    (cmd_len >> 5) & 0xFF);
    if (status != HAL_OK) return status;

    // TX Frame Config: ntx[4:0] e nbtx[2:0]=0 (só bytes completos)
    status = ST25R300_WriteRegister(reader, ST25R300_REG_TX_FRAME_CONFIG2,
                                    (cmd_len & 0x1F) << 3);
    if (status != HAL_OK) return status;

    // 5. Escrever comando no FIFO
    status = ST25R300_WriteFIFO(reader, cmd, cmd_len);
    if (status != HAL_OK) return status;

    // 6. Transmitir dados
    status = ST25R300_DirectCommand(reader, ST25R300_CMD_TRANSMIT_DATA);
    if (status != HAL_OK) return status;

    // 7. Aguardar fim de transmissão (I_txe)
    status = ST25R300_WaitIRQ(reader, ST25R300_IRQ_TXE, timeout_ms);
    if (status != HAL_OK) return status;

    // 8. Aguardar início de recepção (I_rxs) ou timeout (I_nre)
    uint32_t start_tick = HAL_GetTick();
    uint8_t irq_status;
    bool rx_started = false;

    while ((HAL_GetTick() - start_tick) < timeout_ms) {
        status = ST25R300_ReadRegister(reader, ST25R300_REG_IRQ_STATUS1,
                                      &irq_status);
        if (status != HAL_OK) return status;

        if (irq_status & ST25R300_IRQ_RXS) {
            rx_started = true;
            break;
        }

        // Verificar no-response
        status = ST25R300_ReadRegister(reader, ST25R300_REG_IRQ_STATUS2,
                                      &irq_status);
        if (status != HAL_OK) return status;

        if (irq_status & ST25R300_IRQ_NRE) {
            return HAL_TIMEOUT; // Tag não respondeu
        }

        HAL_Delay(1);
    }

    if (!rx_started) {
        return HAL_TIMEOUT;
    }

    // 9. Aguardar fim de recepção (I_rxe)
    status = ST25R300_WaitIRQ(reader, ST25R300_IRQ_RXE, timeout_ms);
    if (status != HAL_OK) return status;

    // 10. Ler número de bytes recebidos
    status = ST25R300_GetFIFOLength(reader, &fifo_bytes);
    if (status != HAL_OK) return status;

    if (fifo_bytes == 0) {
        return HAL_ERROR;
    }

    // 11. Ler dados do FIFO
    if (response != NULL && fifo_bytes > 0) {
        status = ST25R300_ReadFIFO(reader, response, fifo_bytes);
        if (status != HAL_OK) return status;

        if (resp_len != NULL) {
            *resp_len = fifo_bytes;
        }
    }

    // 12. Verificar flag de erro (primeiro byte da resposta)
    if (response[0] & 0x01) {
        return HAL_ERROR; // Tag reportou erro
    }

    dev->last_comm_time = HAL_GetTick();

    return HAL_OK;
}

/**
 * @brief Calcula CRC-16 ISO15693
 */
static uint16_t ISO15693_CalculateCRC(const uint8_t *data, uint16_t length)
{
    uint16_t crc = 0xFFFF;

    for (uint16_t i = 0; i < length; i++) {
        crc ^= data[i];
        for (uint8_t j = 0; j < 8; j++) {
            if (crc & 0x0001) {
                crc = (crc >> 1) ^ 0x8408;
            } else {
                crc >>= 1;
            }
        }
    }

    return ~crc;
}

/* ============================================================================
 * DETECÇÃO E IDENTIFICAÇÃO
 * ============================================================================ */

HAL_StatusTypeDef ST25DV_DetectTag(ST25DV_Handle *dev)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[3];
    uint8_t response[20];
    uint16_t resp_len;

    // Inventory command (single slot)
    // Flags: addressed=0, select=0, protocol_ext=0, inventory=1
    cmd[0] = ISO15693_FLAG_INVENTORY | ISO15693_FLAG_DATARATE;
    cmd[1] = ISO15693_CMD_INVENTORY;
    cmd[2] = 0x00; // AFI = all families

    status = ISO15693_SendCommand(dev, cmd, 3, response, &resp_len, 300);

    if (status == HAL_OK && resp_len >= 10) {
        // Resposta: [Flags][DSFID][UID0-7]
        // UID está em ordem inversa
        for (int i = 0; i < 8; i++) {
            dev->config.uid[i] = response[9 - i];
        }

        dev->tag_detected = true;
        return HAL_OK;
    }

    dev->tag_detected = false;
    return status;
}

HAL_StatusTypeDef ST25DV_GetSystemInfo(ST25DV_Handle *dev)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[10];
    uint8_t response[20];
    uint16_t resp_len;

    if (!dev->tag_detected) {
        return HAL_ERROR;
    }

    // Get System Information command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ISO15693_CMD_GET_SYSTEM_INFO;

    // UID (8 bytes)
    memcpy(&cmd[2], dev->config.uid, 8);

    status = ISO15693_SendCommand(dev, cmd, 10, response, &resp_len, 300);

    if (status == HAL_OK && resp_len >= 10) {
        // Resposta: [Flags][InfoFlags][...]
        uint8_t info_flags = response[1];
        uint8_t *ptr = &response[2];

        // DSFID presente?
        if (info_flags & 0x01) {
            ptr++; // Skip DSFID
        }

        // AFI presente?
        if (info_flags & 0x02) {
            ptr++; // Skip AFI
        }

        // Tamanho da memória presente?
        if (info_flags & 0x04) {
            uint8_t blocks_lsb = *ptr++;
            uint8_t blocks_msb = *ptr++;
            uint16_t num_blocks = ((uint16_t)blocks_msb << 8) | blocks_lsb;

            uint8_t block_size = (*ptr++) & 0x1F; // bits 4:0

            dev->config.block_size = (block_size + 1) * 4; // Em bytes
            dev->config.memory_size = num_blocks * dev->config.block_size;
        }
    }

    return status;
}

/* ============================================================================
 * LEITURA/ESCRITA DE MEMÓRIA
 * ============================================================================ */

HAL_StatusTypeDef ST25DV_ReadSingleBlock(ST25DV_Handle *dev,
                                         uint16_t block_addr,
                                         uint8_t *data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[11];
    uint8_t response[10];
    uint16_t resp_len;

    if (!dev->tag_detected) {
        return HAL_ERROR;
    }

    // Read Single Block command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ISO15693_CMD_READ_SINGLE_BLOCK;
    memcpy(&cmd[2], dev->config.uid, 8);
    cmd[10] = (uint8_t)block_addr; // Endereço do bloco

    status = ISO15693_SendCommand(dev, cmd, 11, response, &resp_len, 300);

    if (status == HAL_OK && resp_len >= 5) {
        // Resposta: [Flags][Data0-3]
        memcpy(data, &response[1], 4);
    }

    return status;
}

HAL_StatusTypeDef ST25DV_WriteSingleBlock(ST25DV_Handle *dev,
                                          uint16_t block_addr,
                                          const uint8_t *data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[15];
    uint8_t response[5];
    uint16_t resp_len;

    if (!dev->tag_detected) {
        return HAL_ERROR;
    }

    // Write Single Block command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ISO15693_CMD_WRITE_SINGLE_BLOCK;
    memcpy(&cmd[2], dev->config.uid, 8);
    cmd[10] = (uint8_t)block_addr;
    memcpy(&cmd[11], data, 4);

    status = ISO15693_SendCommand(dev, cmd, 15, response, &resp_len, 500);

    return status;
}

HAL_StatusTypeDef ST25DV_ReadMultipleBlocks(ST25DV_Handle *dev,
                                            uint16_t start_block,
                                            uint8_t num_blocks,
                                            uint8_t *data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[12];
    uint8_t response[260];
    uint16_t resp_len;

    if (!dev->tag_detected || num_blocks == 0) {
        return HAL_ERROR;
    }

    // Read Multiple Blocks command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ISO15693_CMD_READ_MULTIPLE_BLOCKS;
    memcpy(&cmd[2], dev->config.uid, 8);
    cmd[10] = (uint8_t)start_block;
    cmd[11] = num_blocks - 1; // Number of blocks - 1

    status = ISO15693_SendCommand(dev, cmd, 12, response, &resp_len, 1000);

    if (status == HAL_OK && resp_len > 1) {
        // Resposta: [Flags][Data...]
        uint16_t data_len = resp_len - 1;
        memcpy(data, &response[1], data_len);
    }

    return status;
}

/* ============================================================================
 * MAILBOX
 * ============================================================================ */

HAL_StatusTypeDef ST25DV_EnableMailBox(ST25DV_Handle *dev)
{
    HAL_StatusTypeDef status;

    // Escrever registrador dinâmico MB_CTRL
    status = ST25DV_WriteDynamicReg(dev, ST25DV_DYN_MB_CTRL_ADDR,
                                    ST25DV_MB_MODE);

    if (status == HAL_OK) {
        dev->config.mailbox_enabled = true;
    }

    return status;
}

HAL_StatusTypeDef ST25DV_GetMailBoxStatus(ST25DV_Handle *dev,
                                          ST25DV_MailBox_Status *status_out)
{
    HAL_StatusTypeDef status;
    uint8_t mb_ctrl, mb_len;

    // Ler controle da MailBox
    status = ST25DV_ReadDynamicReg(dev, ST25DV_DYN_MB_CTRL_ADDR, &mb_ctrl);
    if (status != HAL_OK) return status;

    // Ler tamanho da mensagem
    status = ST25DV_ReadDynamicReg(dev, ST25DV_DYN_MB_LEN_ADDR, &mb_len);
    if (status != HAL_OK) return status;

    // Decodificar status
    status_out->host_put_msg = (mb_ctrl & ST25DV_MB_HOST_PUT_MSG) != 0;
    status_out->rf_put_msg = (mb_ctrl & ST25DV_MB_RF_PUT_MSG) != 0;
    status_out->host_miss_msg = (mb_ctrl & ST25DV_MB_HOST_MISS_MSG) != 0;
    status_out->rf_miss_msg = (mb_ctrl & ST25DV_MB_RF_MISS_MSG) != 0;
    status_out->host_current_msg = (mb_ctrl & ST25DV_MB_HOST_CURRENT_MSG) != 0;
    status_out->rf_current_msg = (mb_ctrl & ST25DV_MB_RF_CURRENT_MSG) != 0;
    status_out->message_length = mb_len;

    return HAL_OK;
}

HAL_StatusTypeDef ST25DV_ReadMailBox(ST25DV_Handle *dev,
                                     uint8_t *data,
                                     uint8_t *length)
{
    HAL_StatusTypeDef status;
    ST25DV_MailBox_Status mb_status;

    // Verificar se há mensagem disponível
    status = ST25DV_GetMailBoxStatus(dev, &mb_status);
    if (status != HAL_OK) return status;

    if (!mb_status.rf_current_msg) {
        *length = 0;
        return HAL_OK; // Nenhuma mensagem
    }

    // Ler blocos da MailBox (256 bytes = 64 blocos de 4 bytes)
    uint8_t num_blocks = (mb_status.message_length + 3) / 4;

    if (num_blocks > 64) {
        num_blocks = 64; // Limitar a 256 bytes
    }

    status = ST25DV_ReadMultipleBlocks(dev, ST25DV_MAILBOX_BLOCK_START,
                                       num_blocks, data);

    if (status == HAL_OK) {
        *length = mb_status.message_length;
    }

    return status;
}

HAL_StatusTypeDef ST25DV_WriteMailBox(ST25DV_Handle *dev,
                                      const uint8_t *data,
                                      uint8_t length)
{
    HAL_StatusTypeDef status;

    if (length > ST25DV_MAILBOX_SIZE) {
        return HAL_ERROR;
    }

    // Calcular número de blocos necessários
    uint8_t num_blocks = (length + 3) / 4;
    uint8_t buffer[256] = {0};

    // Copiar dados para buffer (padding com zeros)
    memcpy(buffer, data, length);

    // Escrever blocos na MailBox
    for (uint8_t i = 0; i < num_blocks; i++) {
        status = ST25DV_WriteSingleBlock(dev,
                                        ST25DV_MAILBOX_BLOCK_START + i,
                                        &buffer[i * 4]);
        if (status != HAL_OK) return status;
    }

    // Atualizar comprimento da mensagem
    status = ST25DV_WriteDynamicReg(dev, ST25DV_DYN_MB_LEN_ADDR, length);
    if (status != HAL_OK) return status;

    // Sinalizar mensagem disponível (RF put message)
    uint8_t mb_ctrl;
    status = ST25DV_ReadDynamicReg(dev, ST25DV_DYN_MB_CTRL_ADDR, &mb_ctrl);
    if (status != HAL_OK) return status;

    mb_ctrl |= ST25DV_MB_RF_PUT_MSG;
    status = ST25DV_WriteDynamicReg(dev, ST25DV_DYN_MB_CTRL_ADDR, mb_ctrl);

    return status;
}

HAL_StatusTypeDef ST25DV_ClearMailBoxFlag(ST25DV_Handle *dev)
{
    HAL_StatusTypeDef status;
    uint8_t mb_ctrl;

    // Ler controle atual
    status = ST25DV_ReadDynamicReg(dev, ST25DV_DYN_MB_CTRL_ADDR, &mb_ctrl);
    if (status != HAL_OK) return status;

    // Limpar flag RF_PUT_MSG
    mb_ctrl &= ~ST25DV_MB_RF_PUT_MSG;
    status = ST25DV_WriteDynamicReg(dev, ST25DV_DYN_MB_CTRL_ADDR, mb_ctrl);

    return status;
}

/* ============================================================================
 * ENERGY HARVESTING
 * ============================================================================ */

HAL_StatusTypeDef ST25DV_EnableEnergyHarvesting(ST25DV_Handle *dev,
                                                bool on_demand)
{
    HAL_StatusTypeDef status;
    uint8_t eh_ctrl = ST25DV_EH_MODE_ENABLE;

    if (on_demand) {
        eh_ctrl |= ST25DV_EH_ON_DEMAND;
    }

    status = ST25DV_WriteDynamicReg(dev, ST25DV_DYN_EH_CTRL_ADDR, eh_ctrl);

    if (status == HAL_OK) {
        dev->config.eh_enabled = true;
    }

    return status;
}

HAL_StatusTypeDef ST25DV_DisableEnergyHarvesting(ST25DV_Handle *dev)
{
    HAL_StatusTypeDef status;

    status = ST25DV_WriteDynamicReg(dev, ST25DV_DYN_EH_CTRL_ADDR, 0x00);

    if (status == HAL_OK) {
        dev->config.eh_enabled = false;
    }

    return status;
}

HAL_StatusTypeDef ST25DV_GetEHStatus(ST25DV_Handle *dev,
                                     bool *enabled,
                                     bool *on_demand)
{
    HAL_StatusTypeDef status;
    uint8_t eh_ctrl;

    status = ST25DV_ReadDynamicReg(dev, ST25DV_DYN_EH_CTRL_ADDR, &eh_ctrl);

    if (status == HAL_OK) {
        *enabled = (eh_ctrl & ST25DV_EH_MODE_ENABLE) != 0;
        *on_demand = (eh_ctrl & ST25DV_EH_ON_DEMAND) != 0;
    }

    return status;
}

/* ============================================================================
 * CONFIGURAÇÃO DINÂMICA
 * ============================================================================ */

HAL_StatusTypeDef ST25DV_ReadDynamicReg(ST25DV_Handle *dev,
                                        uint16_t reg_addr,
                                        uint8_t *data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[11];
    uint8_t response[5];
    uint16_t resp_len;

    if (!dev->tag_detected) {
        return HAL_ERROR;
    }

    // Read Dynamic Configuration command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ST25DV_CMD_READ_DYN_CONFIG;
    memcpy(&cmd[2], dev->config.uid, 8);
    cmd[10] = (uint8_t)reg_addr; // LSB do endereço

    status = ISO15693_SendCommand(dev, cmd, 11, response, &resp_len, 300);

    if (status == HAL_OK && resp_len >= 2) {
        *data = response[1];
    }

    return status;
}

HAL_StatusTypeDef ST25DV_WriteDynamicReg(ST25DV_Handle *dev,
                                         uint16_t reg_addr,
                                         uint8_t data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[12];
    uint8_t response[5];
    uint16_t resp_len;

    if (!dev->tag_detected) {
        return HAL_ERROR;
    }

    // Write Dynamic Configuration command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ST25DV_CMD_WRITE_DYN_CONFIG;
    memcpy(&cmd[2], dev->config.uid, 8);
    cmd[10] = (uint8_t)reg_addr;
    cmd[11] = data;

    status = ISO15693_SendCommand(dev, cmd, 12, response, &resp_len, 500);

    return status;
}

HAL_StatusTypeDef ST25DV_ConfigureGPO(ST25DV_Handle *dev, uint8_t gpo_config)
{
    return ST25DV_WriteDynamicReg(dev, ST25DV_DYN_GPO_CTRL_ADDR, gpo_config);
}

/* ============================================================================
 * FAST TRANSFER MODE
 * ============================================================================ */

HAL_StatusTypeDef ST25DV_FastReadSingleBlock(ST25DV_Handle *dev,
                                             uint16_t block_addr,
                                             uint8_t *data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[11];
    uint8_t response[10];
    uint16_t resp_len;

    if (!dev->tag_detected) {
        return HAL_ERROR;
    }

    // Fast Read Single Block command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ST25DV_CMD_FAST_READ_SINGLE_BLOCK;
    memcpy(&cmd[2], dev->config.uid, 8);
    cmd[10] = (uint8_t)block_addr;

    // FTM é mais rápido - timeout reduzido
    status = ISO15693_SendCommand(dev, cmd, 11, response, &resp_len, 100);

    if (status == HAL_OK && resp_len >= 5) {
        memcpy(data, &response[1], 4);
    }

    return status;
}

HAL_StatusTypeDef ST25DV_FastWriteSingleBlock(ST25DV_Handle *dev,
                                              uint16_t block_addr,
                                              const uint8_t *data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[15];
    uint8_t response[5];
    uint16_t resp_len;

    if (!dev->tag_detected) {
        return HAL_ERROR;
    }

    // Fast Write Single Block command
    cmd[0] = ISO15693_FLAG_ADDRESS | ISO15693_FLAG_DATARATE;
    cmd[1] = ST25DV_CMD_FAST_WRITE_SINGLE_BLOCK;
    memcpy(&cmd[2], dev->config.uid, 8);
    cmd[10] = (uint8_t)block_addr;
    memcpy(&cmd[11], data, 4);

    status = ISO15693_SendCommand(dev, cmd, 15, response, &resp_len, 200);

    return status;
}
