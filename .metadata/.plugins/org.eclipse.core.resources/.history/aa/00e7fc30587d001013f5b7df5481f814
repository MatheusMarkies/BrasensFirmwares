// Instâncias globais das estruturas
#include "ecu_config.h"

extern EcuConfig_t  g_ecuConfig;
extern EngineData_t g_engineData;

// ADC de 12 bits (0-4095) e VREF de 3.3V
#define ADC_MAX_VALUE 4095.0f
#define ADC_VREF      3.3f

// Arrays globais para armazenamento genérico
uint16_t g_raw_adc_values[12];
float    g_sensor_voltages[12];
float    g_battery_adc_voltage;

// Buffer para onde o DMA irá escrever os resultados das conversões do ADC
volatile uint16_t g_adc_dma_buffer[12];
volatile uint16_t g_adc_dma_buffer_battery[1];

// Flag para sinalizar que uma nova conversão DMA está completa.
// 'volatile' é crucial para garantir que o compilador não otimize o acesso a esta variável.
volatile int g_adc_conversion_complete = 0;

// Arrays para armazenamento genérico, como no seu rascunho
volatile float g_sensor_voltages[12];
volatile float g_battery_adc_voltage;

void EngineSensors_Init(ADC_HandleTypeDef* hadc_sensors, ADC_HandleTypeDef* hadc_battery) {
    g_hadc_sensors = hadc_sensors;
    g_hadc_battery = hadc_battery;

    if (HAL_ADC_Start_DMA(g_hadc_sensors, (uint32_t*)g_adc_dma_buffer, NUM_SENSOR_CHANNELS) != HAL_OK) {
        Error_Handler();
    }

    if (HAL_ADC_Start_DMA(g_hadc_battery, (uint32_t*)g_adc_dma_buffer_battery, 1) != HAL_OK) {
        Error_Handler();
    }
}

void EngineSensors_Process(void) {
    if (!g_adc_conversion_complete) {
        return;
    }

    for (int i = 0; i < NUM_SENSOR_CHANNELS; i++) {
        g_sensor_voltages[i] = (g_adc_dma_buffer[i] / ADC_MAX_VALUE) * ADC_VREF;
    }
    g_battery_adc_voltage = (g_adc_dma_buffer_battery[0] / ADC_MAX_VALUE) * ADC_VREF;

    g_engineData.battery_voltage = g_battery_adc_voltage * BATT_DIVIDER_RATIO;

    for (int i = 0; i < NUM_SENSOR_CHANNELS; i++) {
        float sensor_voltage_5v_scale = g_sensor_voltages[i] * SENSOR_DIVIDER_RATIO;
        SensorType_e current_sensor_type = g_ecuConfig.sensor_channel_map[i];

        switch (current_sensor_type) {
            case SENSOR_TYPE_TPS:
                g_engineData.tps_percent = (sensor_voltage_5v_scale / 5.0f) * 100.0f;
                break;

            case SENSOR_TYPE_CLT:
                // g_engineData.clt_celsius = InterpolateTemp(sensor_voltage_5v_scale, CLT_TABLE);
                break;

            case SENSOR_TYPE_IAT:
                // g_engineData.iat_celsius = InterpolateTemp(sensor_voltage_5v_scale, IAT_TABLE);
                break;

            case SENSOR_TYPE_CKP:
                // g_engineData.iat_celsius = InterpolateTemp(sensor_voltage_5v_scale, IAT_TABLE);
                break;

            case SENSOR_TYPE_CMP:
                // g_engineData.iat_celsius = InterpolateTemp(sensor_voltage_5v_scale, IAT_TABLE);
                break;

            case SENSOR_TYPE_NONE:
            default:

                break;
        }
    }

    g_adc_conversion_complete = false;
}

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc) {
    if (hadc->Instance == g_hadc_sensors->Instance) {
        g_adc_conversion_complete = true;
    }
}
