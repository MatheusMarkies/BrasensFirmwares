/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void) {

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* MCU Configuration--------------------------------------------------------*/

	/* Reset of all peripherals, Initializes the Flash interface and the Systick. */
	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* Configure the system clock */
	SystemClock_Config();

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_USART2_UART_Init();
	/* USER CODE BEGIN 2 */

	logUsartInit(&huart2);

	HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, GPIO_PIN_SET); // RESET High (Reset Mode) [cite: 1752]
	HAL_Delay(10);
	HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, GPIO_PIN_RESET); // RESET Low (Power-down Mode) [cite: 1756, 1806]
	HAL_Delay(10);

	/* 2. Inicialização da RFAL */
	ReturnCode err;

	/* Inicialização da RFAL */
	err = rfalInitialize();

	if (err == ERR_NONE) {
		platformLog("ST25R300 Inicializado com sucesso!\r\n");
	} else {
		platformLog("Erro na inicialização: %d\r\n", err);
	}

	if (rfalInitialize() != ERR_NONE) {
		// Erro crítico de hardware
		while (1)
			;
	}

	// 2. Inicialização do Módulo NFC (Alta Camada)
	if (rfalNfcInitialize() != ERR_NONE) {
		// Erro na máquina de estados
		while (1)
			;
	}

	// 3. Configuração dos Parâmetros de Descoberta [cite: 832, 1245]
	rfalNfcDefaultDiscParams(&discParam); // Preenche com valores padrão seguros

	discParam.devLimit = 1U;
	discParam.totalDuration = 1000U; // Ciclo de 1 segundo
	discParam.techs2Find = RFAL_NFC_TECH_NONE; // Limpa as tecnologias

	// Habilita as tecnologias desejadas via máscara de bits [cite: 1388]
#if RFAL_FEATURE_NFCA
	discParam.techs2Find |= RFAL_NFC_POLL_TECH_A;
#endif

#if RFAL_FEATURE_NFCV
	discParam.techs2Find |= RFAL_NFC_POLL_TECH_V;
#endif

	// Configuração de Wake-up (Baixo consumo)
	discParam.wakeupEnabled = false; // Começaremos com polling ativo padrão

	// 4. Inicia a Descoberta
	if (rfalNfcDiscover(&discParam) != ERR_NONE) {
		// Falha ao iniciar rádio
		while (1)
			;
	}
	/* USER CODE END 2 */

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {
		rfalNfcWorker(); // Processa eventos do ST25R300 (PA0) [cite: 524]

		// Verifica se algum dispositivo foi encontrado e ativado [cite: 1246]
		if (rfalNfcIsDevActivated(rfalNfcGetState())) {
			rfalNfcDevice *nfcDev;

			rfalNfcGetActiveDevice(&nfcDev);

			platformLog("Identificada! \r\n");

			// Se for NFC-V (comum em tags industrial/torquímetro com energy harvesting)
			if (nfcDev->type == RFAL_NFC_LISTEN_TYPE_NFCV) {
				// Chame sua lógica de leitura aqui
			}

			// Reinicia a descoberta após processar a tag
			rfalNfcDeactivate(RFAL_NFC_DEACTIVATE_DISCOVERY);
			rfalNfcDiscover(&discParam);
		}
		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */
	}
	/* USER CODE END 3 */
}

