    status = ST25R300_ConfigureNFCV(&st25r300, &nfcv_config);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha na configuração: %d\r\n", status);
        return status;
    }

    printf("   [OK] NFC-V configurado: %d kbps\r\n",
           (nfcv_config.tx_rate == 0) ? 26 : (nfcv_config.tx_rate == 1) ? 53 : 106);

    // ========================================================================
    // PASSO 3: Ligar campo RF
    // ========================================================================

    printf("\r\n3. Ligando campo RF...\r\n");

    status = ST25R300_FieldOn(&st25r300);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha ao ligar campo: %d\r\n", status);
        return status;
    }

    printf("   [OK] Campo RF ativo (13.56 MHz)\r\n");
    field_active = true;

    // ========================================================================
    // PASSO 4: Inicializar handle do ST25DV
    // ========================================================================

    st25dv.reader = &st25r300;
    st25dv.tag_detected = false;

    printf("\r\n[OK] Sistema NFC inicializado com sucesso!\r\n");
    printf("========================================\r\n\r\n");

    return HAL_OK;
}

/**
 * @brief Detecta e configura tag ST25DV
 */
HAL_StatusTypeDef NFC_DetectAndConfigureTag(void)
{
    HAL_StatusTypeDef status;

    printf("\r\n--- Detectando Tag ST25DV ---\r\n\r\n");

    // ========================================================================
    // PASSO 1: Inventory (detectar tag)
    // ========================================================================

    printf("1. Executando Inventory...\r\n");

    status = ST25DV_DetectTag(&st25dv);
    if (status != HAL_OK) {
        printf("   [ERRO] Nenhum tag detectado\r\n");
        return status;
    }

    printf("   [OK] Tag detectado!\r\n");
    printf("   UID: ");
    for (int i = 0; i < 8; i++) {
        printf("%02X ", st25dv.config.uid[i]);
    }
    printf("\r\n");

    tag_detected = true;

    // ========================================================================
    // PASSO 2: Get System Info
    // ========================================================================

    printf("\r\n2. Lendo informações do sistema...\r\n");

    status = ST25DV_GetSystemInfo(&st25dv);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha ao ler system info: %d\r\n", status);
        return status;
    }

    printf("   [OK] Memória: %d bytes\r\n", st25dv.config.memory_size);
    printf("   [OK] Tamanho do bloco: %d bytes\r\n", st25dv.config.block_size);

    // ========================================================================
    // PASSO 3: Habilitar MailBox
    // ========================================================================

    printf("\r\n3. Habilitando MailBox...\r\n");

    status = ST25DV_EnableMailBox(&st25dv);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha ao habilitar MailBox: %d\r\n", status);
        return status;
    }

    printf("   [OK] MailBox habilitada (256 bytes)\r\n");
    mailbox_ready = true;

    // ========================================================================
    // PASSO 4: Habilitar Energy Harvesting
    // ========================================================================

    printf("\r\n4. Habilitando Energy Harvesting...\r\n");

    // On-demand mode: EH ativo apenas quando necessário
    status = ST25DV_EnableEnergyHarvesting(&st25dv, true);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha ao habilitar EH: %d\r\n", status);
        return status;
    }

    printf("   [OK] Energy Harvesting habilitado (on-demand mode)\r\n");

    // ========================================================================
    // PASSO 5: Configurar GPO (General Purpose Output)
    // ========================================================================

    printf("\r\n5. Configurando GPO...\r\n");

    // Habilitar interrupções para:
    // - RF Field Change (campo RF liga/desliga)
    // - RF Put Message (mensagem recebida via RF)
    // - RF Get Message (mensagem lida via RF)
    uint8_t gpo_config = ST25DV_GPO_ENABLE |
                         ST25DV_GPO_FIELD_CHANGE_EN |
                         ST25DV_GPO_RF_PUT_MSG_EN |
                         ST25DV_GPO_RF_GET_MSG_EN;

    status = ST25DV_ConfigureGPO(&st25dv, gpo_config);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha ao configurar GPO: %d\r\n", status);
        return status;
    }

    printf("   [OK] GPO configurado para eventos de MailBox\r\n");

    printf("\r\n[OK] Tag ST25DV configurado com sucesso!\r\n");
    printf("========================================\r\n\r\n");

    return HAL_OK;
}

/* ============================================================================
 * OPERAÇÕES DE MAILBOX
 * ============================================================================ */

/**
 * @brief Verifica e lê mensagens da MailBox
 */
void NFC_CheckMailBox(void)
{
    HAL_StatusTypeDef status;
    ST25DV_MailBox_Status mb_status;

    // Ler status da MailBox
    status = ST25DV_GetMailBoxStatus(&st25dv, &mb_status);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha ao ler status da MailBox\r\n");
        return;
    }

    // Verificar se há mensagem disponível
    if (mb_status.rf_current_msg) {
        printf("\r\n[INFO] Mensagem disponível na MailBox!\r\n");
        printf("   Tamanho: %d bytes\r\n", mb_status.message_length);

        // Ler mensagem
        status = ST25DV_ReadMailBox(&st25dv, mailbox_buffer, &message_length);
        if (status == HAL_OK) {
            printf("   [OK] Mensagem lida:\r\n   ");

            // Imprimir em hexadecimal
            for (int i = 0; i < message_length; i++) {
                printf("%02X ", mailbox_buffer[i]);
                if ((i + 1) % 16 == 0) printf("\r\n   ");
            }
            printf("\r\n");

            // Imprimir como string (se for texto)
            printf("   Texto: \"");
            for (int i = 0; i < message_length; i++) {
                if (mailbox_buffer[i] >= 0x20 && mailbox_buffer[i] <= 0x7E) {
                    printf("%c", mailbox_buffer[i]);
                } else {
                    printf(".");
                }
            }
            printf("\"\r\n");

            // Limpar flag
            ST25DV_ClearMailBoxFlag(&st25dv);
        } else {
            printf("   [ERRO] Falha ao ler mensagem: %d\r\n", status);
        }
    }

    // Reportar outros status
    if (mb_status.host_put_msg) {
        printf("   [INFO] Host colocou mensagem na MailBox\r\n");
    }

    if (mb_status.host_miss_msg) {
        printf("   [AVISO] Host perdeu mensagem!\r\n");
    }

    if (mb_status.rf_miss_msg) {
        printf("   [AVISO] RF perdeu mensagem!\r\n");
    }
}

/**
 * @brief Escreve mensagem na MailBox
 */
void NFC_WriteMailBox(const char *message)
{
    HAL_StatusTypeDef status;
    uint8_t len = strlen(message);

    if (len > ST25DV_MAILBOX_SIZE) {
        printf("   [ERRO] Mensagem muito grande (max 256 bytes)\r\n");
        return;
    }

    printf("\r\n[INFO] Escrevendo mensagem na MailBox...\r\n");
    printf("   Texto: \"%s\"\r\n", message);
    printf("   Tamanho: %d bytes\r\n", len);

    status = ST25DV_WriteMailBox(&st25dv, (const uint8_t*)message, len);

    if (status == HAL_OK) {
        printf("   [OK] Mensagem escrita com sucesso!\r\n");
    } else {
        printf("   [ERRO] Falha ao escrever mensagem: %d\r\n", status);
    }
}

/* ============================================================================
 * OPERAÇÕES DE MEMÓRIA
 * ============================================================================ */

/**
 * @brief Demonstra leitura/escrita de blocos
 */
void NFC_TestMemoryOperations(void)
{
    HAL_StatusTypeDef status;
    uint8_t write_data[4] = {0x01, 0x02, 0x03, 0x04};
    uint8_t read_data[4];

    printf("\r\n--- Teste de Operações de Memória ---\r\n\r\n");

    // ========================================================================
    // Escrever bloco
    // ========================================================================

    printf("1. Escrevendo bloco 0...\r\n");
    printf("   Dados: %02X %02X %02X %02X\r\n",
           write_data[0], write_data[1], write_data[2], write_data[3]);

    status = ST25DV_WriteSingleBlock(&st25dv, 0, write_data);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha na escrita: %d\r\n", status);
        return;
    }

    printf("   [OK] Bloco escrito\r\n");

    // ========================================================================
    // Ler bloco
    // ========================================================================

    printf("\r\n2. Lendo bloco 0...\r\n");

    status = ST25DV_ReadSingleBlock(&st25dv, 0, read_data);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha na leitura: %d\r\n", status);
        return;
    }

    printf("   Dados: %02X %02X %02X %02X\r\n",
           read_data[0], read_data[1], read_data[2], read_data[3]);

    // Verificar dados
    if (memcmp(write_data, read_data, 4) == 0) {
        printf("   [OK] Dados verificados!\r\n");
    } else {
        printf("   [ERRO] Dados não correspondem!\r\n");
    }

    // ========================================================================
    // Teste Fast Transfer Mode
    // ========================================================================

    printf("\r\n3. Testando Fast Transfer Mode...\r\n");

    uint8_t fast_write[4] = {0xAA, 0xBB, 0xCC, 0xDD};
    uint8_t fast_read[4];

    status = ST25DV_FastWriteSingleBlock(&st25dv, 1, fast_write);
    if (status == HAL_OK) {
        status = ST25DV_FastReadSingleBlock(&st25dv, 1, fast_read);

        if (status == HAL_OK && memcmp(fast_write, fast_read, 4) == 0) {
            printf("   [OK] Fast Transfer Mode funcionando!\r\n");
        }
    }

    printf("\r\n========================================\r\n");
}

/* ============================================================================
 * MONITORAMENTO DE ENERGY HARVESTING
 * ============================================================================ */

/**
 * @brief Monitora status do Energy Harvesting
 */
void NFC_MonitorEnergyHarvesting(void)
{
    static uint32_t last_check = 0;
    uint32_t now = HAL_GetTick();

    // Verificar a cada 5 segundos
    if ((now - last_check) < 5000) {
        return;
    }

    last_check = now;

    bool eh_enabled, on_demand;
    HAL_StatusTypeDef status;

    status = ST25DV_GetEHStatus(&st25dv, &eh_enabled, &on_demand);

    if (status == HAL_OK) {
        printf("\r\n[EH] Status do Energy Harvesting:\r\n");
        printf("   Habilitado: %s\r\n", eh_enabled ? "SIM" : "NÃO");
        printf("   Modo: %s\r\n", on_demand ? "On-Demand" : "Sempre Ativo");

        if (eh_enabled) {
            printf("   [OK] ST25DV está coletando energia do campo RF\r\n");
        }
    }
}

