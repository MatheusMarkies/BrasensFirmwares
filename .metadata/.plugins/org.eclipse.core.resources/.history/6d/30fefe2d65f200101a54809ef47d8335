/**
 * @brief Verifica e lê mensagens da MailBox
 */
void NFC_CheckMailBox(void)
{
    HAL_StatusTypeDef status;
    ST25DV_MailBox_Status mb_status;

    // Ler status da MailBox
    status = ST25DV_GetMailBoxStatus(&st25dv, &mb_status);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha ao ler status da MailBox\r\n");
        return;
    }

    // Verificar se há mensagem disponível
    if (mb_status.rf_current_msg) {
        printf("\r\n[INFO] Mensagem disponível na MailBox!\r\n");
        printf("   Tamanho: %d bytes\r\n", mb_status.message_length);

        // Ler mensagem
        status = ST25DV_ReadMailBox(&st25dv, mailbox_buffer, &message_length);
        if (status == HAL_OK) {
            printf("   [OK] Mensagem lida:\r\n   ");

            // Imprimir em hexadecimal
            for (int i = 0; i < message_length; i++) {
                printf("%02X ", mailbox_buffer[i]);
                if ((i + 1) % 16 == 0) printf("\r\n   ");
            }
            printf("\r\n");

            // Imprimir como string (se for texto)
            printf("   Texto: \"");
            for (int i = 0; i < message_length; i++) {
                if (mailbox_buffer[i] >= 0x20 && mailbox_buffer[i] <= 0x7E) {
                    printf("%c", mailbox_buffer[i]);
                } else {
                    printf(".");
                }
            }
            printf("\"\r\n");

            // Limpar flag
            ST25DV_ClearMailBoxFlag(&st25dv);
        } else {
            printf("   [ERRO] Falha ao ler mensagem: %d\r\n", status);
        }
    }

    // Reportar outros status
    if (mb_status.host_put_msg) {
        printf("   [INFO] Host colocou mensagem na MailBox\r\n");
    }

    if (mb_status.host_miss_msg) {
        printf("   [AVISO] Host perdeu mensagem!\r\n");
    }

    if (mb_status.rf_miss_msg) {
        printf("   [AVISO] RF perdeu mensagem!\r\n");
    }
}

/**
 * @brief Escreve mensagem na MailBox
 */
void NFC_WriteMailBox(const char *message)
{
    HAL_StatusTypeDef status;
    uint8_t len = strlen(message);

    if (len > ST25DV_MAILBOX_SIZE) {
        printf("   [ERRO] Mensagem muito grande (max 256 bytes)\r\n");
        return;
    }

    printf("\r\n[INFO] Escrevendo mensagem na MailBox...\r\n");
    printf("   Texto: \"%s\"\r\n", message);
    printf("   Tamanho: %d bytes\r\n", len);

    status = ST25DV_WriteMailBox(&st25dv, (const uint8_t*)message, len);

    if (status == HAL_OK) {
        printf("   [OK] Mensagem escrita com sucesso!\r\n");
    } else {
        printf("   [ERRO] Falha ao escrever mensagem: %d\r\n", status);
    }
}

