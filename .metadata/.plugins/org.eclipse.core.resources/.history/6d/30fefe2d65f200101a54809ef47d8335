/**
 * @brief Demonstra leitura/escrita de blocos
 */
void NFC_TestMemoryOperations(void)
{
    HAL_StatusTypeDef status;
    uint8_t write_data[4] = {0x01, 0x02, 0x03, 0x04};
    uint8_t read_data[4];

    printf("\r\n--- Teste de Operações de Memória ---\r\n\r\n");

    // ========================================================================
    // Escrever bloco
    // ========================================================================

    printf("1. Escrevendo bloco 0...\r\n");
    printf("   Dados: %02X %02X %02X %02X\r\n",
           write_data[0], write_data[1], write_data[2], write_data[3]);

    status = ST25DV_WriteSingleBlock(&st25dv, 0, write_data);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha na escrita: %d\r\n", status);
        return;
    }

    printf("   [OK] Bloco escrito\r\n");

    // ========================================================================
    // Ler bloco
    // ========================================================================

    printf("\r\n2. Lendo bloco 0...\r\n");

    status = ST25DV_ReadSingleBlock(&st25dv, 0, read_data);
    if (status != HAL_OK) {
        printf("   [ERRO] Falha na leitura: %d\r\n", status);
        return;
    }

    printf("   Dados: %02X %02X %02X %02X\r\n",
           read_data[0], read_data[1], read_data[2], read_data[3]);

    // Verificar dados
    if (memcmp(write_data, read_data, 4) == 0) {
        printf("   [OK] Dados verificados!\r\n");
    } else {
        printf("   [ERRO] Dados não correspondem!\r\n");
    }

    // ========================================================================
    // Teste Fast Transfer Mode
    // ========================================================================

    printf("\r\n3. Testando Fast Transfer Mode...\r\n");

    uint8_t fast_write[4] = {0xAA, 0xBB, 0xCC, 0xDD};
    uint8_t fast_read[4];

    status = ST25DV_FastWriteSingleBlock(&st25dv, 1, fast_write);
    if (status == HAL_OK) {
        status = ST25DV_FastReadSingleBlock(&st25dv, 1, fast_read);

        if (status == HAL_OK && memcmp(fast_write, fast_read, 4) == 0) {
            printf("   [OK] Fast Transfer Mode funcionando!\r\n");
        }
    }

    printf("\r\n========================================\r\n");
}

/* ============================================================================
 * MONITORAMENTO DE ENERGY HARVESTING
 * ============================================================================ */

/**
 * @brief Monitora status do Energy Harvesting
 */
void NFC_MonitorEnergyHarvesting(void)
{
    static uint32_t last_check = 0;
    uint32_t now = HAL_GetTick();

    // Verificar a cada 5 segundos
    if ((now - last_check) < 5000) {
        return;
    }

    last_check = now;

    bool eh_enabled, on_demand;
    HAL_StatusTypeDef status;

    status = ST25DV_GetEHStatus(&st25dv, &eh_enabled, &on_demand);

    if (status == HAL_OK) {
        printf("\r\n[EH] Status do Energy Harvesting:\r\n");
        printf("   Habilitado: %s\r\n", eh_enabled ? "SIM" : "NÃO");
        printf("   Modo: %s\r\n", on_demand ? "On-Demand" : "Sempre Ativo");

        if (eh_enabled) {
            printf("   [OK] ST25DV está coletando energia do campo RF\r\n");
        }
    }
}

