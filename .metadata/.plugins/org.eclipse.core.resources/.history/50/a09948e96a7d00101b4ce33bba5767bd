}

// Esta é a função que a Interrupção do CKP (ISR) irá chamar
void EngineControl_CrankEventCallback(void) {
    // Esta função executa dentro de uma interrupção, tem que ser RÁPIDA!

    // 1. Calcular RPM e atualizar o ângulo do motor
    // TODO: Implementar a lógica real do timer de captura
    // g_engineState.rpm = ...;
    // g_engineState.engine_angle_deg = ...;

    // 2. Acordar a tarefa principal para fazer os cálculos pesados
    osSemaphoreRelease(engineSyncSemaphoreHandle);
}

// A tarefa do RTOS que orquestra o controlo
void Task_EngineControl(void const * argument) {
    EngineControl_Init();

    for(;;) {
        // A tarefa fica bloqueada aqui, à espera que a ISR do CKP a liberte
        if (osSemaphoreWait(engineSyncSemaphoreHandle, osWaitForever) == osOK) {
            // Fomos acordados por um evento do virabrequim!
            // Agora, com segurança fora da interrupção, executamos os cálculos
            EngineControl_RunCalculations();
        }
    }
}
