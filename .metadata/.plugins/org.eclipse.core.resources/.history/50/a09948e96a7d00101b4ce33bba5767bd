/*
*Implementação Algorítmica do Speed-Density
*O algoritmo Speed-Density é executado pela ECU a cada ciclo do motor para determinar a massa de combustível a ser injetada. O processo pode ser resumido nos seguintes passos:
*Amostragem dos Sensores: A ECU lê os valores instantâneos dos sensores MAP, IAT e RPM.
*Consulta à Tabela VE: Usando os valores atuais de MAP e RPM como coordenadas, a ECU consulta a tabela VE 2D. Se o ponto de operação exato (por exemplo, 2550 RPM e 85 kPa) não corresponder a um ponto de grade na tabela, a ECU utiliza um algoritmo de interpolação bilinear (detalhado na Seção 6.1) para calcular o valor preciso da VE entre os quatro pontos de grade circundantes.
*Cálculo do Volume Efetivo (Vefetivo): O volume efetivo de ar admitido é calculado multiplicando-se o volume de deslocamento de um único cilindro pelo valor da VE obtido.
*
*Vefetivo = DeslocamentoCilindro * VE(MAP,RPM)
*Cálculo da Massa de Ar (mar): Com a pressão (p do MAP), a temperatura (T do IAT, convertida para Kelvin)
*e o volume efetivo (V efetivo), a ECU aplica a forma derivada da Lei dos Gases Ideais para calcular a massa de ar que preencheu o cilindro durante o ciclo de admissão.
*/

#include "engine_control.h"
#include "ecu_config.h"
#include "cmsis_os.h"

// --- Definição das Variáveis Globais ---
EcuConfig_t  g_ecuConfig;
EngineData_t g_engineData;
EngineState_t g_engineState;

// Semáforo para sincronizar a tarefa com a ISR do CKP
osSemaphoreId engineSyncSemaphoreHandle;

// --- Funções Privadas (baseadas no pseudocódigo) ---

static float interpolate_bilinear(const Table2D_t* table, float rpm, float map) {
    // TODO: Implementar a lógica de interpolação bilinear completa.
    // Esta função irá procurar os 4 pontos mais próximos na tabela
    // e calcular o valor intermediário.
    return table->values[5][5]; // Retorna um valor de exemplo por agora
}

static float calculate_air_mass_sd(void) {
    // Implementação da função calcular_massa_ar_sd
    // Ref: Algoritmo ECU Speed-Density Completo.pdf

    // TODO: Implementar a lógica de mistura de temperatura de carga (IAT/CLT)
    float charge_temp_k = g_engineData.iat_celsius + 273.15f;

    float ve_percent = interpolate_bilinear(&g_ecuConfig.table_ve, g_engineState.rpm, g_engineData.map_kpa);

    float v_cyl_l = g_ecuConfig.engine_displacement_l / g_ecuConfig.num_cylinders;
    const float R_SPECIFIC_AIR = 287.0f; // J/(kg*K) -> ajustar unidades

    // Fórmula prática: AirMass (g) = (MAP_kPa * V_cyl_L * VE_%) / (R_specific * T_charge_K)
    // É preciso ajustar as unidades para consistência (ex: R em kPa*L/(g*K))
    float air_mass = (g_engineData.map_kpa * v_cyl_l * (ve_percent / 100.0f)) / (0.287 * charge_temp_k);

    return air_mass;
}

// --- Funções Públicas ---

void EngineControl_Init(void) {
    // Cria o semáforo que será usado para a sincronização
    osSemaphoreDef(engineSync);
    engineSyncSemaphoreHandle = osSemaphoreCreate(osSemaphore(engineSync), 1);
    osSemaphoreWait(engineSyncSemaphoreHandle, 0); // Garante que começa "vazio"
}

// ESTA FUNÇÃO É O CORAÇÃO DA ECU - A LÓGICA DO SEU PSEUDOCÓDIGO
void EngineControl_RunCalculations(void) {
    // 1. Calcular Massa de Ar
    g_engineState.air_mass_per_cyl_g = calculate_air_mass_sd();

    // 2. Calcular AFR Alvo
    float afr_target = interpolate_bilinear(&g_ecuConfig.table_afr_target, g_engineState.rpm, g_engineData.map_kpa);

    // 3. Calcular Massa de Combustível
    float fuel_mass_g = g_engineState.air_mass_per_cyl_g / afr_target;

    // 4. Converter para Largura de Pulso Base (em segundos)
    float pw_base_s = fuel_mass_g / g_ecuConfig.injector_flow_gps;

    // 5. Aplicar Correções (Gamma)
    // TODO: Implementar a função calcular_multiplicador_enriquecimentos()
    float gamma = 1.0f; // Por agora, sem correções

    float pw_enriched_s = pw_base_s * gamma;

    // 6. Aplicar Correção de Malha Fechada (O2)
    // TODO: Implementar a lógica de PID e STFT/LTFT
    float pw_closedloop_s = pw_enriched_s;

    // 7. Adicionar Tempo Morto do Injetor (Dead Time)
    // TODO: Implementar a interpolação 1D na Tabela_InjectorDeadTime
    float deadtime_ms = 1.1f; // Valor de exemplo
    float pw_final_s = pw_closedloop_s + (deadtime_ms / 1000.0f);

