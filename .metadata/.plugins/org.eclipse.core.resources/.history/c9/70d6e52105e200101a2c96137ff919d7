// ============================================================================
// DEFINES AND MACROS
// ============================================================================

// SPI Operation Modes (Bit 7 - R/W)
#define ST25R300_SPI_WRITE                          0x00
#define ST25R300_SPI_READ                           0x80

// SPI Commands
#define ST25R300_CMD_MASK                           0x60

// Timeouts
#define ST25R300_SPI_TIMEOUT                        100  // ms
#define ST25R300_RESET_DELAY                        2    // ms

// ============================================================================
// PRIVATE FUNCTIONS - GPIO CONTROL
// ============================================================================

/**
 * @brief  Set Chip Select (CS/BSS) pin LOW - Enable SPI
 * @param  dev: Pointer to ST25R300 device structure
 * @retval None
 */
void ST25R300_CS_Low(ST25R300 *dev) {
    if (dev && dev->CS_port) {
        HAL_GPIO_WritePin(dev->CS_port, dev->CS_pin, GPIO_PIN_RESET);
    }
}

/**
 * @brief  Set Chip Select (CS/BSS) pin HIGH - Disable SPI
 */
void ST25R300_CS_High(ST25R300 *dev) {
    if (dev && dev->CS_port) {
        HAL_GPIO_WritePin(dev->CS_port, dev->CS_pin, GPIO_PIN_SET);
    }
}

/**
 * @brief  Set Reset pin LOW - Enable device (Active State)
 */
void ST25R300_Reset_Low(ST25R300 *dev) {
    if (dev && dev->reset_port) {
        HAL_GPIO_WritePin(dev->reset_port, dev->reset_pin, GPIO_PIN_RESET);
    }
}

/**
 * @brief  Set Reset pin HIGH - Hold device in reset
 */
void ST25R300_Reset_High(ST25R300 *dev) {
    if (dev && dev->reset_port) {
        HAL_GPIO_WritePin(dev->reset_port, dev->reset_pin, GPIO_PIN_SET);
    }
}

/**
 * @brief  Read IRQ pin state
 */
GPIO_PinState ST25R300_IRQ_Read(ST25R300 *dev) {
    if (dev && dev->IRQ_port) {
        return HAL_GPIO_ReadPin(dev->IRQ_port, dev->IRQ_pin);
    }
    return GPIO_PIN_RESET; // Retorno padrão seguro
}

// ============================================================================
// PUBLIC FUNCTIONS - REGISTER ACCESS
// ============================================================================

/**
 * @brief  Write a single byte to a register
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Register address (0x00 to 0x57)
 * @param  data: Data byte to write
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_WriteRegister(ST25R300 *dev, uint8_t reg,
		uint8_t data) {
	HAL_StatusTypeDef status;
	uint8_t tx_buffer[2];

	// Validate register address
	if (reg > 0x57) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 0 for write)
	tx_buffer[0] = (reg & 0x7F);  // Clear bit 7 for write operation
	tx_buffer[1] = data;

	// SPI Transaction
	ST25R300_CS_Low(dev);
	status = HAL_SPI_Transmit(dev->hSPIx, tx_buffer, 2, ST25R300_SPI_TIMEOUT);
	ST25R300_CS_High(dev);

	return status;
}

/**
 * @brief  Write multiple bytes to consecutive registers (auto-increment)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Starting register address (0x00 to 0x57)
 * @param  data: Pointer to data buffer
 * @param  length: Number of bytes to write
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_WriteRegisters(ST25R300 *dev, uint8_t reg,
		uint8_t *data, uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd;

	// Validate parameters
	if (reg > 0x57 || data == NULL || length == 0) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 0 for write)
	cmd = (reg & 0x7F);

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send command byte
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Send data bytes (address auto-increments)
		status = HAL_SPI_Transmit(dev->hSPIx, data, length,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	return status;
}

/**
 * @brief  Read a single byte from a register
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Register address (0x00 to 0x57)
 * @param  data: Pointer to store read data
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_ReadRegister(ST25R300 *dev, uint8_t reg,
		uint8_t *data) {
	HAL_StatusTypeDef status;
	uint8_t cmd;
	uint8_t dummy = 0x00;

	// Validate parameters
	if (reg > 0x57 || data == NULL) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 1 for read)
	cmd = (reg | 0x80);  // Set bit 7 for read operation

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send command byte
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Send dummy byte and receive data
		status = HAL_SPI_TransmitReceive(dev->hSPIx, &dummy, data, 1,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	return status;
}

/**
 * @brief  Read multiple bytes from consecutive registers (auto-increment)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Starting register address (0x00 to 0x57)
 * @param  data: Pointer to buffer to store read data
 * @param  length: Number of bytes to read
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_ReadRegisters(ST25R300 *dev, uint8_t reg,
		uint8_t *data, uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd;

	// Validate parameters
	if (reg > 0x57 || data == NULL || length == 0) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 1 for read)
	cmd = (reg | 0x80);

	// Prepare dummy buffer for transmit
	uint8_t *dummy_tx = (uint8_t*) calloc(length, sizeof(uint8_t));
	if (dummy_tx == NULL) {
		return HAL_ERROR;
	}

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send command byte
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Send dummy bytes and receive data (address auto-increments)
		status = HAL_SPI_TransmitReceive(dev->hSPIx, dummy_tx, data, length,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	free(dummy_tx);

	return status;
}

/**
 * @brief  Modify specific bits in a register (Read-Modify-Write)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Register address (0x00 to 0x57)
 * @param  mask: Bit mask for bits to modify
 * @param  value: New value for masked bits
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 *
 * @note   Example: To set bit 3 and clear bit 1:
 *         ST25R300_ModifyRegister(dev, reg, 0x0A, 0x08)
 *         mask = 0b00001010, value = 0b00001000
 */
HAL_StatusTypeDef ST25R300_ModifyRegister(ST25R300 *dev, uint8_t reg,
		uint8_t mask, uint8_t value) {
	HAL_StatusTypeDef status;
	uint8_t reg_value;

	// Read current register value
	status = ST25R300_ReadRegister(dev, reg, &reg_value);

	if (status == HAL_OK) {
		// Clear bits to modify and set new values
		reg_value = (reg_value & ~mask) | (value & mask);

		// Write modified value back
		status = ST25R300_WriteRegister(dev, reg, reg_value);
	}

	return status;
}

// ============================================================================
// PUBLIC FUNCTIONS - FIFO ACCESS
// ============================================================================

/**
 * @brief  Write data to FIFO
 * @param  dev: Pointer to ST25R300 device structure
 * @param  data: Pointer to data buffer
 * @param  length: Number of bytes to write (1-256)
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_WriteFIFO(ST25R300 *dev, uint8_t *data,
		uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd = 0x5F;  // FIFO write address (bit 7 = 0 for write)

	// Validate parameters
	if (data == NULL || length == 0 || length > 256) {
		return HAL_ERROR;
	}

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send FIFO write command
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Write data to FIFO
		status = HAL_SPI_Transmit(dev->hSPIx, data, length,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	return status;
}

/**
 * @brief  Read data from FIFO
 * @param  dev: Pointer to ST25R300 device structure
 * @param  data: Pointer to buffer to store read data
 * @param  length: Number of bytes to read (1-256)
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_ReadFIFO(ST25R300 *dev, uint8_t *data,
		uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd = 0xDF;  // FIFO read address (0x5F | 0x80)

	// Validate parameters
	if (data == NULL || length == 0 || length > 256) {
		return HAL_ERROR;
	}

	// Prepare dummy buffer
	uint8_t *dummy_tx = (uint8_t*) calloc(length, sizeof(uint8_t));
	if (dummy_tx == NULL) {
		return HAL_ERROR;
	}

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send FIFO read command
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Read data from FIFO
		status = HAL_SPI_TransmitReceive(dev->hSPIx, dummy_tx, data, length,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	free(dummy_tx);

	return status;
}

