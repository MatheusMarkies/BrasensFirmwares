/**
 * @brief  Hardware reset of ST25R300
 * @param  dev: Pointer to ST25R300 device structure
 * @retval None
 *
 * @note   Reset pulse must be at least 10μs HIGH according to datasheet
 *         After reset, wait at least 138μs before first SPI operation
 */
void ST25R300_HardwareReset(ST25R300 *dev) {
	// Set RESET high (device in reset state)
	ST25R300_Reset_High(dev);
	HAL_Delay(ST25R300_RESET_DELAY);

	// Set RESET low (device active)
	ST25R300_Reset_Low(dev);
	HAL_Delay(1);  // Wait for device to boot (t_BOOT = 138μs typical)
}

/**
 * @brief  Check if IRQ is active
 * @param  dev: Pointer to ST25R300 device structure
 * @retval uint8_t: 1 if IRQ is active (HIGH), 0 otherwise
 */
uint8_t ST25R300_IsIRQ_Active(ST25R300 *dev) {
	return (ST25R300_IRQ_Read(dev) == GPIO_PIN_SET) ? 1 : 0;
}

/**
 * @brief  Initialize ST25R300 GPIO pins and reset device
 * @param  dev: Pointer to ST25R300 device structure (must be pre-configured)
 * @retval HAL_StatusTypeDef: HAL_OK if success
 *
 * @note   This function assumes GPIOs and SPI are already initialized by CubeMX
 */
HAL_StatusTypeDef ST25R300_Init(ST25R300 *dev) {
	// Validate device structure
	if (dev == NULL || dev->hSPIx == NULL) {
		return HAL_ERROR;
	}

	// Set initial pin states
	ST25R300_CS_High(dev);      // CS inactive (HIGH)
	ST25R300_Reset_High(dev);   // Device in reset

	// Perform hardware reset
	ST25R300_HardwareReset(dev);

	return HAL_OK;
}

uint16_t ST25R300_Identity(ST25R300 *_st25) {
	uint8_t read = ST25R300_ReadRegister(_st25, ST25R300_REG_IC_IDENTITY, 0);
	if ((read & 0xF8) != 0xB0)
		return ST25_OK;
	else
		return ST25_NOT_FOUND;
}

HAL_StatusTypeDef ST25R300_SetAntennaMode(ST25R300 *dev, ST25R300_AntennaMode_t mode)
{
    uint8_t value = (mode == ST25R300_ANTENNA_SINGLE) ? ST25R300_GENERAL_CFG_SINGLE_BIT : 0x00;

    return ST25R300_ModifyRegister(dev,
                                   ST25R300_REG_GENERAL_CONFIG,
                                   ST25R300_GENERAL_CFG_SINGLE_BIT,
                                   value);
}

/**
 * @brief  Select which RFO output to use in Single-Ended mode
 * @param  dev: Pointer to ST25R300 device structure
 * @param  rfo: RFO output selection
 *         @arg ST25R300_RFO1: Use RFO1 and RFI1
 *         @arg ST25R300_RFO2: Use RFO2 and RFI2 (field detector sense at RFI2)
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 *
 * @note   This setting only applies when antenna is in Single-Ended mode
 * @note   Can be used to switch between two different antennas dynamically
 */
HAL_StatusTypeDef ST25R300_SelectRFO(ST25R300 *dev, ST25R300_RFO_Select_t rfo)
{
    uint8_t value = (rfo == ST25R300_RFO2) ? ST25R300_GENERAL_CFG_RFO2_BIT : 0x00;

    return ST25R300_ModifyRegister(dev,
                                   ST25R300_REG_GENERAL_CONFIG,
                                   ST25R300_GENERAL_CFG_RFO2_BIT,
                                   value);
}

/**
 * @brief  Configure antenna in Single-Ended mode with RFO selection
 * @param  dev: Pointer to ST25R300 device structure
 * @param  rfo: RFO output selection (RFO1 or RFO2)
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 *
 * @note   Combined function to set single-ended mode and select RFO in one call
 */
HAL_StatusTypeDef ST25R300_ConfigureSingleEndedAntenna(ST25R300 *dev, ST25R300_RFO_Select_t rfo)
{
    HAL_StatusTypeDef status;
    uint8_t config_value;

    // Read current configuration
    status = ST25R300_ReadRegister(dev, ST25R300_REG_GENERAL_CONFIG, &config_value);

    if (status == HAL_OK)
    {
        // Set Single mode bit
        config_value |= ST25R300_GENERAL_CFG_SINGLE_BIT;

        // Set or clear RFO2 bit based on selection
        if (rfo == ST25R300_RFO2)
        {
            config_value |= ST25R300_GENERAL_CFG_RFO2_BIT;
        }
        else
        {
            config_value &= ~ST25R300_GENERAL_CFG_RFO2_BIT;
        }

        // Write back configuration
        status = ST25R300_WriteRegister(dev, ST25R300_REG_GENERAL_CONFIG, config_value);
    }

    return status;
}

/**
 * @brief  Configure antenna in Differential mode (default)
 * @param  dev: Pointer to ST25R300 device structure
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 *
 * @note   In differential mode, both RFO1 and RFO2 drive the antenna
 */
HAL_StatusTypeDef ST25R300_ConfigureDifferentialAntenna(ST25R300 *dev)
{
    // Clear Single bit to enable differential mode
    return ST25R300_ModifyRegister(dev,
                                   ST25R300_REG_GENERAL_CONFIG,
                                   ST25R300_GENERAL_CFG_SINGLE_BIT,
                                   0x00);
}

/**
 * @brief  Get current antenna configuration
 * @param  dev: Pointer to ST25R300 device structure
 * @param  mode: Pointer to store antenna mode
 * @param  rfo: Pointer to store RFO selection (only valid in single-ended mode)
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_GetAntennaConfig(ST25R300 *dev,
                                           ST25R300_AntennaMode_t *mode,
                                           ST25R300_RFO_Select_t *rfo)
{
    HAL_StatusTypeDef status;
    uint8_t config_value;

    // Validate parameters
    if (mode == NULL || rfo == NULL)
    {
        return HAL_ERROR;
    }

    // Read configuration register
    status = ST25R300_ReadRegister(dev, ST25R300_REG_GENERAL_CONFIG, &config_value);

    if (status == HAL_OK)
    {
        // Extract antenna mode
        *mode = (config_value & ST25R300_GENERAL_CFG_SINGLE_BIT) ?
                ST25R300_ANTENNA_SINGLE : ST25R300_ANTENNA_DIFFERENTIAL;

        // Extract RFO selection
        *rfo = (config_value & ST25R300_GENERAL_CFG_RFO2_BIT) ?
               ST25R300_RFO2 : ST25R300_RFO1;
    }

    return status;
}
