/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_RTC_Init();
  MX_LPTIM1_Init();
  MX_LPUART1_UART_Init();
  /* USER CODE BEGIN 2 */
	int32_t offset = 0;
	int32_t average = 0;
	int32_t sum = 0;
	int count = 0;

	DEBUG_PRINT("Starting...\r\n");

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	while (1) {

		switch (state) {
		case CHARGING:
			rtc_start_wakeup(15000);
			enter_stop_mode();
			break;
		case TARING:
			DEBUG_PRINT("TARING...\r\n");
			int16_t raw_adc = ADS1115_Read() * -1;

			if (abs(raw_adc) > 0) {
				if (count < SAMPLES_FOR_TARING) {  // Mudei <= para
					sum += raw_adc;
					count++;
					offset = sum / count;
					DEBUG_PRINT("Sample ");
					debug_print_int(count);
					DEBUG_PRINT("\r\n");
				} else {
					count = 0;
					sum = 0;

					DEBUG_PRINT("offset:\r");
					debug_print_int(offset);
					DEBUG_PRINT("\r\n");

					isTared = 1;
					DEBUG_PRINT("Taring complete!\r\n");

					state = CHARGING;
				}
			} else {
				DEBUG_PRINT("Invalid ADC reading\r\n");
			}

			HAL_Delay(READING_SAMPLING_INTERVAL_MS);
			break;
		case READING:
			state = PROCESSING;
			break;

		case PROCESSING:
			int16_t raw_adc = ADS1115_Read() * -1;

			sum += raw_adc;
			count++;

			if (count >= 10) {
				average = sum / count;

				int32_t delta_bits = average - offset;

				voltage_uV = delta_bits * LSB_UV;
				strain_uE = (delta_bits * USTRAIN_PER_BIT_x1000) / 1000;

				sum = 0;
				count = 0;

				DEBUG_PRINT("voltage_uV:\r");
				debug_print_int(voltage_uV);
				DEBUG_PRINT("\r\n");
				DEBUG_PRINT("strain_uE:\r");
				debug_print_int(strain_uE);
				DEBUG_PRINT("\r\n");

				state = CHARGING;
			}

			HAL_Delay(READING_SAMPLING_INTERVAL_MS);
			break;


		}

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	}
  /* USER CODE END 3 */
}

