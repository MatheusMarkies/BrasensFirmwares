/**
 * @file st25r300_hal.h
 * @brief ST25R300 NFC Reader HAL Driver
 * @author System Developer
 * @date 2026-01-15
 *
 * Driver completo para ST25R300 com suporte a:
 * - Inicialização e configuração do chip
 * - Leitura de MailBox do ST25DV
 * - Energy Harvesting
 * - Operações NFC-V (ISO15693)
 */

#ifndef ST25R300_HAL_H
#define ST25R300_HAL_H

#include "stm32f1xx_hal.h"
#include <stdint.h>
#include <stdbool.h>

/* ============================================================================
 * DEFINIÇÕES DE REGISTRADORES ST25R300
 * Baseado no datasheet DS14655 - Rev 2
 * ============================================================================ */

// Registradores de Operação (Seção 5.17)
#define ST25R300_REG_OPERATION          0x00
#define ST25R300_REG_GENERAL_CONFIG     0x01
#define ST25R300_REG_VDDDR_CONFIG       0x02
#define ST25R300_REG_TX_DRIVER_CONFIG   0x03
#define ST25R300_REG_TX_MODULATION1     0x04
#define ST25R300_REG_TX_MODULATION2     0x05

// Registradores de Protocolo (ISO15693/NFC-V)
#define ST25R300_REG_PROTOCOL1          0x14
#define ST25R300_REG_TX_PROTOCOL1       0x15
#define ST25R300_REG_TX_PROTOCOL2       0x16
#define ST25R300_REG_RX_PROTOCOL1       0x17

// Registradores de Timer
#define ST25R300_REG_MASK_RX_TIMER1     0x1F
#define ST25R300_REG_MASK_RX_TIMER2     0x20
#define ST25R300_REG_NRT_GPT_CONFIG1    0x22
#define ST25R300_REG_NRT_GPT_CONFIG2    0x23
#define ST25R300_REG_NRT_GPT_CONFIG3    0x24

// Registradores de IRQ
#define ST25R300_REG_IRQ_MASK1          0x39
#define ST25R300_REG_IRQ_MASK2          0x3A
#define ST25R300_REG_IRQ_STATUS1        0x3C
#define ST25R300_REG_IRQ_STATUS2        0x3D

// Registradores de Status
#define ST25R300_REG_IC_IDENTITY        0x3F
#define ST25R300_REG_STATUS1            0x40
#define ST25R300_REG_STATUS2            0x41

// Registradores de FIFO
#define ST25R300_REG_TX_FRAME_CONFIG1   0x34
#define ST25R300_REG_TX_FRAME_CONFIG2   0x35
#define ST25R300_REG_FIFO_STATUS1       0x36
#define ST25R300_REG_FIFO_STATUS2       0x37

// Endereço de acesso ao FIFO
#define ST25R300_FIFO_ADDRESS           0x5F

/* ============================================================================
 * COMANDOS DIRETOS (Seção 5.16)
 * ============================================================================ */

#define ST25R300_CMD_SET_DEFAULT        0x60
#define ST25R300_CMD_STOP_ALL           0x62
#define ST25R300_CMD_CLEAR_FIFO         0x64
#define ST25R300_CMD_CLEAR_RX_GAIN      0x66
#define ST25R300_CMD_ADJUST_REGULATORS  0x68
#define ST25R300_CMD_TRANSMIT_DATA      0x6A
#define ST25R300_CMD_NFC_FIELD_ON       0x6E
#define ST25R300_CMD_CALIBRATE_RC       0xEE

/* ============================================================================
 * BITS DE CONFIGURAÇÃO
 * ============================================================================ */

// Operation Register (0x00)
#define ST25R300_OP_WPT_EN              (1 << 7)
#define ST25R300_OP_TX_EN               (1 << 6)
#define ST25R300_OP_RX_EN               (1 << 5)
#define ST25R300_OP_VDDDR_EN            (1 << 4)
#define ST25R300_OP_EN                  (1 << 3)
#define ST25R300_OP_CE_EN               (1 << 2)
#define ST25R300_OP_WU_EN               (1 << 0)

// Protocol Register 1 (0x14)
#define ST25R300_PROT_OM_NFCV           0x05  // ISO15693/NFC-V mode

// General Configuration (0x01)
#define ST25R300_GEN_SINGLE             (1 << 5)  // Single-ended antenna
#define ST25R300_GEN_RFO2               (1 << 4)  // Use RFO2/RFI2

// IRQ Bits
#define ST25R300_IRQ_OSC                (1 << 0)  // Oscillator ready
#define ST25R300_IRQ_DCT                (1 << 4)  // Direct command terminated
#define ST25R300_IRQ_TXE                (1 << 1)  // TX end
#define ST25R300_IRQ_RXS                (1 << 2)  // RX start
#define ST25R300_IRQ_RXE                (1 << 3)  // RX end
#define ST25R300_IRQ_NRE                (1 << 6)  // No response

/* ============================================================================
 * ESTRUTURAS DE DADOS
 * ============================================================================ */

/**
 * @brief Configuração de hardware do ST25R300
 */
typedef struct {
    SPI_HandleTypeDef *hspi;        // Handle do SPI
    GPIO_TypeDef *nss_port;         // Porta GPIO do NSS
    uint16_t nss_pin;               // Pino NSS
    GPIO_TypeDef *irq_port;         // Porta GPIO do IRQ
    uint16_t irq_pin;               // Pino IRQ
    GPIO_TypeDef *rst_port;         // Porta GPIO do IRQ
    uint16_t rst_pin;               // Pino IRQ
    uint32_t spi_timeout;           // Timeout SPI (ms)
} ST25R300_HW_Config;

/**
 * @brief Estado operacional do ST25R300
 */
typedef enum {
    ST25R300_STATE_RESET = 0,
    ST25R300_STATE_POWER_DOWN,
    ST25R300_STATE_READY,
    ST25R300_STATE_TX_ACTIVE,
    ST25R300_STATE_RX_ACTIVE,
    ST25R300_STATE_ERROR
} ST25R300_State;

/**
 * @brief Configuração de operação NFC-V
 */
typedef struct {
    uint8_t tx_rate;                // Taxa TX (0=26kbps, 1=53kbps, 2=106kbps)
    uint8_t rx_rate;                // Taxa RX
    uint8_t modulation_depth;       // Profundidade de modulação (0-15)
    uint16_t guard_time_ms;         // Tempo de guarda (ms)
    uint16_t no_response_time_ms;   // Timeout de resposta (ms)
} ST25R300_NFCV_Config;

/**
 * @brief Handle principal do ST25R300
 */
typedef struct {
    ST25R300_HW_Config hw;
    ST25R300_State state;
    ST25R300_NFCV_Config nfcv;
    uint8_t ic_type;                // Tipo do IC (0x16 para ST25R300)
    uint8_t ic_revision;            // Revisão do IC
    volatile bool irq_pending;      // Flag de IRQ pendente
} ST25R300_Handle;

/* ============================================================================
 * FUNÇÕES DE INICIALIZAÇÃO
 * ============================================================================ */

/**
 * @brief Inicializa o ST25R300
 * @param dev Handle do dispositivo
 * @param hw_config Configuração de hardware
 * @return HAL_StatusTypeDef
 *
 * Sequência conforme datasheet página 11 (Seção 5.2):
 * 1. Aplica configuração nos registradores
 * 2. Set en=1 e aguarda I_osc
 * 3. Habilita VDD_DR e aguarda 10µs
 * 4. Habilita TX/RX
 * 5. Executa adjust regulator
 * 6. Executa calibrate RC
 */
HAL_StatusTypeDef ST25R300_Init(ST25R300_Handle *dev,
                                const ST25R300_HW_Config *hw_config);

/**
 * @brief Verifica identidade do chip
 * @param dev Handle do dispositivo
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_CheckIdentity(ST25R300_Handle *dev);

/**
 * @brief Configura modo NFC-V (ISO15693)
 * @param dev Handle do dispositivo
 * @param config Configuração NFC-V
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_ConfigureNFCV(ST25R300_Handle *dev,
                                         const ST25R300_NFCV_Config *config);

/**
 * @brief Liga o campo RF
 * @param dev Handle do dispositivo
 * @return HAL_StatusTypeDef
 *
 * Executa NFC Field On command (página 37)
 * - Realiza collision avoidance
 * - Aguarda campo estabilizar
 */
HAL_StatusTypeDef ST25R300_FieldOn(ST25R300_Handle *dev);

/**
 * @brief Desliga o campo RF
 * @param dev Handle do dispositivo
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_FieldOff(ST25R300_Handle *dev);

/* ============================================================================
 * FUNÇÕES SPI DE BAIXO NÍVEL
 * ============================================================================ */

/**
 * @brief Escreve em um registrador
 * @param dev Handle do dispositivo
 * @param addr Endereço do registrador (0x00-0x57)
 * @param data Dado a escrever
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_WriteRegister(ST25R300_Handle *dev,
                                         uint8_t addr,
                                         uint8_t data);

/**
 * @brief Lê de um registrador
 * @param dev Handle do dispositivo
 * @param addr Endereço do registrador
 * @param data Ponteiro para armazenar o dado
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_ReadRegister(ST25R300_Handle *dev,
                                        uint8_t addr,
                                        uint8_t *data);

/**
 * @brief Executa comando direto
 * @param dev Handle do dispositivo
 * @param cmd Código do comando
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_DirectCommand(ST25R300_Handle *dev, uint8_t cmd);

/**
 * @brief Escreve dados no FIFO
 * @param dev Handle do dispositivo
 * @param data Buffer de dados
 * @param length Tamanho dos dados
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_WriteFIFO(ST25R300_Handle *dev,
                                     const uint8_t *data,
                                     uint16_t length);

/**
 * @brief Lê dados do FIFO
 * @param dev Handle do dispositivo
 * @param data Buffer para receber dados
 * @param length Tamanho a ler
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_ReadFIFO(ST25R300_Handle *dev,
                                    uint8_t *data,
                                    uint16_t length);

/* ============================================================================
 * FUNÇÕES DE IRQ
 * ============================================================================ */

/**
 * @brief Handler de IRQ (chamar da EXTI callback)
 * @param dev Handle do dispositivo
 */
void ST25R300_IRQ_Handler(ST25R300_Handle *dev);

/**
 * @brief Aguarda IRQ específica
 * @param dev Handle do dispositivo
 * @param irq_mask Máscara de IRQ a aguardar
 * @param timeout_ms Timeout em ms
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_WaitIRQ(ST25R300_Handle *dev,
                                   uint8_t irq_mask,
                                   uint32_t timeout_ms);

/**
 * @brief Limpa IRQs pendentes
 * @param dev Handle do dispositivo
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_ClearIRQ(ST25R300_Handle *dev);

/* ============================================================================
 * FUNÇÕES DE UTILIDADE
 * ============================================================================ */

/**
 * @brief Lê número de bytes no FIFO
 * @param dev Handle do dispositivo
 * @param bytes Ponteiro para armazenar contagem
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_GetFIFOLength(ST25R300_Handle *dev, uint16_t *bytes);

/**
 * @brief Reset do chip via comando
 * @param dev Handle do dispositivo
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_Reset(ST25R300_Handle *dev);

#endif /* ST25R300_HAL_H */
