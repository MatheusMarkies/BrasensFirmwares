#ifndef INC_ECU_CONFIG_H_
#define INC_ECU_CONFIG_H_

#include <stdint.h>

// Estrutura para uma tabela de interpolação 1D (ex: Vbat -> Deadtime)
typedef struct {
	int rows;
	int cols;
    const float *x_axis;
    const float *values;
} Table1D_t;

// Estrutura para uma tabela de interpolação 2D (ex: VE, AFR Alvo)
typedef struct {
	int rows;
	int cols;
    const float *x_axis;
    const float *y_axis;
    const float *values;
} Table2D_t;

typedef enum {
    SENSOR_TYPE_NONE = 0,
    SENSOR_TYPE_TPS,      // Posição da Borboleta
	SENSOR_TYPE_CKP,      // Posição do Virabrequin
	SENSOR_TYPE_CMP,      // Posição do Comando
    SENSOR_TYPE_CLT,      // Temperatura do Motor
    SENSOR_TYPE_IAT,      // Temperatura do Ar
} SensorType_e;

// Estrutura principal com TODAS as configurações e tabelas da ECU
typedef struct {
    uint32_t config_version;

    // Configurações do Motor
    uint8_t num_cylinders;
    float engine_displacement_l; // Deslocamento total em litros
    float injector_flow_gps;     // g/s por injetor
    float afr_stoich;            // ex: 14.7

    SensorType_e sensor_channel_map[12];

    // Constante de Combustível Calculada
    float required_fuel_const;   // Calculada a partir dos params acima

    // Tabelas de Calibração
    Table2D_t table_ve;
    Table2D_t table_afr_target;
    Table2D_t table_spark_advance;
    Table1D_t table_warmup_enrichment;  // Enriquecimento de aquecimento (WUE)
    Table1D_t table_accel_enrichment;   // Enriquecimento de aceleração (AE)
    Table1D_t table_injector_deadtime;  // Tempo morto do injetor vs Vbat

    float gamma_min;
    float gamma_max;

} EcuConfig_t;

// Estrutura para armazenar os dados lidos em tempo real.
typedef struct {
    float tps_percent;
    float clt_celsius;
    float position;
    float cmp_position;
    float iat_celsius;
    float map_kpa;
    float maf_volume;
    float o2_lambda;
    float battery_voltage;
} EngineData_t;

// Estrutura para armazenar o estado calculado do motor
typedef struct {
    uint32_t rpm;
    float    engine_angle_deg;
    float    air_mass_per_cyl_g; // Massa de ar calculada (g)
    float    final_fuel_pw_ms;   // Largura de pulso final (ms)
    float    final_spark_deg;    // Avanço de ignição final (graus)
    int      is_in_dfco;         // Flag para corte de combustível em desaceleração
} EngineState_t;

#endif /* INC_ECU_CONFIG_H_ */
