/* ============================================================
 * ST25R300 – Register Map (base)
 * Apenas defines, prontos para uso em library
 * ============================================================ */

/* ---------------------------
 * 0x00 – 0x03 : Device control
 * --------------------------- */

/* Operation register
 * Controla os modos principais do chip:
 * PD, WU, RD, Reader, Card Emulation, TX/RX enable
 */
#define ST25R300_REG_OPERATION              0x00

/* General configuration
 * Configurações globais:
 * single/differential antenna, seleção RFO/RFI, etc
 */
#define ST25R300_REG_GENERAL_CONFIG         0x01

/* Protocol register 1
 * Seleção de tecnologia NFC:
 * NFC-A/B/F/V, Reader ou CE, bit rate base
 */
#define ST25R300_REG_PROTOCOL_1             0x02

/* Protocol register 2
 * Extensão do protocolo:
 * bit rates altos, modos especiais, NFC-V slots
 */
#define ST25R300_REG_PROTOCOL_2             0x03


/* ---------------------------
 * 0x04 – 0x07 : IRQ control
 * --------------------------- */

/* IRQ enable register 1
 * Habilita interrupções principais:
 * TX end, RX end, FIFO level, oscillator ready
 */
#define ST25R300_REG_IRQ_ENABLE_1            0x04

/* IRQ enable register 2
 * Habilita interrupções avançadas:
 * NRT timeout, wake-up, card detect, errors
 */
#define ST25R300_REG_IRQ_ENABLE_2            0x05

/* IRQ status register 1
 * Flags de interrupção (leitura limpa bits):
 * TXE, RXE, FIFO WL, OSC OK
 */
#define ST25R300_REG_IRQ_STATUS_1            0x06

/* IRQ status register 2
 * Flags avançadas:
 * NRT expired, WUT, NFC target detect, errors
 */
#define ST25R300_REG_IRQ_STATUS_2            0x07


/* ---------------------------
 * 0x08 – 0x0B : FIFO
 * --------------------------- */

/* FIFO control register
 * Reset FIFO, flush TX/RX, modo FIFO
 */
#define ST25R300_REG_FIFO_CONTROL            0x08

/* FIFO status register 1
 * Número de bytes atualmente no FIFO
 */
#define ST25R300_REG_FIFO_STATUS_1           0x09

/* FIFO status register 2
 * Flags de overflow/underflow e water level
 */
#define ST25R300_REG_FIFO_STATUS_2           0x0A

/* FIFO data register
 * Escrita: dados para transmitir
 * Leitura: dados recebidos
 */
#define ST25R300_REG_FIFO_DATA               0x0B


/* ---------------------------
 * 0x0C – 0x11 : Transmitter
 * --------------------------- */

/* TX driver configuration
 * Define resistência do driver (output power)
 */
#define ST25R300_REG_TX_DRIVER               0x0C

/* TX modulation register 1
 * Seleção AM ou OOK, índice de modulação
 */
#define ST25R300_REG_TX_MODULATION_1         0x0D

/* TX modulation register 2
 * Ajustes adicionais de modulação
 */
#define ST25R300_REG_TX_MODULATION_2         0x0E

/* TX frame configuration 1
 * Número de bytes a transmitir (LSB)
 */
#define ST25R300_REG_TX_FRAME_CFG_1          0x0F

/* TX frame configuration 2
 * Número de bytes a transmitir (MSB)
 */
#define ST25R300_REG_TX_FRAME_CFG_2          0x10

/* NFC field control
 * Liga/desliga campo RF manualmente
 */
#define ST25R300_REG_FIELD_CONTROL           0x11


/* ---------------------------
 * 0x12 – 0x18 : Receiver
 * --------------------------- */

/* RX analog settings 1
 * HPF, ganho máximo, boost de ganho
 */
#define ST25R300_REG_RX_ANALOG_1             0x12

/* RX analog settings 2
 * Ganho inicial AFE (Reader/WU)
 */
#define ST25R300_REG_RX_ANALOG_2             0x13

/* RX analog settings 3
 * Ganho AFE para Card Emulation
 */
#define ST25R300_REG_RX_ANALOG_3             0x14

/* RX digital settings
 * AGC enable, filtros digitais IIR
 */
#define ST25R300_REG_RX_DIGITAL              0x15

/* Correlator settings 1
 * Tipo de demodulação: Manchester / BPSK
 */
#define ST25R300_REG_CORRELATOR_1             0x16

/* Correlator settings 2
 * Thresholds, AGC, coeficientes IIR
 */
#define ST25R300_REG_CORRELATOR_2             0x17

/* RSSI display
 * Nível de sinal recebido (diagnóstico)
 */
#define ST25R300_REG_RSSI_DISPLAY             0x18


/* ---------------------------
 * 0x19 – 0x1F : Timers
 * --------------------------- */

/* Mask Receive Timer config 1
 * Configura squelch e delay após TX
 */
#define ST25R300_REG_MRT_CFG_1                0x19

/* Mask Receive Timer config 2
 * Valor do timeout do MRT
 */
#define ST25R300_REG_MRT_CFG_2                0x1A

/* NRT & GPT config 1
 * Seleção de modo NRT / trigger GPT
 */
#define ST25R300_REG_NRT_GPT_CFG_1            0x1B

/* NRT & GPT config 2
 * Valor NRT (LSB)
 */
#define ST25R300_REG_NRT_GPT_CFG_2            0x1C

/* NRT & GPT config 3
 * Valor NRT (MSB)
 */
#define ST25R300_REG_NRT_GPT_CFG_3            0x1D

/* GPT value LSB */
#define ST25R300_REG_GPT_VAL_LSB              0x1E

/* GPT value MSB */
#define ST25R300_REG_GPT_VAL_MSB              0x1F

/* =========================
 * ST25R300 Commands
 * ========================= */
#define ST25R300_CMD_STOP_ALL    0xC0  /* Stop all activities */
#define ST25R300_CMD_FIELD_ON    0xC3  /* Switch RF field ON  */
#define ST25R300_CMD_FIELD_OFF   0xC2  /* Switch RF field OFF */
/* =========================
 * OPERATION register bits
 * ========================= */
#define ST25_OP_EN        (1 << 0)  /* Enable chip */
#define ST25_OP_TX_EN     (1 << 1)  /* Enable transmitter */
#define ST25_OP_RX_EN     (1 << 2)  /* Enable receiver */
#define ST25_OP_VDDDR_EN  (1 << 3)  /* Enable TX driver regulator */
/* =========================
 * IRQ STATUS 1 bits
 * ========================= */
#define ST25_IRQ_OSC_OK   (1 << 0)  /* Oscillator stable */


#define ST25_SPI_READ_MASK   0x80
#define ST25_SPI_WRITE_MASK  0x00

#define DEBUG_PRINT(msg) HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), 200)

