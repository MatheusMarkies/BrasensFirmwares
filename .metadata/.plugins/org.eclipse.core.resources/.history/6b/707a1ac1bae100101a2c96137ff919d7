void st25r300_write_reg(uint8_t reg, uint8_t value)
{
    uint8_t tx[2];

    tx[0] = (reg & 0x3F) | ST25_SPI_WRITE_MASK;
    tx[1] = value;

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, tx, 2, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);
}

uint8_t st25r300_read_reg(uint8_t reg)
{
    uint8_t tx[2];
    uint8_t rx[2];

    tx[0] = (reg & 0x3F) | ST25_SPI_READ_MASK;
    tx[1] = 0x00;

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_TransmitReceive(&hspi2, tx, rx, 2, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);

    return rx[1];
}

void st25r300_cmd(uint8_t cmd)
{
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, &cmd, 1, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);
}

void st25r300_set_bits(uint8_t reg, uint8_t mask)
{
    uint8_t val;

    val = st25r300_read_reg(reg);
    val |= mask;
    st25r300_write_reg(reg, val);
}

st25_test_result_t st25r300_test_antenna_and_connection(void)
{
    uint8_t val;
    uint32_t timeout;

    DEBUG_PRINT("ST25: Test start\r\n");

    /* =====================================================
     * 1. Teste de SPI
     * ===================================================== */
    DEBUG_PRINT("ST25: SPI check...\r\n");

    val = st25r300_read_reg(ST25R300_REG_GENERAL_CONFIG);

    if (val == 0xFF || val == 0x00) {
        DEBUG_PRINT("ST25: SPI FAIL\r\n");
        return ST25_TEST_SPI_FAIL;
    }

    DEBUG_PRINT("ST25: SPI OK\r\n");

    /* =====================================================
     * 2. Oscilador / Ready
     * ===================================================== */
    DEBUG_PRINT("ST25: Oscillator check...\r\n");

    st25r300_cmd(ST25R300_CMD_STOP_ALL);

    st25r300_write_reg(ST25R300_REG_OPERATION, ST25_OP_EN);

    timeout = 10000;
    do {
        val = st25r300_read_reg(ST25R300_REG_IRQ_STATUS_1);
        if (val & ST25_IRQ_OSC_OK)
            break;
    } while (--timeout);

    if (timeout == 0) {
        DEBUG_PRINT("ST25: OSC FAIL\r\n");
        return ST25_TEST_OSC_FAIL;
    }

    DEBUG_PRINT("ST25: OSC OK\r\n");

    /* =====================================================
     * 3. RF / Antena
     * ===================================================== */
    DEBUG_PRINT("ST25: RF enable...\r\n");

    st25r300_set_bits(ST25R300_REG_OPERATION, ST25_OP_VDDDR_EN);
    HAL_Delay(10);

    st25r300_set_bits(ST25R300_REG_OPERATION,
                      ST25_OP_TX_EN | ST25_OP_RX_EN);

    st25r300_cmd(ST25R300_CMD_FIELD_ON);
    HAL_Delay(2);

    val = st25r300_read_reg(ST25R300_REG_RSSI_DISPLAY);

    if (val < 5) {
        DEBUG_PRINT("ST25: ANTENNA FAIL\r\n");
        st25r300_cmd(ST25R300_CMD_FIELD_OFF);
        return ST25_TEST_ANTENNA_FAIL;
    }

    DEBUG_PRINT("ST25: ANTENNA OK\r\n");

    st25r300_cmd(ST25R300_CMD_FIELD_OFF);

    DEBUG_PRINT("ST25: Test OK\r\n");

    return ST25_TEST_OK;
}


