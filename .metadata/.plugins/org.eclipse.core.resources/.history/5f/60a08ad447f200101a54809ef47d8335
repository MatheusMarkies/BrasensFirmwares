// --- COMANDOS DO ST25DV ---
#define ST25DV_CMD_FAST_READ_MSG    0xAAU
#define ST25DV_MFG_CODE             0x02U

int32_t BSP_NFC0XCOMM_SendRecv(const uint8_t *pTxData, uint8_t *pRxData, uint16_t Length)
{
    HAL_StatusTypeDef status = HAL_OK;

    // Se o SPI não estiver pronto, retorna erro
    if (HAL_SPI_GetState(&hspi1) != HAL_SPI_STATE_READY)
    {
        return -1;
    }

    // Caso 1: Envio e Recepção simultâneos (Full Duplex)
    if (pTxData != NULL && pRxData != NULL)
    {
        status = HAL_SPI_TransmitReceive(&hspi1, (uint8_t*)pTxData, pRxData, Length, 1000);
    }
    // Caso 2: Apenas Envio (Ignora leitura)
    else if (pTxData != NULL)
    {
        status = HAL_SPI_Transmit(&hspi1, (uint8_t*)pTxData, Length, 1000);
    }
    // Caso 3: Apenas Leitura (Envia dummy bytes para gerar clock)
    else if (pRxData != NULL)
    {
        status = HAL_SPI_Receive(&hspi1, pRxData, Length, 1000);
    }

    return (status == HAL_OK) ? 0 : -1;
}

/*
 * Função Principal: Lê a Mailbox usando a API correta do RFAL NFC-V
 */
void Demo_Read_ST25DV_Mailbox(uint8_t *uid) {
    ReturnCode err;
    uint8_t rxBuf[260]; // Buffer para receber dados + status
    uint16_t rcvLen;    // Tamanho recebido em BYTES (a func converte internamente)
    char msgUart[100];

    // 1. Configurar Parâmetros
    // Flags: Data Rate (High) + Address Mode (pois vamos falar com uma tag específica via UID)
    uint8_t flags = RFAL_NFCV_REQ_FLAG_DATA_RATE | RFAL_NFCV_REQ_FLAG_ADDRESS;

    // Comando: 0xAA (Fast Read Message)
    uint8_t cmd = ST25DV_CMD_FAST_READ_MSG;

    // Param: No ISO15693 Custom, o primeiro byte após o cmd é o Cód Fabricante.
    // A função rfalNfcvPollerTransceiveReq usa o argumento 'param' para isso.
    uint8_t mfgCode = ST25DV_MFG_CODE;

    // Payload (Dados do comando): [Pointer] [Length]
    // Pointer = 0x00, Length = 255 (Ler 256 bytes)
    uint8_t payload[2] = { 0x00, 255 };

    // 2. Enviar comando via RFAL
    // Assinatura: (cmd, flags, param, uid, *data, dataLen, *rxBuf, rxBufLen, *rcvLen)
    err = rfalNfcvPollerTransceiveReq(
            cmd,                    // 0xAA
            flags,                  // 0x22 (High Rate + Addressed)
            mfgCode,                // 0x02 (ST Mfg Code - entra como 'param')
            uid,                    // Ponteiro para o UID da tag detectada
            payload,                // Ponteiro para [0x00, 0xFF]
            sizeof(payload),        // Tamanho do payload (2 bytes)
            rxBuf,                  // Buffer de recepção
            sizeof(rxBuf),          // Tamanho máximo do buffer
            &rcvLen                 // Variável para receber o tamanho lido
    );

    // 3. Processar Resposta
    if (err == ERR_NONE) {
        // Verifica byte de status (o primeiro byte da resposta deve ser 0x00 = Sucesso)
        if (rcvLen > 1 && rxBuf[0] == 0x00) {

            // Dados reais começam no índice 1. Tamanho real é rcvLen - 1.
            uint16_t dadosReaisLen = rcvLen - 1;

            sprintf(msgUart, "SUCESSO! Lidos: %d bytes\r\n", dadosReaisLen);
            HAL_UART_Transmit(&huart2, (uint8_t*)msgUart, strlen(msgUart), 100);

            // Imprime os primeiros 20 bytes para conferência
            for(int i=1; i <= dadosReaisLen && i <= 20; i++) {
                sprintf(msgUart, "%02X ", rxBuf[i]);
                HAL_UART_Transmit(&huart2, (uint8_t*)msgUart, strlen(msgUart), 100);
            }
            HAL_UART_Transmit(&huart2, (uint8_t*)"\r\n", 2, 100);

        } else {
            // Erro retornado pela TAG (Ex: 0x01 = Comando não suportado, ou erro customizado)
            sprintf(msgUart, "Erro Tag (Status): %02X\r\n", rxBuf[0]);
            HAL_UART_Transmit(&huart2, (uint8_t*)msgUart, strlen(msgUart), 100);
        }
    } else {
        // Erro de comunicação (Timeout, CRC, Colisão, etc)
        // Se err == ERR_TIMEOUT, pode ser que a Mailbox esteja vazia ou desabilitada
        // e a tag não respondeu nada.
        sprintf(msgUart, "Erro RFAL: %d\r\n", err);
        HAL_UART_Transmit(&huart2, (uint8_t*)msgUart, strlen(msgUart), 100);
    }
}
