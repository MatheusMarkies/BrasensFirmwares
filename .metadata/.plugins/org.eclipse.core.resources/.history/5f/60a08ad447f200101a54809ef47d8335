/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init(&hspi1);
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */

  ReturnCode err;
    uint8_t devCnt = 0;
    rfalNfcvListenDevice nfcvDevList[1]; // Lista para guardar 1 tag encontrada

    // Inicializa a stack RFAL (se não estiver no MX_X_CUBE_NFC12_Init)
    rfalInitialize();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  // Máquina de estados do RFAL
	        rfalWorker();

	        // Detecção de Tags
	        // CORREÇÃO 1: Usar RFAL_COMPLIANCE_MODE_ISO em vez de _ISO15693 (nome padrão da lib)
	        err = rfalNfcvPollerCollisionResolution(RFAL_COMPLIANCE_MODE_ISO, 1, nfcvDevList, &devCnt);

	        if ((err == ERR_NONE) && (devCnt > 0))
	        {
	            HAL_GPIO_TogglePin(LED1_GPIO_Port, LED1_Pin); // Pisca LED indicando detecção

	            // Pega o UID da tag encontrada
	            uint8_t *uid = nfcvDevList[0].InvRes.UID;

	            // Chama nossa função de leitura
	            Demo_Read_ST25DV_Mailbox(uid);

	            // CORREÇÃO 2: rfalNfcvPollerSleep exige Flags e UID
	            // Flags = 0 (Default), UID = Ponteiro para o UID da tag
	            rfalNfcvPollerSleep(0, uid);

	            HAL_Delay(500); // Delay para não inundar a UART
	        }
	        // Pequeno delay para não travar a CPU se nada for encontrado (opcional)
	        // HAL_Delay(10);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

