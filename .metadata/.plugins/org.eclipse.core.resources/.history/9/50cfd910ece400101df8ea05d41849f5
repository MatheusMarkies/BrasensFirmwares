int16_t ADS1115_Read(void) {
    uint8_t config[3];
    uint8_t data[2];
    int16_t raw_val;

    config[0] = ADS_REG_CONF;
    config[1] = 0xC5;
    config[2] = 0x83;

    if (HAL_I2C_Master_Transmit(&hi2c1, ADS1115_ADDR, config, 3, 100) != HAL_OK) return -1;

    HAL_Delay(10);

    uint8_t reg_ptr = ADS_REG_CONV;
    HAL_I2C_Master_Transmit(&hi2c1, ADS1115_ADDR, &reg_ptr, 1, 100);

    if (HAL_I2C_Master_Receive(&hi2c1, ADS1115_ADDR, data, 2, 100) == HAL_OK) {
        raw_val = (int16_t)((data[0] << 8) | data[1]);
        if (raw_val < 0) raw_val = 0;
        return raw_val;
    }
    return -1;
}


void Realizar_Tara(void) {
    int32_t soma = 0;
    int leituras_validas = 0;

    for(int i=0; i<10; i++) {
        int16_t val = ADS1115_Read();
        if(val != -1) {
            soma += val;
            leituras_validas++;
        }
        HAL_Delay(20);
    }

    if(leituras_validas > 0) {
        tara_offset = soma / leituras_validas;
    } else {

    }
}
