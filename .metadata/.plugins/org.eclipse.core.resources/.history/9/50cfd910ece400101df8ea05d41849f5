#define R_GAUGE_NOMINAL    350.0f  // Resistência nominal do Strain Gauge (Ohms)
#define R_FIXED_RESISTOR   360.0f  // Resistores fixos da meia-ponte (Ohms)
#define GAUGE_FACTOR       2.0f    // Sensibilidade do sensor (GF)
#define V_EXCITACTION      2.0f    // Tensão de alimentação da ponte (Volts) - Via TPS63900

// --- Amplificação (INA333) ---
#define RG_RESISTOR        422.0f  // Resistor de Ganho instalado (Ohms). Ex: 422.0 ou 430.0
#define INA_GAIN_CONST     100000.0f // Constante interna do INA333 (100k)

// --- Digitalização (ADS1115) ---
#define ADS_FSR_VOLTAGE    2.048f  // Fundo de escala configurado no PGA (Volts)
#define ADS_BIT_RESOLUTION 32768.0f // 15 bits (Single-ended positivo ou Diferencial assinado)

// 1. Ganho Real do Amplificador: G = 1 + (100k / Rg)
#define AMP_GAIN  (1.0f + (INA_GAIN_CONST / RG_RESISTOR))

// 2. Fator de Desbalanceamento da Ponte (Topo VCC, Base GND)
// Fator = (R_fix * R_gauge) / (R_fix + R_gauge)^2
#define BRIDGE_RATIO_TERM  ((R_FIXED_RESISTOR * R_GAUGE_NOMINAL) / ((R_FIXED_RESISTOR + R_GAUGE_NOMINAL) * (R_FIXED_RESISTOR + R_GAUGE_NOMINAL)))

// 3. Volts por Strain (Unitário) na saída da ponte (Half-Bridge: x2 senrsores)
// V_out = V_exc * 2 * Fator * GF * strain
#define VOLTS_PER_STRAIN   (V_EXCITACTION * 2.0f * BRIDGE_RATIO_TERM * GAUGE_FACTOR)

// 4. Resolução do ADC (Volts por Bit)
#define LSB_SIZE_VOLTS     (ADS_FSR_VOLTAGE / ADS_BIT_RESOLUTION)

// 5. FATOR FINAL DE CONVERSÃO (Bits -> Micro-Strain)
// uStrain = (Delta_Bits * LSB) / (Gain * VoltsPerStrain) * 1.000.000
#define K_FACTOR_USTRAIN   ((LSB_SIZE_VOLTS / (AMP_GAIN * VOLTS_PER_STRAIN)) * 1000000.0f)

