#ifndef INC_ST25R300_H_
#define INC_ST25R300_H_

// ST25R300 Register Map Definitions
// Based on ST25R300 Datasheet DS14655 Rev 2

// ============================================================================
// OPERATION AND CONFIGURATION REGISTERS
// ============================================================================

// Operation mode control register (RW, PD)
#define ST25R300_REG_OPERATION                      0x00

// General configuration settings (RW, PD)
#define ST25R300_REG_GENERAL_CONFIG                 0x01

// VDD_DR voltage regulator configuration (RW, PD)
#define ST25R300_REG_VDD_DR_CONFIG                  0x02

// TX driver output resistance configuration (RW, PD)
#define ST25R300_REG_TX_DRIVER_CONFIG               0x03

// TX modulation settings - AM index and mode (RW, PD)
#define ST25R300_REG_TX_MODULATION_1                0x04

// TX modulation settings - resistive modulation (RW, PD)
#define ST25R300_REG_TX_MODULATION_2                0x05

// Card emulation modulation - driver resistance (RW, PD)
#define ST25R300_REG_CE_MODULATION_1                0x06

// Card emulation modulation - GPIO/TAD control (RW, PD)
#define ST25R300_REG_CE_MODULATION_2                0x07

// GPIO pin control for antenna tuning (RW, PD)
#define ST25R300_REG_GPIO_CONTROL                   0x08

// Receiver analog settings - gain and HPF (RW, PD)
#define ST25R300_REG_RX_ANALOG_1                    0x09

// Receiver analog settings - gain reduction RW/WU (RW, PD)
#define ST25R300_REG_RX_ANALOG_2                    0x0A

// Receiver analog settings - gain CE and thresholds (RW, PD)
#define ST25R300_REG_RX_ANALOG_3                    0x0B

// Receiver analog settings - phase and rectifier (RW, RD)
#define ST25R300_REG_RX_ANALOG_4                    0x0C

// Receiver digital settings - AGC and IIR filters (RW, RD)
#define ST25R300_REG_RX_DIGITAL_1                   0x0D

// Correlator settings - IIR coefficients (RW, RD)
#define ST25R300_REG_CORRELATOR_1                   0x0E

// Correlator settings - AGC thresholds (RW, RD)
#define ST25R300_REG_CORRELATOR_2                   0x0F

// Correlator settings - subcarrier detection (RW, RD)
#define ST25R300_REG_CORRELATOR_3                   0x10

// Correlator settings - collision and data levels (RW, RD)
#define ST25R300_REG_CORRELATOR_4                   0x11

// Correlator settings - noise measurement control (RW, RD)
#define ST25R300_REG_CORRELATOR_5                   0x12

// Correlator settings - initial noise level (RW, RD)
#define ST25R300_REG_CORRELATOR_6                   0x13

// ============================================================================
// PROTOCOL CONFIGURATION REGISTERS
// ============================================================================

// Protocol selection and bit rates (RW, RD)
#define ST25R300_REG_PROTOCOL_1                     0x14

// TX protocol settings - parity, CRC, pulse width (RW, RD)
#define ST25R300_REG_TX_PROTOCOL_1                  0x15

// TX protocol settings - SOF/EOF timing (RW, RD)
#define ST25R300_REG_TX_PROTOCOL_2                  0x16

// RX protocol settings - SOF/EOF, parity, CRC (RW, RD)
#define ST25R300_REG_RX_PROTOCOL_1                  0x17

// RX protocol settings - TR1 minimum length (RW, RD)
#define ST25R300_REG_RX_PROTOCOL_2                  0x18

// RX protocol settings - TR1 maximum length (RW, RD)
#define ST25R300_REG_RX_PROTOCOL_3                  0x19

// ============================================================================
// EMD (EXTERNAL MODULATION DETECTION) REGISTERS
// ============================================================================

// EMD configuration - threshold and enable (RW, RD)
#define ST25R300_REG_EMD_CONFIG_1                   0x1A

// EMD configuration - additional settings (RW, RD)
#define ST25R300_REG_EMD_CONFIG_2                   0x1B

// ============================================================================
// CARD EMULATION CONFIGURATION REGISTERS
// ============================================================================

// CE automatic response configuration (RW, PD)
#define ST25R300_REG_CE_CONFIG_1                    0x1C

// CE FDT compensation and NFCID length (RW, PD)
#define ST25R300_REG_CE_CONFIG_2                    0x1D

// CE pseudo random number for TSN (RW, PD)
#define ST25R300_REG_CE_CONFIG_3                    0x1E

// ============================================================================
// TIMER CONFIGURATION REGISTERS
// ============================================================================

// Mask receive timer - squelch and step (RW, PD)
#define ST25R300_REG_MRT_CONFIG_1                   0x1F

// Mask receive timer - timeout value (RW, PD)
#define ST25R300_REG_MRT_CONFIG_2                   0x20

// Squelch timer configuration (RW, RD)
#define ST25R300_REG_SQUELCH_TIMER                  0x21

// NRT and GPT configuration - trigger source (RW, RD)
#define ST25R300_REG_NRT_GPT_CONFIG_1               0x22

// No-response timer MSB (RW, RD)
#define ST25R300_REG_NRT_CONFIG_MSB                 0x23

// No-response timer LSB (RW, RD)
#define ST25R300_REG_NRT_CONFIG_LSB                 0x24

// General purpose timer MSB (RW, RD)
#define ST25R300_REG_GPT_CONFIG_MSB                 0x25

// General purpose timer LSB (RW, RD)
#define ST25R300_REG_GPT_CONFIG_LSB                 0x26

// ============================================================================
// WAKE-UP MODE CONFIGURATION REGISTERS
// ============================================================================

// Wake-up timer period and WPT sampling (RW, PD)
#define ST25R300_REG_WU_CONTROL_1                   0x27

// Wake-up timer calibration settings (RW, PD)
#define ST25R300_REG_WU_CONTROL_2                   0x28

// Wake-up measurement timing configuration (RW, PD)
#define ST25R300_REG_WU_CONTROL_3                   0x29

// I-channel wake-up configuration (RW, PD)
#define ST25R300_REG_I_CHANNEL_CONFIG               0x2A

// I-channel difference threshold (RW, PD)
#define ST25R300_REG_I_CHANNEL_DIFF                 0x2B

// I-channel calibration result (RO, PD)
#define ST25R300_REG_I_CHANNEL_CAL                  0x2C

// I-channel ADC measurement display (RO, PD)
#define ST25R300_REG_I_CHANNEL_ADC                  0x2D

// I-channel reference value (RO/RW, PD)
#define ST25R300_REG_I_CHANNEL_REF                  0x2E

// Q-channel wake-up configuration (RW, PD)
#define ST25R300_REG_Q_CHANNEL_CONFIG               0x2F

// Q-channel difference threshold (RW, PD)
#define ST25R300_REG_Q_CHANNEL_DIFF                 0x30

// Q-channel calibration result (RO, PD)
#define ST25R300_REG_Q_CHANNEL_CAL                  0x31

// Q-channel ADC measurement display (RO, PD)
#define ST25R300_REG_Q_CHANNEL_ADC                  0x32

// Q-channel reference value (RO/RW, PD)
#define ST25R300_REG_Q_CHANNEL_REF                  0x33

// ============================================================================
// TX/RX FRAME AND FIFO REGISTERS
// ============================================================================

// TX frame configuration - byte count MSB (RW, RD)
#define ST25R300_REG_TX_FRAME_CONFIG_1              0x34

// TX frame configuration - byte count LSB and bit count (RW, RD)
#define ST25R300_REG_TX_FRAME_CONFIG_2              0x35

// FIFO status - byte count and flags (RO, RD)
#define ST25R300_REG_FIFO_STATUS_1                  0x36

// FIFO status - overflow/underflow and last byte info (RO, RD)
#define ST25R300_REG_FIFO_STATUS_2                  0x37

// RX collision position display (RO, RD)
#define ST25R300_REG_RX_COLLISION                   0x38

// ============================================================================
// INTERRUPT MASK REGISTERS
// ============================================================================

// IRQ mask register 1 - TX/RX interrupts (RW, RD)
#define ST25R300_REG_IRQ_MASK_1                     0x39

// IRQ mask register 2 - timer and CE interrupts (RW, RD)
#define ST25R300_REG_IRQ_MASK_2                     0x3A

// IRQ mask register 3 - wake-up and field interrupts (RW, RD)
#define ST25R300_REG_IRQ_MASK_3                     0x3B

// ============================================================================
// INTERRUPT STATUS REGISTERS
// ============================================================================

// IRQ status register 1 - TX/RX interrupts (RO, RD)
#define ST25R300_REG_IRQ_STATUS_1                   0x3C

// IRQ status register 2 - timer and CE interrupts (RO, PD/RD)
#define ST25R300_REG_IRQ_STATUS_2                   0x3D

// IRQ status register 3 - wake-up and field interrupts (RO, PD)
#define ST25R300_REG_IRQ_STATUS_3                   0x3E

// ============================================================================
// IDENTITY AND STATUS REGISTERS
// ============================================================================

// IC type and revision identification (RO, PD)
#define ST25R300_REG_IC_IDENTITY                    0x3F

// Status register 1 - oscillator and field detector (RO, PD)
#define ST25R300_REG_STATUS_1                       0x40

// Status register 2 - timer and activity status (RO, RD)
#define ST25R300_REG_STATUS_2                       0x41

// Static status register 1 - field and command status (RO, PD)
#define ST25R300_REG_STATIC_STATUS_1                0x42

// Static status register 2 - RX error and event flags (RO, RD)
#define ST25R300_REG_STATIC_STATUS_2                0x43

// Static status register 3 - CRC and framing errors (RO, RD)
#define ST25R300_REG_STATIC_STATUS_3                0x44

// Card emulation status - state machine and bit rate (RO/RW, RD)
#define ST25R300_REG_CE_STATUS_1                    0x45

// Card emulation status - RATS parameter (RO, RD)
#define ST25R300_REG_CE_STATUS_2                    0x46

// Wake-up status - I/Q channel flags (RO, PD)
#define ST25R300_REG_WU_STATUS                      0x47

// ============================================================================
// DISPLAY REGISTERS
// ============================================================================

// Analog display - regulator current limit and control (RO, PD)
#define ST25R300_REG_ANALOG_DISPLAY_1               0x48

// Analog display - AFE gain reduction (RO, RD)
#define ST25R300_REG_ANALOG_DISPLAY_2               0x49

// RSSI I-channel measurement (RO, RD)
#define ST25R300_REG_RSSI_I                         0x4A

// RSSI Q-channel measurement (RO, RD)
#define ST25R300_REG_RSSI_Q                         0x4B

// Sense RF measurement result (RO, PD)
#define ST25R300_REG_SENSE_RF                       0x4C

// ============================================================================
// ACTIVE WAVE SHAPING (AWS) REGISTERS
// ============================================================================

// AWS configuration - sink and protection control (RW, RD)
#define ST25R300_REG_AWS_CONFIG_1                   0x4D

// AWS configuration - AM filter time constants (RW, RD)
#define ST25R300_REG_AWS_CONFIG_2                   0x4E

// AWS timing - tentx1 and tdres1 (RW, RD)
#define ST25R300_REG_AWS_TIMING_1                   0x4F

// AWS timing - passive sink and sink offset 1 (RW, RD)
#define ST25R300_REG_AWS_TIMING_2                   0x50

// AWS timing - tilim2 and tdres2 (RW, RD)
#define ST25R300_REG_AWS_TIMING_3                   0x51

// AWS timing - passive sink and sink offset 2 (RW, RD)
#define ST25R300_REG_AWS_TIMING_4                   0x52

// Overshoot protection bit pattern (RW, RD)
#define ST25R300_REG_OVERSHOOT_PROT                 0x53

// Undershoot protection bit pattern (RW, RD)
#define ST25R300_REG_UNDERSHOOT_PROT                0x54

// ============================================================================
// EXTERNAL FIELD DETECTOR REGISTER
// ============================================================================

// External field detector activation/deactivation thresholds (RW, PD)
#define ST25R300_REG_EFD                            0x57

// ============================================================================
// SPECIAL ACCESS ADDRESSES
// ============================================================================

// Card emulation memory access (58 bytes)
#define ST25R300_ADDR_CE_MEMORY                     0x58

// FIFO buffer access (256 bytes)
#define ST25R300_ADDR_FIFO                          0x5F

// Test register access (requires direct command first)
#define ST25R300_ADDR_TEST_ACCESS                   0xFC

// Timeouts
#define ST25R300_SPI_TIMEOUT                        100  // ms
#define ST25R300_RESET_DELAY                        2    // ms

typedef struct ST25R300_setting{

	GPIO_TypeDef*		CS_port;
	uint16_t		CS_pin;
	GPIO_TypeDef*		reset_port;
	uint16_t		reset_pin;
	GPIO_TypeDef*		IRQ_port;
	uint16_t		IRQ_pin;
	SPI_HandleTypeDef*	hSPIx;

} ST25R300;

//------ ST25 STATUS ------//
#define ST25_OK				200
#define ST25_NOT_FOUND			404

#endif /* INC_ST25R300_H_ */
