ST25R300_StatusTypeDef ST25R300_EnableNFCField(ST25R300_HandleTypeDef *hst25r) {
    ST25R300_StatusTypeDef status;
    uint8_t irq1, irq2, irq3;

    LOG("Enabling NFC Field...\r\n");

    // 1. Enter Ready Mode
    status = ST25R300_WriteRegister(hst25r, ST25R300_REG_OPERATION, ST25R300_OP_EN);
    if (status != ST25R300_OK) return status;

    // 2. Wait for oscillator
    status = ST25R300_WaitOscillator(hst25r, 100);
    if (status != ST25R300_OK) {
        LOG("  Error: Oscillator timeout\r\n");
        return status;
    }
    LOG("  ✓ Oscillator ready\r\n");

    // 3. Enable VDD_DR regulator
    status = ST25R300_ModifyRegister(hst25r, ST25R300_REG_OPERATION,
                                     ST25R300_OP_VDDDR_EN, ST25R300_OP_VDDDR_EN);
    if (status != ST25R300_OK) return status;
    HAL_Delay(1); // Wait minimum 10us

    // 4. Enable TX and RX
    status = ST25R300_ModifyRegister(hst25r, ST25R300_REG_OPERATION,
                                     ST25R300_OP_TX_EN | ST25R300_OP_RX_EN,
                                     ST25R300_OP_TX_EN | ST25R300_OP_RX_EN);
    if (status != ST25R300_OK) return status;
    LOG("  ✓ TX/RX enabled\r\n");

    // 5. Execute adjust regulator command
    status = ST25R300_SendCommand(hst25r, ST25R300_CMD_ADJUST_REG);
    if (status != ST25R300_OK) return status;

    // 6. Wait for command completion
    HAL_Delay(10);

    // Check for I_dct interrupt
    ST25R300_ReadIRQ(hst25r, &irq1, &irq2, &irq3);
    if (irq3 & ST25R300_IRQ3_DCT) {
        LOG("  ✓ Regulator adjusted\r\n");
    }

    // 7. Execute NFC field on command (with collision avoidance)
    status = ST25R300_SendCommand(hst25r, ST25R300_CMD_NFC_FIELD_ON);
    if (status != ST25R300_OK) return status;

    // Wait for field on completion
    HAL_Delay(10);

    ST25R300_ReadIRQ(hst25r, &irq1, &irq2, &irq3);
    if (irq3 & ST25R300_IRQ3_DCT) {
        LOG("  ✓ NFC field active!\r\n");
        return ST25R300_OK;
    }

    return ST25R300_ERROR;
}

/**
  * @brief  Configure ST25R300 for ISO14443-A operation
  * @param  hst25r: Pointer to ST25R300 handle
  * @param  bitrate: 0=106kbps, 1=212kbps, 2=424kbps, 3=848kbps
  * @retval ST25R300 status
  */
ST25R300_StatusTypeDef ST25R300_ConfigureISO14443A(ST25R300_HandleTypeDef *hst25r, uint8_t bitrate) {
    ST25R300_StatusTypeDef status;
    uint8_t protocol_reg;

    LOG("Configuring ISO14443-A at ");
    switch(bitrate) {
        case 0: LOG("106 kbps\r\n"); break;
        case 1: LOG("212 kbps\r\n"); break;
        case 2: LOG("424 kbps\r\n"); break;
        case 3: LOG("848 kbps\r\n"); break;
        default: return ST25R300_ERROR;
    }

    // Protocol Register 1 (0x14):
    // Bits 7:6 = rx_rate
    // Bits 5:4 = tx_rate
    // Bits 3:0 = om (operation mode)
    // om = 0x1 for ISO14443-A/NFC-A

    protocol_reg = ((bitrate & 0x03) << 6) |  // RX rate
                   ((bitrate & 0x03) << 4) |  // TX rate
                   0x01;                       // ISO14443-A mode

    status = ST25R300_WriteRegister(hst25r, 0x14, protocol_reg);
    if (status != ST25R300_OK) return status;

    // Configure TX Protocol Register 1 (0x15)
    // Enable parity and CRC generation
    status = ST25R300_WriteRegister(hst25r, 0x15, 0x60); // a_tx_par=1, tx_crc=1
    if (status != ST25R300_OK) return status;

    // Configure RX Protocol Register 1 (0x17)
    // Enable parity and CRC checking
    status = ST25R300_WriteRegister(hst25r, 0x17, 0x2C); // a_rx_par=1, rx_crc=1
    if (status != ST25R300_OK) return status;

    LOG("  ✓ ISO14443-A configured\r\n");
    return ST25R300_OK;
}

/**
  * @brief  Send ISO14443-A REQA command
  * @param  hst25r: Pointer to ST25R300 handle
  * @param  atqa: Pointer to store ATQA response (2 bytes)
  * @retval ST25R300 status
  */
ST25R300_StatusTypeDef ST25R300_SendREQA(ST25R300_HandleTypeDef *hst25r, uint8_t *atqa) {
    ST25R300_StatusTypeDef status;
    uint8_t reqa_cmd = 0x26; // REQA command
    uint8_t irq1, irq2, irq3;
    uint16_t fifo_len;
    uint32_t timeout;

    LOG("Sending REQA...\r\n");

    // Clear FIFO
    status = ST25R300_SendCommand(hst25r, ST25R300_CMD_CLEAR_FIFO);
    if (status != ST25R300_OK) return status;

    // Configure for short frame (7 bits for REQA)
    // Tx Frame Config Register 2 (0x35): nbtx = 7
    status = ST25R300_WriteRegister(hst25r, 0x35, 0x07);
    if (status != ST25R300_OK) return status;

    // Write REQA to FIFO
    status = ST25R300_WriteFIFO(hst25r, &reqa_cmd, 1);
    if (status != ST25R300_OK) return status;

    // Clear interrupts
    ST25R300_ClearIRQ(hst25r);

    // Configure No-Response Timer (NRT)
    // Set timeout for tag response (~5ms)
    uint8_t nrt_config[3] = {0x00, 0x00, 0x00}; // Will be configured based on standard
    status = ST25R300_WriteRegisters(hst25r, 0x22, nrt_config, 3);
    if (status != ST25R300_OK) return status;

    // Send transmit command
    status = ST25R300_SendCommand(hst25r, ST25R300_CMD_TX_DATA);
    if (status != ST25R300_OK) return status;

    // Wait for transmission end (I_txe)
    timeout = HAL_GetTick();
    while ((HAL_GetTick() - timeout) < 100) {
        ST25R300_ReadIRQ(hst25r, &irq1, &irq2, &irq3);
        if (irq1 & ST25R300_IRQ1_TXE) {
            LOG("  ✓ Transmission complete\r\n");
            break;
        }
        HAL_Delay(1);
    }

    // Wait for reception (I_rxe) or no-response (I_nre)
    timeout = HAL_GetTick();
    while ((HAL_GetTick() - timeout) < 100) {
        ST25R300_ReadIRQ(hst25r, &irq1, &irq2, &irq3);

        if (irq1 & ST25R300_IRQ1_RXE) {
            LOG("  ✓ Response received\r\n");

            // Read ATQA from FIFO
            status = ST25R300_GetFIFOLength(hst25r, &fifo_len);
            if (status != ST25R300_OK) return status;

            if (fifo_len >= 2) {
                status = ST25R300_ReadFIFO(hst25r, atqa, 2);
                LOG("  ATQA: 0x%02X 0x%02X\r\n", atqa[0], atqa[1]);
                return status;
            }
            return ST25R300_ERROR;
        }

        if (irq2 & 0x40) { // I_nre (no response)
            LOG("  No tag detected\r\n");
            return ST25R300_ERROR;
        }

        HAL_Delay(1);
    }

    LOG("  Timeout waiting for response\r\n");
    return ST25R300_TIMEOUT;
}

/**
  * @brief  Configure wake-up mode for low-power card detection
  * @param  hst25r: Pointer to ST25R300 handle
  * @param  period_ms: Wake-up period in milliseconds
  * @retval ST25R300 status
  */
ST25R300_StatusTypeDef ST25R300_ConfigureWakeUp(ST25R300_HandleTypeDef *hst25r, uint16_t period_ms) {
    ST25R300_StatusTypeDef status;
    uint8_t wut_config;

    LOG("Configuring Wake-Up mode (%d ms period)...\r\n", period_ms);

    // Map period to WUT configuration (Register 0x27, bits 7:4)
    // See Table 62 in datasheet
    if (period_ms <= 12) wut_config = 0x00;
    else if (period_ms <= 25) wut_config = 0x10;
    else if (period_ms <= 50) wut_config = 0x20;
    else if (period_ms <= 75) wut_config = 0x30;
    else if (period_ms <= 100) wut_config = 0x40;
    else if (period_ms <= 125) wut_config = 0x50;
    else if (period_ms <= 150) wut_config = 0x60;
    else if (period_ms <= 200) wut_config = 0x70;
    else if (period_ms <= 250) wut_config = 0x80;
    else if (period_ms <= 300) wut_config = 0x90;
    else if (period_ms <= 350) wut_config = 0xA0;
    else if (period_ms <= 400) wut_config = 0xB0;
    else if (period_ms <= 500) wut_config = 0xC0;
    else if (period_ms <= 800) wut_config = 0xD0;
    else wut_config = 0xE0; // 1000 ms

    // Write wake-up control register
    status = ST25R300_WriteRegister(hst25r, 0x27, wut_config);
    if (status != ST25R300_OK) return status;

    // Configure I-channel detection (Register 0x2A)
    // Enable all detection ranges (bits 2:0)
    status = ST25R300_WriteRegister(hst25r, 0x2A, 0x07);
    if (status != ST25R300_OK) return status;

    // Set I-channel difference threshold (Register 0x2B)
    status = ST25R300_WriteRegister(hst25r, 0x2B, 0x0A); // Default threshold
    if (status != ST25R300_OK) return status;

    // Configure Q-channel similarly
    status = ST25R300_WriteRegister(hst25r, 0x2F, 0x07);
    if (status != ST25R300_OK) return status;

    status = ST25R300_WriteRegister(hst25r, 0x30, 0x0A);
    if (status != ST25R300_OK) return status;

    // Enable auto-averaging (Register 0x29, bit 3)
    status = ST25R300_WriteRegister(hst25r, 0x29, 0x08);
    if (status != ST25R300_OK) return status;

    // Enable wake-up mode
    status = ST25R300_WriteRegister(hst25r, ST25R300_REG_OPERATION, ST25R300_OP_WU_EN);
    if (status != ST25R300_OK) return status;

    LOG("  ✓ Wake-Up mode enabled\r\n");
    return ST25R300_OK;
}

/**
  * @brief  Monitor wake-up events
  * @param  hst25r: Pointer to ST25R300 handle
  * @retval true if card detected, false otherwise
  */
bool ST25R300_CheckWakeUpEvent(ST25R300_HandleTypeDef *hst25r) {
    uint8_t irq1, irq2, irq3;

    // Check if IRQ pin is active
    if (!ST25R300_GetIRQPin(hst25r)) {
        return false;
    }

    // Read interrupt status
    ST25R300_ReadIRQ(hst25r, &irq1, &irq2, &irq3);

    // Check wake-up interrupts
    if (irq3 & (ST25R300_IRQ3_WUI | ST25R300_IRQ3_WUQ)) {
        LOG("Wake-Up event detected!\r\n");

        // Read I/Q ADC values to see what changed
        uint8_t i_adc, q_adc;
        ST25R300_ReadRegister(hst25r, 0x2D, &i_adc); // I-channel ADC
        ST25R300_ReadRegister(hst25r, 0x32, &q_adc); // Q-channel ADC

        LOG("  I: %d, Q: %d\r\n", (int8_t)i_adc, (int8_t)q_adc);

        return true;
    }

    return false;
}

/**
  * @brief  Read current consumption for diagnostics
  * @param  hst25r: Pointer to ST25R300 handle
  * @param  current_mA: Pointer to store current in mA
  * @retval ST25R300 status
  */
ST25R300_StatusTypeDef ST25R300_MeasureCurrent(ST25R300_HandleTypeDef *hst25r, float *current_mA) {
    ST25R300_StatusTypeDef status;
    uint8_t cmd_sequence[52];
    uint8_t fifo_data[208]; // 4 bytes per measurement
    uint16_t raw_value;

    LOG("Measuring VDD_DR current...\r\n");

    // Enter ready mode and enable receiver
    status = ST25R300_WriteRegister(hst25r, ST25R300_REG_OPERATION,
                                     ST25R300_OP_EN | ST25R300_OP_RX_EN);
    if (status != ST25R300_OK) return status;

    HAL_Delay(10);

    // Clear FIFO and CE memory
    ST25R300_SendCommand(hst25r, ST25R300_CMD_CLEAR_FIFO);

    // Prepare diagnostic command (command 0x01 = I_VDD_DR)
    cmd_sequence[0] = 0x01; // Measure VDD_DR current
    cmd_sequence[1] = 0x00; // Terminator

    // Write command sequence to CE memory
    // (Implementation depends on CE memory access - see section 5.14.5)

    // Execute diagnostic measurement
    status = ST25R300_SendCommand(hst25r, 0xF8); // Trigger diagnostic
    if (status != ST25R300_OK) return status;

    HAL_Delay(50); // Wait for measurement

    // Read result from FIFO
    uint16_t fifo_len;
    ST25R300_GetFIFOLength(hst25r, &fifo_len);

    if (fifo_len >= 4) {
        ST25R300_ReadFIFO(hst25r, fifo_data, 4);

        // Parse result: [cmd, calib_MSB, calib_LSB, RFU]
        raw_value = (fifo_data[1] << 8) | fifo_data[2];

        // Convert to mA using conversion factor (3.2 mA per LSB)
        *current_mA = (raw_value & 0x1FF) * 3.2f;

        LOG("  Current: %.2f mA\r\n", *current_mA);
        return ST25R300_OK;
    }

    return ST25R300_ERROR;
}

/**
  * @brief  Complete example: Detect and read ISO14443-A card
  * @param  hst25r: Pointer to ST25R300 handle
  * @retval ST25R300 status
  */
ST25R300_StatusTypeDef ST25R300_DetectCard_Example(ST25R300_HandleTypeDef *hst25r) {
    ST25R300_StatusTypeDef status;
    uint8_t atqa[2];

    LOG("\r\n========================================\r\n");
    LOG("  ISO14443-A Card Detection Example\r\n");
    LOG("========================================\r\n\r\n");

    // Step 1: Configure for ISO14443-A at 106 kbps
    status = ST25R300_ConfigureISO14443A(hst25r, 0);
    if (status != ST25R300_OK) return status;

    // Step 2: Enable NFC field
    status = ST25R300_EnableNFCField(hst25r);
    if (status != ST25R300_OK) return status;

    // Step 3: Wait guard time (5ms for ISO14443)
    LOG("\nWaiting guard time...\r\n");
    HAL_Delay(5);

    // Step 4: Send REQA command
    status = ST25R300_SendREQA(hst25r, atqa);
    if (status == ST25R300_OK) {
        LOG("\n✓ Card detected successfully!\r\n");
        LOG("  ATQA: 0x%02X%02X\r\n", atqa[1], atqa[0]);

        // Could continue with anti-collision, SELECT, etc.
    } else {
        LOG("\nNo card detected\r\n");
    }

    return status;
}

/**
  * @brief  Example: Low-power card detection with wake-up mode
  * @param  hst25r: Pointer to ST25R300 handle
  * @retval None
  */
void ST25R300_LowPowerDetection_Example(ST25R300_HandleTypeDef *hst25r) {
    LOG("\r\n========================================\r\n");
    LOG("  Low-Power Card Detection Example\r\n");
    LOG("========================================\r\n\r\n");

    // Configure wake-up mode with 100ms period
    if (ST25R300_ConfigureWakeUp(hst25r, 100) != ST25R300_OK) {
        LOG("Failed to configure wake-up mode\r\n");
        return;
    }

    LOG("Entering low-power mode...\r\n");
    LOG("Bring a card close to trigger detection\r\n\r\n");

    // Main loop
    while (1) {
        // Check for wake-up event
        if (ST25R300_CheckWakeUpEvent(hst25r)) {
            // Card detected! Exit wake-up mode and perform full detection
            LOG("\nExiting wake-up mode for full detection...\r\n");

            // Disable wake-up mode
            ST25R300_WriteRegister(hst25r, ST25R300_REG_OPERATION, 0x00);

            // Perform normal card detection
            ST25R300_DetectCard_Example(hst25r);

            // Re-enter wake-up mode
            LOG("\nRe-entering wake-up mode...\r\n");
            ST25R300_ConfigureWakeUp(hst25r, 100);
        }

        // In real application, MCU could enter sleep mode here
        HAL_Delay(10);
    }
}
