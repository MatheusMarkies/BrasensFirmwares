void ST25_WriteReg(uint8_t reg, uint8_t value) {
    // Protocolo: Bit 7 = 0 (Write) | Bits 6-0 = Endereço
    uint8_t addr_byte = reg & 0x7F;

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET); // CS Low
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Transmit(&hspi2, &value, 1, 10);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);   // CS High
}

/**
 * @brief Lê um registrador do ST25R300
 * @param reg Endereço do registrador
 * @return Valor lido (byte)
 */
uint8_t ST25_ReadReg(uint8_t reg) {
    // Protocolo: Bit 7 = 1 (Read) | Bits 6-0 = Endereço
    uint8_t addr_byte = (reg & 0x7F) | 0x80;
    uint8_t rx_data = 0;

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET); // CS Low
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Receive(&hspi2, &rx_data, 1, 10);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);   // CS High

    return rx_data;
}

/**
 * @brief Envia um Comando Direto (Direct Command)
 * @param cmd Código do comando (ex: 0x60 para Set Default)
 */
void ST25_SendDirectCommand(uint8_t cmd) {
    // Comandos diretos são bytes únicos (0x60 a 0xFC)
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET); // CS Low
    HAL_SPI_Transmit(&hspi2, &cmd, 1, 10);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);   // CS High
}

/**
 * @brief Escreve múltiplos bytes no FIFO
 */
void ST25_WriteFIFO(uint8_t *pData, uint16_t size) {
    uint8_t addr_byte = REG_FIFO_DATA & 0x7F; // 0x5F (Write)

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Transmit(&hspi2, pData, size, 100);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);
}

/**
 * @brief Lê múltiplos bytes do FIFO
 */
void ST25_ReadFIFO(uint8_t *pDest, uint16_t size) {
    uint8_t addr_byte = (REG_FIFO_DATA & 0x7F) | 0x80; // 0xDF (Read 0x5F)

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Receive(&hspi2, pDest, size, 100);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);
}

void ST25_TestCommunication(void) {
    uint8_t reg_val;

    // 1. Resetar o Chip via Software para garantir estado inicial
    ST25_SendDirectCommand(CMD_SET_DEFAULT);
    HAL_Delay(10);

    // 2. Leitura de Identidade (IC Identity Register 0x3F)
    // O ST25R300 deve retornar 0xB0 ou similar (Type 0x16 << 3)
    reg_val = ST25_ReadReg(REG_IC_IDENTITY);
    sprintf(uart_buf, "[TEST] ID Lido: 0x%02X (Esperado: 0xB0-0xB7)\r\n", reg_val);
    HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, strlen(uart_buf), 100);

    // Verificação simples
    if ((reg_val & 0xF8) == 0xB0) { // Mascara a revisão
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] SPI OK! Chip Detectado.\r\n", 32, 100);
    } else {
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] FALHA SPI ou Chip Errado!\r\n", 34, 100);
        return;
    }

    // 3. Teste de Escrita e Leitura (Read/Write Verify)
    // Vamos usar o registrador General Configuration (0x01) para teste
    // Valor padrão é 0x00. Vamos escrever 0x55.

    uint8_t old_val = ST25_ReadReg(REG_GEN_CONFIG);
    ST25_WriteReg(REG_GEN_CONFIG, 0x55);
    uint8_t new_val = ST25_ReadReg(REG_GEN_CONFIG);

    // Restaurar valor original
    ST25_WriteReg(REG_GEN_CONFIG, old_val);

    sprintf(uart_buf, "[TEST] RW Teste: Escrito 0x55, Lido 0x%02X\r\n", new_val);
    HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, strlen(uart_buf), 100);

    if (new_val == 0x55) {
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] Integridade de Registros OK.\r\n", 37, 100);
    } else {
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] Erro de Escrita/Leitura!\r\n", 33, 100);
    }
}

void ST25R300_Init(void) {
    uint8_t reg_val;

    DEBUG_PRINT("\r\n--- INICIANDO ST25R300 (RFO1 / 27.12MHz) ---\r\n");

    // 1. HARDWARE RESET (Obrigatório)
    // O ST25R300 tem Reset ATIVO EM NÍVEL ALTO (High)
    HAL_GPIO_WritePin(GPIOB, SIG_Pin, GPIO_PIN_SET);   // Reset ON
    HAL_Delay(5);
    HAL_GPIO_WritePin(GPIOB, SIG_Pin, GPIO_PIN_RESET); // Reset OFF
    HAL_Delay(5); // Tempo de boot (t_boot típico 138us, max 900us)

    // 2. SOFT RESET & DEFAULT
    // Garante que registradores estão limpos
    ST25_SendDirectCommand(CMD_SET_DEFAULT);
    HAL_Delay(2);

    // 3. VERIFICAÇÃO DE ID (Sanity Check)
    // ST25R300 ID deve começar com '10110' (0x16 << 3 = 0xB0)
    reg_val = ST25_ReadReg(ST25_REG_IC_IDENTITY);
    if ((reg_val & 0xF8) != 0xB0) {
        sprintf(uart_buf, "[ERRO] Chip ID Invalido: 0x%02X\r\n", reg_val);
        DEBUG_PRINT(uart_buf);
        return; // Aborta se não achar o chip
    }
    DEBUG_PRINT("[OK] Chip Detectado.\r\n");

    // 4. HABILITAR OSCILADOR E REGULADORES
    // Reg 0x00 (Operation): Bit 3 (en) = 1, Bit 4 (vdddr_en) = 1
    // Isso liga o Cristal 27.12MHz e o regulador do driver
    ST25_WriteReg(ST25_REG_OP_CONTROL, 0x18);

    // Aguardar estabilização do Oscilador (Bit osc_ok no Status1)
    uint8_t timeout = 100;
    do {
        HAL_Delay(1);
        reg_val = ST25_ReadReg(ST25_REG_STATUS1);
        timeout--;
    } while (!(reg_val & 0x10) && timeout > 0); // Bit 4 = osc_ok

    if (timeout == 0) {
        DEBUG_PRINT("[ERRO] Oscilador 27.12MHz nao estabilizou!\r\n");
    } else {
        DEBUG_PRINT("[OK] Oscilador Estavel.\r\n");
    }

    // 5. CONFIGURAÇÃO DE ANTENA (RFO1 Single Ended)
    // Reg 0x01 (General Config):
    // Bit 5 (Single) = 1 (Single Ended)
    // Bit 4 (rfo2)   = 0 (Usa RFO1)
    ST25_WriteReg(ST25_REG_GEN_CONFIG, 0x20);

    // 6. POTÊNCIA MÁXIMA (Driver Resistance)
    // Reg 0x03 (Tx Driver): d_res = 0x0 (Mínima resistência ~1 Ohm -> Max Corrente)
    // Crucial para Energy Harvesting eficiente
    ST25_WriteReg(ST25_REG_TX_DRIVER, 0x00);

    // 7. CONFIGURAÇÃO DE PROTOCOLO (ISO15693 / NFC-V)
    // Reg 0x14 (Protocol): 0x01 (ISO15693)
    ST25_WriteReg(ST25_REG_PROTOCOL, 0x05);

    // 8. CONFIGURAÇÃO DE MODULAÇÃO (AM vs OOK) - CRÍTICO PARA HARVESTING
    // Se usarmos OOK (100%), o campo desliga nos bits '0', cortando energia do sensor.
    // Usaremos AM (Amplitude Modulation) com profundidade ~10-20%.

    // Reg 0x15 (Tx Protocol 1): Bit 4 (tr_am) = 1 (Habilita AM)
    ST25_WriteReg(ST25_REG_TX_PROTOCOL1, 0x10);

    // Reg 0x04 (Tx Mod 1): Bits 7:4 (am_mod) = 0x2 (Index ~10-14%)
    ST25_WriteReg(ST25_REG_TX_MOD1, 0x20);

    // 9. CALIBRAÇÃO INTERNA
    // Ajusta os reguladores internos e o oscilador RC para melhor performance
    ST25_SendDirectCommand(CMD_ADJUST_REGULATORS);
    HAL_Delay(1);
    ST25_SendDirectCommand(CMD_CALIBRATE_RC);
    HAL_Delay(1);

    DEBUG_PRINT("[OK] ST25R300 Inicializado: Single-Ended RFO1, ISO15693, AM Mod.\r\n");
}
void NFC_Debug_Loop(void) {
    uint8_t irq1, irq2, fifo_bytes;
    int timeout;

    // --- PASSO 1: LIGAR CAMPO (ENERGY HARVESTING) ---
    // Ativa TX e RX (0xE8 = tx_en | rx_en | vdddr_en)
    ST25_WriteReg(REG_OP_CONTROL, 0xE8);
    DEBUG_PRINT("[1] Campo RF: ON (Carga...)\r\n");

    // Tempo de carga (simulação)
    HAL_Delay(1500);

    // --- PASSO 2: PREPARAR TRANSMISSÃO ---
    // Limpa FIFO e flags de erro anteriores
    ST25_SendDirectCommand(CMD_CLEAR_FIFO);
    ST25_ReadReg(REG_IRQ_STATUS1); // Leitura limpa as flags

    // Enviar comando genérico "Inventory" (ISO15693)
    // Flags(0x02) | Cmd(0x26 - Inventory) | Mask(0x00)
    uint8_t cmd[] = {0x02, 0x26, 0x00};
    ST25_WriteFIFO(cmd, 3);

    // Configurar tamanho: 3 bytes (Bits 7-3 do Reg 0x35 ignorados para bytes completos)
    ST25_WriteReg(REG_TX_LEN_MSB, 0x00);
    ST25_WriteReg(REG_TX_LEN_LSB, 0x03);

    DEBUG_PRINT("[2] TX: Iniciando transmissao...\r\n");
    ST25_SendDirectCommand(CMD_TRANSMIT_W_CRC);

    // --- PASSO 3: AGUARDAR FIM DA TRANSMISSÃO (IRQ TXE) ---
    timeout = 20; // ~20ms timeout para TX
    while(timeout--) {
        irq1 = ST25_ReadReg(REG_IRQ_STATUS1);
        if(irq1 & 0x02) { // Bit 1: I_txe (Tx End)
            DEBUG_PRINT("[3] TX: Concluido (IRQ Txe)\r\n");
            break;
        }
        HAL_Delay(1);
    }
    if(timeout <= 0) DEBUG_PRINT("[ERRO] TX Timeout!\r\n");

    // --- PASSO 4: AGUARDAR RESPOSTA OU TIMEOUT (RXE / NRE) ---
    DEBUG_PRINT("[4] RX: Aguardando resposta...\r\n");

    timeout = 500; // ~50ms timeout para RX
    uint8_t rx_done = 0;

    while(timeout--) {
        irq1 = ST25_ReadReg(REG_IRQ_STATUS1);
        irq2 = ST25_ReadReg(REG_IRQ_STATUS2); // Checar No-Response Timer (NRE)

        // Verifica Bit 3 (I_rxe - Fim de RX) ou Bit 0 (I_rx_err - Erro RX) no REG1
        // Verifica Bit 6 (I_nre - No Response Timer) no REG2

        if(irq1 & 0x08) {
            DEBUG_PRINT("[STATUS] RX: Resposta Recebida (I_rxe)\r\n");
            rx_done = 1;
            break;
        }
        if(irq2 & 0x40) { // Bit 6 do IRQ Status 2
            DEBUG_PRINT("[STATUS] RX: Sem Tag (Timeout NRE)\r\n");
            break;
        }
        HAL_Delay(1);
    }

    // --- PASSO 5: VERIFICAR FIFO ---
    if (rx_done) {
        fifo_bytes = ST25_ReadReg(REG_FIFO_STATUS1);
        sprintf(debug_buf, "[5] FIFO: %d bytes recebidos\r\n", fifo_bytes);
        DEBUG_PRINT(debug_buf);

        // Se quiser ver os dados (Opcional)
        if(fifo_bytes > 0) {
            uint8_t rx_data[10];
            // Limitar leitura para não estourar buffer local
            uint8_t read_len = (fifo_bytes > 10) ? 10 : fifo_bytes;
            ST25_ReadFIFO(rx_data, read_len);

            DEBUG_PRINT("    Dados: ");
            for(int i=0; i<read_len; i++) {
                sprintf(debug_buf, "%02X ", rx_data[i]);
                DEBUG_PRINT(debug_buf);
            }
            DEBUG_PRINT("\r\n");
        }
    }

    // --- PASSO 6: DESLIGAR (Ciclo concluído) ---
    // Desliga TX para economizar ou reseta estado, mantendo oscilador (0x88)
    ST25_WriteReg(REG_OP_CONTROL, 0x88);
    DEBUG_PRINT("[6] Ciclo Fim. (Campo OFF)\r\n");
    DEBUG_PRINT("--------------------------------\r\n");
}

/* ===============================================================================
 * TESTE ESPECÍFICO: CARTÃO DE CRÉDITO (ISO14443-A)
 * =============================================================================== */
void NFC_Test_CreditCard_TypeA(void) {
    uint8_t irq1, fifo_bytes;
    uint8_t rx_data[10];
    int timeout;

    DEBUG_PRINT("\r\n--- TESTE CARTAO DE CREDITO (ISO14443-A) ---\r\n");

    // 1. RECONFIGURAR PARA NFC-A (ISO14443-A)
    // Reg 0x14 (Protocol): 0x00 = ISO14443-A
    ST25_WriteReg(ST25_REG_PROTOCOL, 0x00);

    // Reg 0x04 (Tx Mod): OOK 100% é o padrão do NFC-A, mas o ST25R300 geralmente
    // lida bem com AM se ajustado. Para garantir compatibilidade com cartões
    // que exigem campo zero (OOK), vamos mudar para OOK temporariamente.
    // Ou manter AM se quiser testar a robustez. Vamos tentar o padrão NFC-A:
    // Bits 7:4 (am_mod) irrelevante em OOK? Não, reg 0x15 define o tipo.

    // Reg 0x15 (Tx Protocol 1): Bit 4 (tr_am) = 0 (OOK - Padrão NFC-A)
    ST25_WriteReg(ST25_REG_TX_PROTOCOL1, 0x00);

    // Ligar Campo
    ST25_WriteReg(REG_OP_CONTROL, 0xE8);
    HAL_Delay(20); // Tempo para campo estabilizar e cartão ligar

    // 2. ENVIAR COMANDO "REQA" (Request A)
    // O comando REQA é 0x26, mas deve ser enviado como 7 BITS (Short Frame).

    ST25_SendDirectCommand(CMD_CLEAR_FIFO);
    ST25_ReadReg(REG_IRQ_STATUS_1); // Limpar IRQs

    // Escrever 0x26 no FIFO
    uint8_t cmd = 0x26;
    ST25_WriteFIFO(&cmd, 1);

    // Configurar tamanho: 0 Bytes completos + 7 Bits
    // Reg 0x35 (Tx Frame Config 2): Bits 2:0 definem bits quebrados
    ST25_WriteReg(REG_TX_LEN_MSB, 0x00);
    ST25_WriteReg(REG_TX_LEN_LSB, 0x07); // 7 bits

    // Transmitir SEM CRC (REQA não usa CRC)
    // O comando Transmit (0x6A) usa a config do Reg 0x15.
    // Em NFC-A, o bit tx_crc (Reg 0x15, bit 5) deve ser desativado para REQA?
    // O ST25R300 gerencia isso ou desabilitamos manual.
    // Vamos desabilitar CRC no TX temporariamente.
    uint8_t tx_prot_old = ST25_ReadReg(ST25_REG_TX_PROTOCOL1);
    ST25_WriteReg(ST25_REG_TX_PROTOCOL1, tx_prot_old & ~0x20); // Bit 5 = 0 (No CRC)

    ST25_SendDirectCommand(CMD_TRANSMIT); // 0x6A

    // 3. AGUARDAR RESPOSTA (ATQA)
    timeout = 10; // Resposta de cartão é muito rápida (<5ms)
    uint8_t detected = 0;

    while(timeout--) {
        irq1 = ST25_ReadReg(REG_IRQ_STATUS_1);
        if(irq1 & 0x08) { // I_rxe (Fim de RX)
            detected = 1;
            break;
        }
        if(irq1 & 0x02 && !(irq1 & 0x08)) {
            // Tx terminou, aguardando Rx...
        }
        HAL_Delay(1);
    }

    // Restaurar CRC para o futuro (boa prática)
    ST25_WriteReg(ST25_REG_TX_PROTOCOL1, tx_prot_old);

    // 4. ANALISAR RESULTADO
    if (detected) {
        fifo_bytes = ST25_ReadReg(REG_FIFO_STATUS_1);
        if (fifo_bytes == 2) { // ATQA são sempre 2 bytes (ex: 04 00)
            ST25_ReadFIFO(rx_data, 2);
            sprintf(uart_buf, "[SUCESSO] Cartao Detectado! ATQA: %02X %02X\r\n", rx_data[0], rx_data[1]);
            DEBUG_PRINT(uart_buf);
        } else {
            sprintf(uart_buf, "[AVISO] Resposta estranha (Len: %d)\r\n", fifo_bytes);
            DEBUG_PRINT(uart_buf);
        }
    } else {
        DEBUG_PRINT("[FALHA] Nenhum cartao encontrado (Timeout ou NRE)\r\n");
    }

    // 5. VOLTAR PARA CONFIGURAÇÃO ORIGINAL (ISO15693 / Energy Harvesting)
    // Isso é vital para não quebrar a leitura do sensor depois
    ST25_WriteReg(ST25_REG_PROTOCOL, 0x05); // Volta para ISO15693
    ST25_WriteReg(ST25_REG_TX_PROTOCOL1, 0x10); // Volta para AM
    ST25_WriteReg(REG_TX_LEN_LSB, 0x00); // Zera bits quebrados
    DEBUG_PRINT("--- Fim do Teste ---\r\n");
}
