// --- Funções Auxiliares SPI ---
void ST25_WriteReg(uint8_t reg, uint8_t value) {
    uint8_t data[2] = { (reg & 0x3F), value }; // Bit 7=0 (Write), Bit 6=0 (Reg) [cite: 2564]
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, data, 2, 100);
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_SET);
}

uint8_t ST25_ReadReg(uint8_t reg) {
    uint8_t tx_data = (reg & 0x3F) | 0x40; // Bit 7=0 (Write Addr), Bit 6=1 (Read Mode pattern) [cite: 2564]
    uint8_t rx_data = 0;
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, &tx_data, 1, 100);
    HAL_SPI_Receive(&hspi2, &rx_data, 1, 100);
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_SET);
    return rx_data;
}

void ST25_DirectCmd(uint8_t cmd) {
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, &cmd, 1, 100);
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_SET);
}

// --- Inicialização para Potência Máxima ---
void ST25R300_Init_HighPower(void) {
    // 1. Reset Pulse
    HAL_GPIO_WritePin(RESET_GPIO_Port, RESET_Pin, GPIO_PIN_SET);
    HAL_Delay(1);
    HAL_GPIO_WritePin(RESET_GPIO_Port, RESET_Pin, GPIO_PIN_RESET);
    HAL_Delay(5);

    // 2. Configurar Modo Single-Ended (Hardware RFO1)
    // Bit 5 = 1 (Single), Bit 4 = 0 (RFO1) -> 0x20
    ST25_WriteReg(ST25_REG_GEN_CONFIG, 0x20);

    // 3. Ativar Oscilador e Reguladores
    // Bit 7(en)=1, Bit 4(vdddr)=1 -> 0x88 (Inicial, sem TX ainda) [cite: 3005]
    ST25_WriteReg(ST25_REG_OP_CONTROL, 0x88);
    HAL_Delay(10); // Estabilizar cristal 27.12MHz

    // 4. Configurar Protocolo ISO15693 (NFC-V)
    ST25_WriteReg(ST25_REG_PROTOCOL, 0x05); //

    // 5. Ajustar Drivers para Max Power (Min Resistance)
    // d_res = 0 (1 Ohm typ) [cite: 3036]
    ST25_WriteReg(ST25_REG_TX_DRIVER, 0x00);

    // 6. Modulação Suave (AM 10-20%) para Energy Harvesting
    // Evita cortes abruptos de energia. am_mod = 0x2 ou 0x3.
    ST25_WriteReg(ST25_REG_TX_MOD1, 0x20); // 10-14% modulation [cite: 3046]

    // 7. Calibrar Reguladores Internos
    ST25_DirectCmd(CMD_ADJUST_REGULATORS);
    HAL_Delay(1);
    ST25_DirectCmd(CMD_CALIBRATE_RC);
    HAL_Delay(1);
}

// --- Loop Principal ---
void NFC_Harvest_And_Read(void) {
    uint8_t rx_buf[10];

    // A. Fase de Carga (Energy Harvesting)
    // Ligar TX e RX. Bit 6(tx_en)=1, Bit 5(rx_en)=1 -> 0xE8 [cite: 3005]
    ST25_WriteReg(ST25_REG_OP_CONTROL, 0xE8);

    // TEMPO DE CARGA: Ajuste conforme o capacitor do sensor (ex: 47uF -> ~200-500ms)
    HAL_Delay(300);

    // B. Fase de Leitura (Sem desligar o campo!)
    // Limpar FIFO e IRQs antes de transmitir
    ST25_DirectCmd(CMD_CLEAR_FIFO);
    ST25_WriteReg(ST25_REG_IRQ_STATUS1, 0xFF); // Limpar flags escrevendo 1

    // Montar Frame ISO15693 "Read Single Block"
    // Flags(0x02 - High Data Rate) | Cmd(0x20 - Read Block) | Block(0x00)
    uint8_t cmd[] = {0x02, 0x20, 0x00};

    // Escrever no FIFO (Endereço 0x5F não incrementa, mas SPI burst funciona)
    // Para simplificar, mandamos byte a byte ou usamos HAL_SPI_Transmit para 0x5F
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_RESET);
    uint8_t fifo_hdr = 0x5F; // 0 (Write) + 5F (FIFO) -> 0001 1111? Nao, address map table 5.
    // Tabela 5[cite: 2569]: FIFO Write Pattern = 1011 1111 (0xBF)
    fifo_hdr = 0xBF;
    HAL_SPI_Transmit(&hspi2, &fifo_hdr, 1, 10);
    HAL_SPI_Transmit(&hspi2, cmd, 3, 10);
    HAL_GPIO_WritePin(ST25_CS_GPIO_Port, ST25_CS_Pin, GPIO_PIN_SET);

    // Configurar tamanho da transmissão (Bytes) [cite: 3377]
    ST25_WriteReg(0x34, 0x00); // MSB Length
    ST25_WriteReg(0x35, 0x03); // LSB Length = 3 bytes

    // Enviar com CRC e Paridade [cite: 2775]
    ST25_DirectCmd(CMD_TRANSMIT_W_CRC);

    // Esperar Resposta (Polling no IRQ Status)
    // Timeout de ~20ms (ISO15693 é lento)
    for(int i=0; i<50; i++) {
        uint8_t irq = ST25_ReadReg(ST25_REG_IRQ_STATUS1);
        if(irq & 0x08) { // Bit 3: I_rxe (End of Receive) [cite: 3429]
            // Ler FIFO
            uint8_t len = ST25_ReadReg(ST25_REG_FIFO_STATUS1);
            if(len > 0) {
               // Ler dados do FIFO...
               // Converter 4 bytes para float (seu valor de strain gauge)
            }
            break;
        }
        HAL_Delay(1);
    }
}

void System_Diagnostics(void) {
    uint8_t val;

    LOG("\r\n=== INICIANDO DIAGNOSTICO DO SISTEMA ===\r\n");

    // 1. Teste de Comunicação SPI e Identificação do Chip
    LOG("[1] Teste SPI e ID do Chip... ");
    val = ST25_ReadReg(ST25_REG_IC_IDENTITY);

    // O ST25R300 tem IC Type '10110' (0x16) nos bits 7:3
    // Esperado: (0x16 << 3) + Rev. Ex: 0xB0 a 0xB7.
    if ((val & 0xF8) == 0xB0) {
        LOG("OK (ID: 0x%02X)\r\n", val);
    } else {
        LOG("FALHA! (Lido: 0x%02X - Verifique conexoes SPI/Power)\r\n", val);
        Error_Handler(); // Trava se não encontrar o chip
    }

    // 2. Inicialização Básica para Teste
    ST25R300_Init_HighPower(); // Chama sua função de init criada antes
    LOG("[2] Inicializacao dos Registradores... OK\r\n");

    // 3. Verificação do Oscilador (Cristal 27.12 MHz)
    LOG("[3] Verificando Oscilador... ");
    HAL_Delay(10); // Tempo para estabilizar
    val = ST25_ReadReg(ST25_REG_STATUS1);

    // Bit 4: osc_ok
    if (val & 0x10) {
        LOG("ESTAVEL (27.12 MHz travado)\r\n");
    } else {
        LOG("INSTAVEL! (Bit osc_ok=0. Verifique cristal Y2 e capacitores)\r\n");
    }

    // 4. Teste de Ruído Ambiental (Antena)
    // Lê RSSI com o campo desligado para ver se há interferência externa
    LOG("[4] Nivel de Ruido (Campo OFF)... ");
    // Garante que TX está OFF para medir apenas ruído
    ST25_WriteReg(ST25_REG_OP_CONTROL, 0x20); // Apenas RX enabled, TX off
    HAL_Delay(5);
    val = ST25_ReadReg(ST25_REG_RSSI1); // Lê RSSI display register 1
    LOG("RSSI: %d (Menor e melhor. >20 indica ruido alto)\r\n", val);

    // 5. Teste de Carga da Antena e Reguladores
    LOG("[5] Teste de Potencia (Campo ON)... ");
    // Liga TX em potência configurada
    ST25_WriteReg(ST25_REG_OP_CONTROL, 0xE8); // TX e RX on
    HAL_Delay(10);

    // Verifica se o regulador está limitando corrente (Antena em curto ou dessintonizada)
    val = ST25_ReadReg(ST25_REG_ANALOG_DISPLAY1);
    // Bit 7: ilim (Current Limit)
    if (val & 0x80) {
        LOG("ALERTA: Limitacao de Corrente Ativa! (Verifique Antena/Matching)\r\n");
    } else {
        LOG("OK (Corrente nominal)\r\n");
    }

    LOG("=== DIAGNOSTICO CONCLUIDO ===\r\n\r\n");
}
