/* Etapa cara — roda uma vez na vida, e só com o armazenamento cheio */
static bool NFC_Provision(void) {
	if (ST25DV_Init(&st25_driver) != 0)
		return false;
	if (ST25DV_I2C_PresentPassword(&st25_driver) != 0)
		return false;
	if (!ST25DV_I2C_IsSessionOpen(&st25_driver))
		return false;

	ST25DV_EH_Enable_Static(&st25_driver); /* EH_MODE = 0: colhe sozinho no campo */

	uint8_t gpo_cfg = 0xA0; /* GPO_EN | RF_GET_MSG_EN */
	platform_i2c_write(0x57, 0x0000, &gpo_cfg, 1);

	ST25DV_MB_Enable_Static(&st25_driver); /* MB_MODE = 1 */
	/* MB_WDG = 0 no registrador de sistema 0x000E: retenção infinita */

	uint8_t gpo_rd = 0;
	platform_i2c_read(0x57, 0x0000, &gpo_rd, 1);
	DEBUG_PRINT("GPO estatico=0x%02X (esperado 0xA0)\r\n", gpo_rd);

	uint8_t gpo_dyn_rd = 0;
	platform_i2c_read(0x53, 0x2000, &gpo_dyn_rd, 1);
	DEBUG_PRINT("GPO_Dyn=0x%02X (esperado 0xA0)\r\n", gpo_dyn_rd);

	uint8_t mb_wdg = 0x00;                       /* retencao infinita */
	platform_i2c_write(0x57, 0x000E, &mb_wdg, 1);

	prov_mark_done();
	return true;
}

/* Etapa barata — uma escrita, sem senha, sem sessão */
static bool NFC_Arm(void) {
	return (ST25DV_MB_Enable_Dyn(&st25_driver) == 0);
}

/* Converte int32_t para string (ASCII) de forma leve */
void LongToStr(int32_t num, char *str) {
	int i = 0;
	uint8_t isNegative = 0;

	// Caso especial para 0
	if (num == 0) {
		str[0] = '0';
		str[1] = '\0';
		return;
	}

	// Lida com números negativos
	if (num < 0) {
		isNegative = 1;
		num = -num; // Torna positivo para processamento
	}

	// Extrai dígitos (gera a string invertida)
	while (num != 0) {
		str[i++] = (num % 10) + '0';
		num /= 10;
	}

	// Adiciona o sinal se necessário
	if (isNegative) {
		str[i++] = '-';
	}

	str[i] = '\0'; // Finaliza string

	// Inverte a string para a ordem correta
	for (int j = 0; j < i / 2; j++) {
		char temp = str[j];
		str[j] = str[i - 1 - j];
		str[i - 1 - j] = temp;
	}
}

int16_t ADS1115_Read(void) {
	uint8_t config[3];
	uint8_t data[2];
	int16_t raw_val;

	config[0] = ADS_REG_CONF;
	// --- CONFIGURAÇÃO DO MSB (Byte mais significativo) ---
	// Bit 15 (OS): 1 (Start Single Conversion)
	// Bits 14-12 (MUX): 100 -> AIN0 vs GND (Single-Ended) <--- CORRETO PARA SEU CIRCUITO
	// Bits 11-9 (PGA): 010 -> +/- 2.048V (Cobre seu range de 0 a 2V)
	// Bit 8 (MODE): 1 (Single-Shot)
	// Binário: 1100 0101 = 0xC5
	config[1] = 0xC5;

	// --- CONFIGURAÇÃO DO LSB (Byte menos significativo) ---
	// Bits 7-5 (DR): 100 -> 128 SPS (Padrão)
	// Bits 4-0 (COMP): Padrão (Disable comparator)
	// Binário: 1000 0011 = 0x83
	config[2] = 0x83;

	if (HAL_I2C_Master_Transmit(&hi2c1, ADS1115_ADDR, config, 3, 100) != HAL_OK)
		return -1;

	HAL_Delay(10);

	uint8_t reg_ptr = ADS_REG_CONV;
	HAL_I2C_Master_Transmit(&hi2c1, ADS1115_ADDR, &reg_ptr, 1, 100);

	if (HAL_I2C_Master_Receive(&hi2c1, ADS1115_ADDR, data, 2, 100) == HAL_OK) {
		raw_val = (int16_t) ((data[0] << 8) | data[1]);
		return raw_val;
	}
	return -1;
}

int32_t offset = 0;
int32_t sum = 0;
int16_t count = 0;

void TORQUIMETER_Taring() {
	HAL_Delay(15);

	sum = 0;
	count = 0;

	int16_t raw_adc = ADS1115_Read();

	sum += raw_adc;
	count++;

	if (count >= SAMPLES_FOR_TARING) {
		int32_t average = sum / count;
		int32_t delta_bits = average - offset;

		voltage_uV = delta_bits * LSB_UV;
		strain_uE = (delta_bits * USTRAIN_PER_BIT_x1000) / 1000;

		sum = 0;
		count = 0;

		offset = average;
		DEBUG_PRINT("TARING offset=%ld contagens\r\n", offset);

		state = CHARGING;
	} else
		HAL_Delay(READING_SAMPLING_INTERVAL_MS);
}

void TORQUIMETER_Measure() {
	HAL_Delay(15);

	sum = 0;
	count = 0;

	HAL_Delay(15);

	ST25DV_MB_Enable_Dyn(&st25_driver);

	uint8_t gpo_dyn = 0xA0;
	platform_i2c_write(0x53, 0x2000, &gpo_dyn, 1); /* GPO_Dyn */

	int16_t raw_adc = ADS1115_Read();

	sum += raw_adc;
	count++;

	if (count >= SAMPLES_FOR_READING) {
		int32_t average = sum / count;

		int32_t delta_bits = average - offset;

		// if (abs(delta_bits) > 0) { // Removido para atualizar mesmo se for 0
		voltage_uV = delta_bits * LSB_UV;
		strain_uE = (delta_bits * USTRAIN_PER_BIT_x1000) / 1000;

		sum = 0;
		count = 0;

		char nfc_buffer[12];
		memset(nfc_buffer, 0, sizeof(nfc_buffer)); // Preenche o buffer com terminadores nulos

		LongToStr(strain_uE, nfc_buffer);

		uint8_t eh_ctrl = 0;
		platform_i2c_read(0x53, 0x2002, &eh_ctrl, 1);
		DEBUG_PRINT("[%lu ms] EH_CTRL_Dyn: 0x%02X (VCC_ON = %d)\r\n",
				HAL_GetTick(), eh_ctrl, (eh_ctrl & 0x08) ? 1 : 0);

		int32_t mb_err = ST25DV_MB_WriteMessage(&st25_driver,
				(uint8_t*) nfc_buffer, 12);

		if (mb_err == 0) {
			uint8_t dbg_mb_ctrl = 0, dbg_rf_mngt = 0, dbg_i2c_sso = 0,
					dbg_it_sts = 0;

			// Lendo os registradores dinâmicos chave (Endereço E2=0 -> 0x53)
			platform_i2c_read(0x53, 0x2006, &dbg_mb_ctrl, 1); // MB_CTRL_Dyn
			platform_i2c_read(0x53, 0x2003, &dbg_rf_mngt, 1); // RF_MNGT_Dyn
			platform_i2c_read(0x53, 0x2004, &dbg_i2c_sso, 1); // I2C_SSO_Dyn
			platform_i2c_read(0x53, 0x2005, &dbg_it_sts, 1);  // IT_STS_Dyn

			DEBUG_PRINT(
					"[%lu ms] DEBUG DYN -> MB_CTRL: 0x%02X | RF_MNGT: 0x%02X | I2C_SSO: 0x%02X | IT_STS: 0x%02X\r\n",
					HAL_GetTick(), dbg_mb_ctrl, dbg_rf_mngt, dbg_i2c_sso,
					dbg_it_sts);

			uint8_t mb = 0, len = 0, eh = 0;
			platform_i2c_read(0x53, 0x2002, &eh, 1); /* EH_CTRL_Dyn: bit3 = VCC_ON */
			platform_i2c_read(0x53, 0x2006, &mb, 1); /* MB_CTRL_Dyn */
			platform_i2c_read(0x53, 0x2007, &len, 1); /* MB_LEN_Dyn  */
			DEBUG_PRINT("MB w=%ld CTRL=0x%02X LEN=%u VCC_ON=%d\r\n", mb_err, mb,
					len, (eh & 0x08) ? 1 : 0);

			sending_ticks = 0;
			state = SENDING;
		} else {
			DEBUG_PRINT("[%lu ms]  MB write FAIL (Err: %d)\r\n", HAL_GetTick(),
					(int ) mb_err);
			EH_Set(1);              /* <<< ADICIONAR: devolve a colheita */
			state = CHARGING;
		}
	} else
		HAL_Delay(READING_SAMPLING_INTERVAL_MS);
}

static bool mb_was_collected(void) {
	uint8_t mb = 0;

	// Voltando para o endereço correto (0x53) do barramento E2=0
	if (platform_i2c_read(0x53, 0x2006, &mb, 1) != 0) {
		return false;
	}

	// Retorna true se MB_EN=1 e HOST_PUT_MSG=0 (msg consumida)
	return ((mb & 0x01) != 0) && ((mb & 0x02) == 0);
}

