			Set_MSI_Range(MSI_RANGE_2MHZ);
			MEAS_ON(); /* os pull-ups de I2C estão no 2V_Measurement */
			LPD_LOW(); /* ST25DV acordado */
			HAL_Delay(15);
			peripherals_wake();

			DEBUG_PRINT("[%lu ms] -> Configurando ST25DV...\r\n",
					HAL_GetTick());

			if (NFC_Provision()) {
				isConfigured = 1;
				DEBUG_PRINT("CONFIG: OK\r\n");
			} else {
				DEBUG_PRINT("CONFIG: FALHA — tenta no proximo ciclo\r\n");
			}

			state = CHARGING; /* recarrega, deu certo ou não */
			break;
		case CHARGING:
			if (eh_disabled) {
				MEAS_ON();            /* pull-ups de I2C vivem no 2V */
				peripherals_wake();   /* <<< faltava */
				HAL_Delay(5);         /* <<< 1 ms nao da' tempo do trilho subir */
				EH_Set(1);
				eh_disabled = 0;
			}

			MEAS_OFF();               /* <<< INCONDICIONAL. Este e' o bug. */
			LPD_HIGH();

			if (state == CHARGING)    /* a ISR pode ter mudado durante o I2C */
				enter_stop_mode(0);
			break;

		case TARING:
			Set_MSI_Range(MSI_RANGE_2MHZ);
			MEAS_ON();
			LPD_LOW();
			peripherals_wake();

			DEBUG_PRINT("[%lu ms] -> Executando tara...\r\n", HAL_GetTick());
			TORQUIMETER_Taring(); /* já põe state = CHARGING */
			DEBUG_PRINT("\r\n");
			isTared = 1;
			break;

		case READING: {
			if (!isConfigured) { state = CONFIG; break; }
			if (!isTared)      { state = TARING; break; }

			Set_MSI_Range(MSI_RANGE_2MHZ);
			MEAS_ON();
			LPD_LOW();
			peripherals_wake();

			uint8_t eh0 = 0;
			platform_i2c_read(0x53, 0x2002, &eh0, 1);
			DEBUG_PRINT("EH antes do Set(0): 0x%02X\r\n", eh0);

			EH_Set(0);
			eh_disabled = 1;

			TORQUIMETER_Measure();
			break;
		}

		case SENDING: {
			uint8_t done = 0;

			MEAS_ON();            /* pull-ups do I2C vivem no 2V_Measurement */
			peripherals_wake();
			HAL_Delay(5);

			if (gpo_event) {
				uint8_t it = 0;
				platform_i2c_read(0x53, 0x2005, &it, 1); /* ler LIMPA o IT_STS */
				gpo_event = 0;
				DEBUG_PRINT("[%lu ms] GPO! IT_STS=0x%02X\r\n", HAL_GetTick(), it);
				if (it & 0x40)     /* bit6 = RF_GET_MSG  (NAO e' 0x04) */
					done = 1;
			}

			if (!done && mb_was_collected()) {
				DEBUG_PRINT("[%lu ms] coletado (polling MB_CTRL)\r\n",
						HAL_GetTick());
				done = 1;
			}

			if (done || sending_ticks >= SENDING_TIMEOUT_WAKEUPS) {
				if (!done)
					DEBUG_PRINT("[%lu ms] SENDING timeout (%u ticks)\r\n",
							HAL_GetTick(), sending_ticks);
				EH_Set(1);         /* colheita volta em TODA saida */
				sending_ticks = 0;
				gpo_event = 0;
				MEAS_OFF();
				state = CHARGING;
				break;
			}

			MEAS_OFF();            /* desliga INA333 + ADS1115 + OPA333 */
			enter_stop_mode(1);    /* ST25DV vivo; acorda no RTC ou no GPO */
			break;
		}
		default:
			state = CHARGING;
			break;
		}
		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */
	}
	/* USER CODE END 3 */
}

