static uint8_t prov_is_done(void) {
	return (*(volatile uint32_t*) PROV_ADDR) == PROV_MAGIC;
}

static void prov_mark_done(void) {
	HAL_FLASHEx_DATAEEPROM_Unlock();
	HAL_FLASHEx_DATAEEPROM_Program(FLASH_TYPEPROGRAMDATA_WORD, PROV_ADDR,
	PROV_MAGIC);
	HAL_FLASHEx_DATAEEPROM_Lock();
}

