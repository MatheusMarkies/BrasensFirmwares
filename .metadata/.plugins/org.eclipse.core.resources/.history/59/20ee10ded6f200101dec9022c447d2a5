/**
 * @file st25dv_mailbox.h
 * @brief ST25DV MailBox e Energy Harvesting via ST25R300 Reader
 * @author System Developer
 * @date 2026-01-15
 *
 * Implementa comunicação com ST25DV via NFC-V:
 * - Leitura/escrita de MailBox
 * - Detecção de Energy Harvesting
 * - Fast Transfer Mode (FTM)
 * - GPO interrupts
 */

#ifndef ST25DV_MAILBOX_H
#define ST25DV_MAILBOX_H

#include "st25r300_hal.h"

/* ============================================================================
 * COMANDOS ISO15693 (NFC-V)
 * Baseados na especificação ISO/IEC 15693
 * ============================================================================ */

// Flags ISO15693
#define ISO15693_FLAG_SUBCARRIER        (1 << 0)  // 0=single, 1=dual
#define ISO15693_FLAG_DATARATE          (1 << 1)  // 0=low, 1=high
#define ISO15693_FLAG_INVENTORY         (1 << 2)
#define ISO15693_FLAG_PROTOCOL_EXT      (1 << 3)
#define ISO15693_FLAG_SELECT            (1 << 4)
#define ISO15693_FLAG_ADDRESS           (1 << 5)
#define ISO15693_FLAG_OPTION            (1 << 6)
#define ISO15693_FLAG_RFU               (1 << 7)

// Comandos obrigatórios
#define ISO15693_CMD_INVENTORY          0x01
#define ISO15693_CMD_STAY_QUIET         0x02

// Comandos opcionais
#define ISO15693_CMD_READ_SINGLE_BLOCK  0x20
#define ISO15693_CMD_WRITE_SINGLE_BLOCK 0x21
#define ISO15693_CMD_LOCK_BLOCK         0x22
#define ISO15693_CMD_READ_MULTIPLE_BLOCKS 0x23
#define ISO15693_CMD_WRITE_MULTIPLE_BLOCKS 0x24
#define ISO15693_CMD_SELECT             0x25
#define ISO15693_CMD_RESET_TO_READY     0x26
#define ISO15693_CMD_WRITE_AFI          0x27
#define ISO15693_CMD_LOCK_AFI           0x28
#define ISO15693_CMD_WRITE_DSFID        0x29
#define ISO15693_CMD_LOCK_DSFID         0x2A
#define ISO15693_CMD_GET_SYSTEM_INFO    0x2B
#define ISO15693_CMD_GET_MULTIPLE_BLOCK_SEC 0x2C

// Comandos customizados ST25DV (Manufacturer Specific)
#define ST25DV_CMD_READ_CONFIG          0xA0
#define ST25DV_CMD_WRITE_CONFIG         0xA1
#define ST25DV_CMD_READ_DYN_CONFIG      0xAD
#define ST25DV_CMD_WRITE_DYN_CONFIG     0xAE
#define ST25DV_CMD_PRESENT_PASSWORD     0xB3
#define ST25DV_CMD_WRITE_KILL           0xA6
#define ST25DV_CMD_KILL                 0xA7
#define ST25DV_CMD_FAST_READ_SINGLE_BLOCK 0xC0
#define ST25DV_CMD_FAST_WRITE_SINGLE_BLOCK 0xC1
#define ST25DV_CMD_FAST_READ_MULTIPLE_BLOCKS 0xC3
#define ST25DV_CMD_FAST_WRITE_MULTIPLE_BLOCKS 0xC4
#define ST25DV_CMD_FAST_READ_DYN_CONFIG 0xCD
#define ST25DV_CMD_FAST_WRITE_DYN_CONFIG 0xCE

// Manufacturer Code ST
#define ISO15693_MANUF_ST               0x02

/* ============================================================================
 * ST25DV ENDEREÇOS DE MEMÓRIA
 * ============================================================================ */

// Área de memória do usuário (varia conforme modelo)
#define ST25DV_USER_MEMORY_START        0x0000
#define ST25DV04K_USER_MEMORY_SIZE      512     // 4Kbit = 512 bytes
#define ST25DV16K_USER_MEMORY_SIZE      2048    // 16Kbit
#define ST25DV64K_USER_MEMORY_SIZE      8192    // 64Kbit

// MailBox (256 bytes) - Fast Transfer Mode
#define ST25DV_MAILBOX_SIZE             256
#define ST25DV_MAILBOX_BLOCK_START      0x0100  // Bloco 256
#define ST25DV_MAILBOX_BLOCK_END        0x01FF  // Bloco 511

// Registradores dinâmicos
#define ST25DV_DYN_GPO_CTRL_ADDR        0x2000
#define ST25DV_DYN_EH_CTRL_ADDR         0x2002
#define ST25DV_DYN_RF_MNGT_ADDR         0x2003
#define ST25DV_DYN_I2C_SSO_ADDR         0x2004
#define ST25DV_DYN_IT_STS_ADDR          0x2005
#define ST25DV_DYN_MB_CTRL_ADDR         0x2006
#define ST25DV_DYN_MB_LEN_ADDR          0x2007

// Registradores de configuração
#define ST25DV_CFG_GPO_ADDR             0x0000
#define ST25DV_CFG_IT_TIME_ADDR         0x0001
#define ST25DV_CFG_EH_MODE_ADDR         0x0002
#define ST25DV_CFG_RF_MNGT_ADDR         0x0003
#define ST25DV_CFG_AREA1_ADDR           0x0004
#define ST25DV_CFG_AREA2_ADDR           0x0008
#define ST25DV_CFG_AREA3_ADDR           0x000C
#define ST25DV_CFG_AREA4_ADDR           0x0010
#define ST25DV_CFG_MB_MODE_ADDR         0x000D
#define ST25DV_CFG_MB_WDG_ADDR          0x000E
#define ST25DV_CFG_LOCK_CFG_ADDR        0x0F00

/* ============================================================================
 * BITS DE CONFIGURAÇÃO ST25DV
 * ============================================================================ */

// GPO Control (Dynamic)
#define ST25DV_GPO_ENABLE               (1 << 7)
#define ST25DV_GPO_RF_USER_EN           (1 << 6)
#define ST25DV_GPO_RF_ACTIVITY_EN       (1 << 5)
#define ST25DV_GPO_RF_INTERRUPT_EN      (1 << 4)
#define ST25DV_GPO_FIELD_CHANGE_EN      (1 << 3)
#define ST25DV_GPO_RF_PUT_MSG_EN        (1 << 2)
#define ST25DV_GPO_RF_GET_MSG_EN        (1 << 1)
#define ST25DV_GPO_RF_WRITE_EN          (1 << 0)

// EH Control (Dynamic)
#define ST25DV_EH_MODE_ENABLE           (1 << 0)
#define ST25DV_EH_ON_DEMAND             (1 << 1)

// MailBox Control (Dynamic)
#define ST25DV_MB_MODE                  (1 << 0)  // 0=disabled, 1=enabled
#define ST25DV_MB_HOST_PUT_MSG          (1 << 1)
#define ST25DV_MB_RF_PUT_MSG            (1 << 2)
#define ST25DV_MB_HOST_MISS_MSG         (1 << 3)
#define ST25DV_MB_RF_MISS_MSG           (1 << 4)
#define ST25DV_MB_HOST_CURRENT_MSG      (1 << 5)
#define ST25DV_MB_RF_CURRENT_MSG        (1 << 6)

// RF Management
#define ST25DV_RF_DISABLE               (1 << 0)
#define ST25DV_RF_SLEEP                 (1 << 1)

/* ============================================================================
 * ESTRUTURAS DE DADOS
 * ============================================================================ */

/**
 * @brief Configuração do ST25DV
 */
typedef struct {
    uint8_t uid[8];                 // UID do tag (8 bytes)
    uint16_t memory_size;           // Tamanho da memória em bytes
    uint8_t block_size;             // Tamanho do bloco (4 bytes típico)
    bool mailbox_enabled;           // MailBox habilitado
    bool eh_enabled;                // Energy Harvesting habilitado
    bool gpo_enabled;               // GPO habilitado
} ST25DV_Config;

/**
 * @brief Status da MailBox
 */
typedef struct {
    bool host_put_msg;              // Host colocou mensagem
    bool rf_put_msg;                // RF colocou mensagem
    bool host_miss_msg;             // Host perdeu mensagem
    bool rf_miss_msg;               // RF perdeu mensagem
    bool host_current_msg;          // Mensagem disponível para host
    bool rf_current_msg;            // Mensagem disponível para RF
    uint8_t message_length;         // Tamanho da mensagem
} ST25DV_MailBox_Status;

/**
 * @brief Handle do ST25DV
 */
typedef struct {
    ST25R300_Handle *reader;        // Handle do reader ST25R300
    ST25DV_Config config;           // Configuração do tag
    bool tag_detected;              // Tag detectado
    uint32_t last_comm_time;        // Timestamp da última comunicação
} ST25DV_Handle;

/* ============================================================================
 * FUNÇÕES DE DETECÇÃO E IDENTIFICAÇÃO
 * ============================================================================ */

/**
 * @brief Detecta tag ST25DV via Inventory
 * @param dev Handle do ST25DV
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_DetectTag(ST25DV_Handle *dev);

/**
 * @brief Lê informações do sistema (Get System Info)
 * @param dev Handle do ST25DV
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_GetSystemInfo(ST25DV_Handle *dev);

/* ============================================================================
 * FUNÇÕES DE LEITURA/ESCRITA DE MEMÓRIA
 * ============================================================================ */

/**
 * @brief Lê bloco único
 * @param dev Handle do ST25DV
 * @param block_addr Endereço do bloco
 * @param data Buffer para dados (4 bytes)
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_ReadSingleBlock(ST25DV_Handle *dev,
                                         uint16_t block_addr,
                                         uint8_t *data);

/**
 * @brief Escreve bloco único
 * @param dev Handle do ST25DV
 * @param block_addr Endereço do bloco
 * @param data Dados a escrever (4 bytes)
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_WriteSingleBlock(ST25DV_Handle *dev,
                                          uint16_t block_addr,
                                          const uint8_t *data);

/**
 * @brief Lê múltiplos blocos
 * @param dev Handle do ST25DV
 * @param start_block Bloco inicial
 * @param num_blocks Número de blocos
 * @param data Buffer para dados
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_ReadMultipleBlocks(ST25DV_Handle *dev,
                                            uint16_t start_block,
                                            uint8_t num_blocks,
                                            uint8_t *data);

/* ============================================================================
 * FUNÇÕES DE MAILBOX
 * ============================================================================ */

/**
 * @brief Habilita MailBox
 * @param dev Handle do ST25DV
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_EnableMailBox(ST25DV_Handle *dev);

/**
 * @brief Lê status da MailBox
 * @param dev Handle do ST25DV
 * @param status Estrutura para armazenar status
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_GetMailBoxStatus(ST25DV_Handle *dev,
                                          ST25DV_MailBox_Status *status);

/**
 * @brief Lê mensagem da MailBox (via RF)
 * @param dev Handle do ST25DV
 * @param data Buffer para dados (max 256 bytes)
 * @param length Ponteiro para armazenar tamanho lido
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_ReadMailBox(ST25DV_Handle *dev,
                                     uint8_t *data,
                                     uint8_t *length);

/**
 * @brief Escreve mensagem na MailBox (via RF)
 * @param dev Handle do ST25DV
 * @param data Dados a escrever
 * @param length Tamanho dos dados (max 256 bytes)
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_WriteMailBox(ST25DV_Handle *dev,
                                      const uint8_t *data,
                                      uint8_t length);

/**
 * @brief Limpa flag de mensagem RF (após leitura)
 * @param dev Handle do ST25DV
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_ClearMailBoxFlag(ST25DV_Handle *dev);

/* ============================================================================
 * FUNÇÕES DE ENERGY HARVESTING
 * ============================================================================ */

/**
 * @brief Habilita Energy Harvesting
 * @param dev Handle do ST25DV
 * @param on_demand true=on-demand, false=sempre ativo
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_EnableEnergyHarvesting(ST25DV_Handle *dev,
                                                bool on_demand);

/**
 * @brief Desabilita Energy Harvesting
 * @param dev Handle do ST25DV
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_DisableEnergyHarvesting(ST25DV_Handle *dev);

/**
 * @brief Lê status do Energy Harvesting
 * @param dev Handle do ST25DV
 * @param enabled Ponteiro para flag de habilitação
 * @param on_demand Ponteiro para flag on-demand
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_GetEHStatus(ST25DV_Handle *dev,
                                     bool *enabled,
                                     bool *on_demand);

/* ============================================================================
 * FUNÇÕES DE CONFIGURAÇÃO DINÂMICA
 * ============================================================================ */

/**
 * @brief Lê registrador dinâmico
 * @param dev Handle do ST25DV
 * @param reg_addr Endereço do registrador
 * @param data Ponteiro para armazenar dado
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_ReadDynamicReg(ST25DV_Handle *dev,
                                        uint16_t reg_addr,
                                        uint8_t *data);

/**
 * @brief Escreve registrador dinâmico
 * @param dev Handle do ST25DV
 * @param reg_addr Endereço do registrador
 * @param data Dado a escrever
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_WriteDynamicReg(ST25DV_Handle *dev,
                                         uint16_t reg_addr,
                                         uint8_t data);

/**
 * @brief Configura GPO (General Purpose Output)
 * @param dev Handle do ST25DV
 * @param gpo_config Configuração do GPO (bits conforme definições)
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_ConfigureGPO(ST25DV_Handle *dev, uint8_t gpo_config);

/* ============================================================================
 * FUNÇÕES DE FAST TRANSFER MODE
 * ============================================================================ */

/**
 * @brief Leitura rápida de bloco único (FTM)
 * @param dev Handle do ST25DV
 * @param block_addr Endereço do bloco
 * @param data Buffer para dados (4 bytes)
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_FastReadSingleBlock(ST25DV_Handle *dev,
                                             uint16_t block_addr,
                                             uint8_t *data);

/**
 * @brief Escrita rápida de bloco único (FTM)
 * @param dev Handle do ST25DV
 * @param block_addr Endereço do bloco
 * @param data Dados a escrever (4 bytes)
 * @return HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25DV_FastWriteSingleBlock(ST25DV_Handle *dev,
                                              uint16_t block_addr,
                                              const uint8_t *data);

#endif /* ST25DV_MAILBOX_H */
