// SPI Operation Modes (Bit 7 - R/W)
#define ST25R300_SPI_WRITE                          0x00
#define ST25R300_SPI_READ                           0x80

// SPI Commands
#define ST25R300_CMD_MASK                           0x60

// Timeouts
#define ST25R300_SPI_TIMEOUT                        100  // ms
#define ST25R300_RESET_DELAY                        2    // ms

// ============================================================================
// PRIVATE FUNCTIONS - GPIO CONTROL
// ============================================================================

/**
 * @brief  Set Chip Select (CS/BSS) pin LOW - Enable SPI
 * @param  dev: Pointer to ST25R300 device structure
 * @retval None
 */
void ST25R300_CS_Low(ST25R300 *dev) {
    if (dev && dev->CS_port) {
        HAL_GPIO_WritePin(dev->CS_port, dev->CS_pin, GPIO_PIN_RESET);
    }
}

/**
 * @brief  Set Chip Select (CS/BSS) pin HIGH - Disable SPI
 */
void ST25R300_CS_High(ST25R300 *dev) {
    if (dev && dev->CS_port) {
        HAL_GPIO_WritePin(dev->CS_port, dev->CS_pin, GPIO_PIN_SET);
    }
}

/**
 * @brief  Set Reset pin LOW - Enable device (Active State)
 */
void ST25R300_Reset_Low(ST25R300 *dev) {
    if (dev && dev->reset_port) {
        HAL_GPIO_WritePin(dev->reset_port, dev->reset_pin, GPIO_PIN_RESET);
    }
}

/**
 * @brief  Set Reset pin HIGH - Hold device in reset
 */
void ST25R300_Reset_High(ST25R300 *dev) {
    if (dev && dev->reset_port) {
        HAL_GPIO_WritePin(dev->reset_port, dev->reset_pin, GPIO_PIN_SET);
    }
}

/**
 * @brief  Read IRQ pin state
 */
GPIO_PinState ST25R300_IRQ_Read(ST25R300 *dev) {
    if (dev && dev->IRQ_port) {
        return HAL_GPIO_ReadPin(dev->IRQ_port, dev->IRQ_pin);
    }
    return GPIO_PIN_RESET; // Retorno padrão seguro
}

