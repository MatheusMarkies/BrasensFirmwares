            pass_count++;
    }
    DEBUG_PRINT("└─ Result: %s\n\n", (status == HAL_OK) ? "PASS" : "FAIL");

    // Test 3: RF Self-Test
    DEBUG_PRINT("┌─ Test 3: RF Field and Antenna Test\n");
    status = ST25R300_RFSelfTest(dev, &report->rf);
    test_count++;

    if (status == HAL_OK)
    {
    	DEBUG_PRINT("│  RSSI I  : %d (%.1f dBm) %s\n",
