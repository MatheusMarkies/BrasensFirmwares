/**
 * @brief  Test antenna matching and tuning
 * @param  dev: Pointer to ST25R300 device structure
 * @retval TestResult_t
 */
TestResult_t ST25R300_TestAntennaMatching(ST25R300 *dev)
{
    HAL_StatusTypeDef status;
    ST25R300_RFMeasurements_t rf;

    DEBUG_PRINT("\n═══ Antenna Matching Test ═══\n\n");

    // Perform RF test
    status = ST25R300_RFSelfTest(dev, &rf);
    if (status != HAL_OK)
    {
        DEBUG_PRINT("✗ FAIL: Cannot perform RF test\n");
        return TEST_RESULT_FAIL;
    }

    // Analyze results
    DEBUG_PRINT("Results:\n");
    DEBUG_PRINT("  RSSI I: %d (%.1f dBm)\n", rf.rssi_i, rf.rssi_i_dbm);
    DEBUG_PRINT("  RSSI Q: %d (%.1f dBm)\n", rf.rssi_q, rf.rssi_q_dbm);

    // Check for good signal levels
    if (rf.rssi_i > 30 && rf.rssi_q > 30)
    {
        DEBUG_PRINT("\n✓ EXCELLENT: Strong signal, good antenna matching\n");
        return TEST_RESULT_PASS;
    }
    else if (rf.rssi_i > 15 && rf.rssi_q > 15)
    {
        DEBUG_PRINT("\n⚠ WARNING: Weak signal, consider antenna re-tuning\n");
        DEBUG_PRINT("Recommendations:\n");
        DEBUG_PRINT("  - Check matching capacitor values\n");
        DEBUG_PRINT("  - Verify antenna coil inductance\n");
        DEBUG_PRINT("  - Check for PCB interference\n");
        return TEST_RESULT_WARNING;
    }
    else
    {
        DEBUG_PRINT("\n✗ FAIL: Very weak or no signal\n");
        DEBUG_PRINT("Possible issues:\n");
        DEBUG_PRINT("  - Antenna not connected\n");
        DEBUG_PRINT("  - Wrong matching network values\n");
        DEBUG_PRINT("  - Antenna coil damaged\n");
        DEBUG_PRINT("  - Short circuit in matching network\n");
        return TEST_RESULT_FAIL;
    }
}

/**
 * @brief  Test antenna resonance frequency (simplified)
 * @param  dev: Pointer to ST25R300 device structure
 * @retval TestResult_t
 */
TestResult_t ST25R300_TestAntennaResonance(ST25R300 *dev)
{
    HAL_StatusTypeDef status;
    uint8_t rssi_values[5];

    DEBUG_PRINT("\n═══ Antenna Resonance Test ═══\n\n");
    DEBUG_PRINT("Testing at 13.56 MHz...\n");

    // Enable field
    uint8_t op_reg = 0x78;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, op_reg);
    if (status != HAL_OK) return TEST_RESULT_FAIL;

    // Take multiple measurements
    for (int i = 0; i < 5; i++)
    {
        HAL_Delay(10);
        status = ST25R300_ReadRegister(dev, ST25R300_REG_RSSI_I, &rssi_values[i]);
        if (status != HAL_OK) return TEST_RESULT_FAIL;
        DEBUG_PRINT("  Sample %d: RSSI = %d\n", i+1, rssi_values[i]);
    }

    // Calculate average
    uint16_t sum = 0;
    for (int i = 0; i < 5; i++)
    {
        sum += rssi_values[i];
    }
    uint8_t avg_rssi = sum / 5;

    DEBUG_PRINT("\nAverage RSSI: %d\n", avg_rssi);

    if (avg_rssi > 40)
    {
        DEBUG_PRINT("✓ EXCELLENT: Antenna resonating well at 13.56 MHz\n");
        return TEST_RESULT_PASS;
    }
    else if (avg_rssi > 20)
    {
        DEBUG_PRINT("⚠ WARNING: Antenna slightly off-resonance\n");
        DEBUG_PRINT("Consider adjusting matching capacitors\n");
        return TEST_RESULT_WARNING;
    }
    else
    {
        DEBUG_PRINT("✗ FAIL: Antenna not resonating at 13.56 MHz\n");
        DEBUG_PRINT("Check:\n");
        DEBUG_PRINT("  - Antenna coil value (should be ~1-2 µH)\n");
        DEBUG_PRINT("  - Series capacitor (for resonance)\n");
        DEBUG_PRINT("  - Parallel capacitor (for matching)\n");
        return TEST_RESULT_FAIL;
    }
}

/**
 * @brief  Quick health check (fast diagnostic)
 * @param  dev: Pointer to ST25R300 device structure
 * @retval TestResult_t
 */
TestResult_t ST25R300_QuickHealthCheck(ST25R300 *dev)
{
    HAL_StatusTypeDef status;
    uint8_t ic_identity, status_reg, rssi;

    DEBUG_PRINT("\n═══ Quick Health Check ═══\n\n");

    // Check 1: SPI communication
    status = ST25R300_ReadRegister(dev, ST25R300_REG_IC_IDENTITY, &ic_identity);
    if (status != HAL_OK || ((ic_identity >> 3) & 0x1F) != 0x16)
    {
        DEBUG_PRINT("✗ FAIL: SPI communication error\n");
        return TEST_RESULT_FAIL;
    }
    DEBUG_PRINT("✓ SPI communication: OK\n");

    // Check 2: Oscillator
    status = ST25R300_ReadRegister(dev, ST25R300_REG_STATUS_1, &status_reg);
    if (status != HAL_OK || !(status_reg & 0x10))
    {
        DEBUG_PRINT("✗ FAIL: Oscillator not stable\n");
        return TEST_RESULT_FAIL;
    }
    DEBUG_PRINT("✓ Oscillator: Stable\n");

    // Check 3: RF field
    uint8_t op_reg = 0x78;
    ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, op_reg);
    HAL_Delay(10);

    status = ST25R300_ReadRegister(dev, ST25R300_REG_RSSI_I, &rssi);
    if (status != HAL_OK || rssi < 10)
    {
        DEBUG_PRINT("✗ WARNING: Weak or no RF field\n");
        return TEST_RESULT_WARNING;
    }
    DEBUG_PRINT("✓ RF field: Present (RSSI=%d)\n", rssi);

    DEBUG_PRINT("\n✓ PASS: Basic functionality OK\n");
    return TEST_RESULT_PASS;
}
