               report->status.regulators_ok ? "✓" : "✗",
               report->status.regulators_ok ? "Within limits" : "OUT OF RANGE");

        if (report->status.oscillator_ok && report->status.regulators_ok)
            pass_count++;
    }
    else
    {
        DEBUG_PRINT("│  ✗ FAILED: Cannot communicate with ST25R300\n");
        report->overall_health = 0;
        strcpy(report->message, "CRITICAL: SPI communication failed");
        return HAL_ERROR;
    }
    DEBUG_PRINT("└─ Result: %s\n\n", (status == HAL_OK) ? "PASS" : "FAIL");

    // Test 2: Power Supply Measurements
    DEBUG_PRINT("┌─ Test 2: Power Supply Measurements\n");
    status = ST25R300_MeasurePower(dev, &report->power);
    test_count++;

    if (status == HAL_OK)
    {
    	int vdd_int = (int)report->power.vdd;
    	    int vdd_dec = (int)((report->power.vdd - vdd_int) * 100);

    	    DEBUG_PRINT("│  VDD     : %d.%02d V %s\n", vdd_int, vdd_dec,
    	               (report->power.vdd >= 2.7f && report->power.vdd <= 6.0f) ? "✓" : "✗");

    	    int tx_int = (int)report->power.vdd_tx;
    	    int tx_dec = (int)((report->power.vdd_tx - tx_int) * 100);
    	    DEBUG_PRINT("│  VDD_TX  : %d.%02d V %s\n", tx_int, tx_dec,
    	               (report->power.vdd_tx >= 2.7f && report->power.vdd_tx <= 6.0f) ? "✓" : "✗");

    	    int io_int = (int)report->power.vdd_io;
    	    int io_dec = (int)((report->power.vdd_io - io_int) * 100);
    	    DEBUG_PRINT("│  VDD_IO  : %d.%02d V %s\n", io_int, io_dec,
    	               (report->power.vdd_io >= 1.65f && report->power.vdd_io <= 5.5f) ? "✓" : "✗");

    	    int dr_int = (int)report->power.vdd_dr;
    	    int dr_dec = (int)((report->power.vdd_dr - dr_int) * 100);
    	    DEBUG_PRINT("│  VDD_DR  : %d.%02d V %s\n", dr_int, dr_dec,
    	               (report->power.vdd_dr >= 2.0f && report->power.vdd_dr <= 6.0f) ? "✓" : "✗");

    	    int a_int = (int)report->power.vdd_a;
    	    int a_dec = (int)((report->power.vdd_a - a_int) * 100);
    	    DEBUG_PRINT("│  VDD_A   : %d.%02d V %s\n", a_int, a_dec,
    	               (report->power.vdd_a >= 2.85f && report->power.vdd_a <= 3.15f) ? "✓" : "✗");

    	    int d_int = (int)report->power.vdd_d;
    	    int d_dec = (int)((report->power.vdd_d - d_int) * 100);
    	    DEBUG_PRINT("│  VDD_D   : %d.%02d V %s\n", d_int, d_dec,
    	               (report->power.vdd_d >= 1.05f && report->power.vdd_d <= 1.25f) ? "✓" : "✗");

    	    int agd_int = (int)report->power.agd;
    	    int agd_dec = (int)((report->power.agd - agd_int) * 100);
    	    DEBUG_PRINT("│  AGD     : %d.%02d V %s\n", agd_int, agd_dec,
    	               (report->power.agd >= 1.44f && report->power.agd <= 1.56f) ? "✓" : "✓");

    	    // Para corrente (mA), uma casa decimal
    	    int cur_int = (int)report->power.i_vdd_dr;
    	    int cur_dec = (int)((report->power.i_vdd_dr - cur_int) * 10);
    	    DEBUG_PRINT("│  I_VDD_DR: %d.%d mA %s\n", cur_int, cur_dec,
    	               (report->power.i_vdd_dr < 500.0f) ? "✓" : "✗ OVERCURRENT");

