            pass_count++;
    }
    DEBUG_PRINT("└─ Result: %s\n\n", (status == HAL_OK) ? "PASS" : "FAIL");

    // Test 4: Antenna Q-Factor Estimation
    DEBUG_PRINT("┌─ Test 4: Antenna Quality (Q-Factor)\n");
    float q_factor;
    status = ST25R300_EstimateAntennaQ(dev, &q_factor);
    test_count++;

    if (status == HAL_OK)
    {
        report->rf.antenna_q = q_factor;
        DEBUG_PRINT("│  Q-Factor: %.1f %s\n", q_factor,
               (q_factor > 10.0f) ? "✓ Good" :
               (q_factor > 5.0f) ? "⚠ Marginal" : "✗ Poor");

        if (q_factor > 10.0f)
        {
            DEBUG_PRINT("│  Antenna tuning: Excellent\n");
            pass_count++;
        }
        else if (q_factor > 5.0f)
        {
            DEBUG_PRINT("│  Antenna tuning: Acceptable (consider re-tuning)\n");
        }
        else
        {
            DEBUG_PRINT("│  Antenna tuning: Poor (check matching network)\n");
        }
    }
    DEBUG_PRINT("└─ Result: %s\n\n", (status == HAL_OK) ? "PASS" : "FAIL");

    // Test 5: Current Limiter Check
    DEBUG_PRINT("┌─ Test 5: Current Limiter Status\n");
    test_count++;

    if (report->status.current_limit)
    {
        DEBUG_PRINT("│  ⚠ WARNING: Current limiter is ACTIVE\n");
        DEBUG_PRINT("│  This indicates:\n");
        DEBUG_PRINT("│  - Antenna impedance may be too low\n");
        DEBUG_PRINT("│  - Possible short circuit in matching network\n");
        DEBUG_PRINT("│  - Driver overload\n");
    }
    else
    {
        DEBUG_PRINT("│  ✓ Current limiter: Inactive (normal)\n");
        pass_count++;
    }
    DEBUG_PRINT("└─ Result: %s\n\n", report->status.current_limit ? "WARNING" : "PASS");

    // Calculate overall health
    report->overall_health = (pass_count * 100) / test_count;

    // Generate summary message
    DEBUG_PRINT("╔══════════════════════════════════════════════════════╗\n");
    DEBUG_PRINT("║                    SUMMARY                           ║\n");
    DEBUG_PRINT("╠══════════════════════════════════════════════════════╣\n");
    DEBUG_PRINT("║  Tests Passed : %d / %d                                ║\n", pass_count, test_count);
    DEBUG_PRINT("║  Overall Health: %d%%                                 ║\n", report->overall_health);
    DEBUG_PRINT("║                                                      ║\n");

    if (report->overall_health >= 80)
    {
        DEBUG_PRINT("║  Status: ✓ EXCELLENT - System fully operational     ║\n");
        strcpy(report->message, "System is working perfectly");
    }
    else if (report->overall_health >= 60)
    {
        DEBUG_PRINT("║  Status: ⚠ GOOD - Minor issues detected             ║\n");
        strcpy(report->message, "System operational with minor issues");
    }
    else if (report->overall_health >= 40)
    {
        DEBUG_PRINT("║  Status: ⚠ MARGINAL - Significant issues            ║\n");
        strcpy(report->message, "System has significant issues - check antenna");
    }
    else
    {
        DEBUG_PRINT("║  Status: ✗ CRITICAL - System not functional         ║\n");
        strcpy(report->message, "CRITICAL: System requires immediate attention");
    }

    DEBUG_PRINT("╚══════════════════════════════════════════════════════╝\n\n");

    return HAL_OK;
}

