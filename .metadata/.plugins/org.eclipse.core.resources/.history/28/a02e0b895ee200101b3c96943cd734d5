/**
 * @brief  Enable test register access
 * @param  dev: Pointer to ST25R300 device structure
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_EnableTestAccess(ST25R300 *dev)
{
    return ST25R300_SendCommand(dev, 0xFC);  // Test register access command
}

/**
 * @brief  Read test register
 * @param  dev: Pointer to ST25R300 device structure
 * @param  test_reg: Test register address
 * @param  data: Pointer to store data
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_ReadTestRegister(ST25R300 *dev, uint8_t test_reg, uint8_t *data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[2];

    // Enable test access
    status = ST25R300_EnableTestAccess(dev);
    if (status != HAL_OK) return status;

    // Read test register with address 0xFC | 0x80
    cmd[0] = 0xFC | 0x80;  // Read command

    ST25R300_CS_Low(dev);
    status = HAL_SPI_Transmit(dev->hSPIx, cmd, 1, ST25R300_SPI_TIMEOUT);
    if (status == HAL_OK)
    {
        cmd[0] = test_reg;
        uint8_t dummy = 0x00;
        status = HAL_SPI_TransmitReceive(dev->hSPIx, &dummy, data, 1, ST25R300_SPI_TIMEOUT);
    }
    ST25R300_CS_High(dev);

    return status;
}

/**
 * @brief  Write test register
 * @param  dev: Pointer to ST25R300 device structure
 * @param  test_reg: Test register address
 * @param  data: Data to write
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_WriteTestRegister(ST25R300 *dev, uint8_t test_reg, uint8_t data)
{
    HAL_StatusTypeDef status;
    uint8_t cmd[3];

    // Enable test access
    status = ST25R300_EnableTestAccess(dev);
    if (status != HAL_OK) return status;

    // Write test register
    cmd[0] = 0xFC;  // Write command
    cmd[1] = test_reg;
    cmd[2] = data;

    ST25R300_CS_Low(dev);
    status = HAL_SPI_Transmit(dev->hSPIx, cmd, 3, ST25R300_SPI_TIMEOUT);
    ST25R300_CS_High(dev);

    return status;
}

// Define o comando conforme a Tabela 6 do datasheet
#define ST25R300_CMD_CLEAR_FIFO  0x64

/**
 * @brief Limpa o FIFO para garantir que a próxima leitura de diagnóstico seja de dados novos.
 */
void ST25R300_ResetFIFO(ST25R300 *dev) {
    // Envia o comando direto 0x64 conforme visto na Tabela 6
    if (ST25R300_SendCommand(dev, ST25R300_CMD_CLEAR_FIFO) == HAL_OK) {
        DEBUG_PRINT("FIFO Cleared successfully.\r\n");
    } else {
        DEBUG_PRINT("Error clearing FIFO.\r\n");
    }
}

/**
 * @brief  Execute diagnostic measurement
 * @param  dev: Pointer to ST25R300 device structure
 * @param  cmd: Diagnostic command
 * @param  result: Pointer to store result (raw 9-bit value)
 * @retval HAL_StatusTypeDef
 */
/**
 * @brief  Executa uma medição de diagnóstico e retorna o valor bruto de 9 bits.
 * @param  dev: Ponteiro para a estrutura do dispositivo.
 * @param  cmd: Comando de diagnóstico (ex: ST25R300_DIAG_CMD_VDD_A).
 * @param  result: Ponteiro para armazenar o valor de 9 bits resultante.
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_DiagnosticMeasurement(ST25R300 *dev, uint8_t cmd, uint16_t *result)
{
    HAL_StatusTypeDef status;
    uint8_t ce_memory[2];
    uint8_t fifo_data[4];
    const uint8_t CMD_CLEAR_FIFO = 0x64; // Código correto conforme Tabela 6
    const uint8_t CMD_TRIGGER_DIAG = 0xF8; // Trigger diagnostic
    const uint8_t CE_WRITE_ADDR = 0x58;    // Endereço de escrita na CE RAM

    // 1. Limpar o FIFO antes de começar para garantir que os dados lidos sejam novos
    status = ST25R300_SendCommand(dev, CMD_CLEAR_FIFO);
    if (status != HAL_OK) return status;

    // 2. Habilitar acesso aos registros de teste e desconectar o TAD
    // O comando de acesso a testes é 0xFC
    status = ST25R300_WriteTestRegister(dev, ST25R300_TEST_REG_DIAGNOSTIC,
                                       ST25R300_TEST_REG_DISCON_TAD);
    if (status != HAL_OK) return status;

    // 3. Escrever o comando de diagnóstico na memória CE
    ce_memory[0] = cmd;
    ce_memory[1] = 0x00;

    ST25R300_CS_Low(dev);
    status = HAL_SPI_Transmit(dev->hSPIx, (uint8_t*)&CE_WRITE_ADDR, 1, ST25R300_SPI_TIMEOUT);
    if (status == HAL_OK)
    {
        status = HAL_SPI_Transmit(dev->hSPIx, ce_memory, 2, ST25R300_SPI_TIMEOUT);
    }
    ST25R300_CS_High(dev);
    if (status != HAL_OK) return status;

    // 4. Disparar a medição de diagnóstico
    status = ST25R300_SendCommand(dev, CMD_TRIGGER_DIAG);
    if (status != HAL_OK) return status;

    // 5. Aguardar a conclusão da medição (bit I_dct no IRQ_STATUS_3)
    // O datasheet indica que medições de diagnóstico geram interrupção I_dct
    uint8_t irq_status;
    uint32_t tickstart = HAL_GetTick();
    const uint32_t timeout_val = 100;

    do {
        // Reg 0x42 é tipicamente o IRQ Status 3 onde reside o I_dct (bit 4)
        status = ST25R300_ReadRegister(dev, ST25R300_REG_IRQ_STATUS_3, &irq_status);
        if (status != HAL_OK) return status;

        if (irq_status & 0x10) break; // Sucesso: Bit I_dct detectado

        HAL_Delay(1);
    } while ((HAL_GetTick() - tickstart) < timeout_val);

    if (!(irq_status & 0x10))
    {
        DEBUG_PRINT("⚠ Erro: Timeout aguardando I_dct (Diagnóstico falhou)\r\n");
        return HAL_TIMEOUT;
    }

    // 6. Ler o resultado do FIFO (4 bytes: cmd, cal_msb, cal_lsb, rfu)
    status = ST25R300_ReadFIFO(dev, fifo_data, 4);
    if (status != HAL_OK) return status;

    // 7. Extrair o valor de calibração de 9 bits
    // MSB está no byte 1 (bit 0), LSB está no byte 2 (8 bits)
    *result = ((uint16_t)(fifo_data[1] & 0x01) << 8) | fifo_data[2];

    return HAL_OK;
}

