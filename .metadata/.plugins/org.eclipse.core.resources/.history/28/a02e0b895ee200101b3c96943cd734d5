/**
 * @brief  Run complete diagnostic test
 * @param  dev: Pointer to ST25R300 device structure
 * @param  report: Pointer to store diagnostic report
 * @retval HAL_StatusTypeDef
 */

void ST25R300_Debug_Printf(const char *format, ...) {
    char buffer[256]; // Tamanho máximo de uma linha de debug
    va_list args;

    va_start(args, format);
    // vsnprintf preenche o buffer com segurança, respeitando o limite de 128 bytes
    int len = vsnprintf(buffer, sizeof(buffer), format, args);
    va_end(args);

    if (len > 0) {
        HAL_UART_Transmit(&huart1, (uint8_t*)buffer, len, 200);
    }
}

HAL_StatusTypeDef ST25R300_RunDiagnostics(ST25R300 *dev, ST25R300_DiagnosticReport_t *report)
{
    HAL_StatusTypeDef status;
    uint8_t test_count = 0;
    uint8_t pass_count = 0;

    memset(report, 0, sizeof(ST25R300_DiagnosticReport_t));
    strcpy(report->message, "Diagnostic started...\n");

    DEBUG_PRINT("\n╔══════════════════════════════════════════════════════╗\n");
    DEBUG_PRINT("║     ST25R300 COMPREHENSIVE DIAGNOSTIC TEST          ║\n");
    DEBUG_PRINT("╚══════════════════════════════════════════════════════╝\n\n");

    // Test 1: System Status
    DEBUG_PRINT("┌─ Test 1: System Status Check\n");
    status = ST25R300_CheckSystemStatus(dev, &report->status);
    test_count++;

    if (status == HAL_OK && report->status.spi_ok)
