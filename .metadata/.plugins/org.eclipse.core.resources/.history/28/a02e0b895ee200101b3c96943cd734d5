/**
 * @brief  Measure all power supply voltages and currents
 * @param  dev: Pointer to ST25R300 device structure
 * @param  power: Pointer to store power measurements
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_MeasurePower(ST25R300 *dev, ST25R300_PowerMeasurements_t *power)
{
    HAL_StatusTypeDef status;
    uint16_t raw_value;

    memset(power, 0, sizeof(ST25R300_PowerMeasurements_t));

    // Ensure receiver is enabled for measurements
    uint8_t op_reg;
    status = ST25R300_ReadRegister(dev, ST25R300_REG_OPERATION, &op_reg);
    if (status != HAL_OK) return status;

    if (!(op_reg & 0x20))  // rx_en not set
    {
        op_reg |= 0x20;
        status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, op_reg);
        if (status != HAL_OK) return status;
        HAL_Delay(5);
    }

    // Measure VDD
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_VDD, &raw_value);
    if (status == HAL_OK)
    {
        power->vdd = (float)raw_value * ST25R300_DIAG_CONV_VOLTAGE_HIGH / 1000.0f;
    }

    // Measure VDD_TX
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_VDD_TX, &raw_value);
    if (status == HAL_OK)
    {
        power->vdd_tx = (float)raw_value * ST25R300_DIAG_CONV_VOLTAGE_HIGH / 1000.0f;
    }

    // Measure VDD_IO
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_VDD_IO, &raw_value);
    if (status == HAL_OK)
    {
        power->vdd_io = (float)raw_value * ST25R300_DIAG_CONV_VOLTAGE_HIGH / 1000.0f;
    }

    // Measure VDD_DR
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_VDD_DR, &raw_value);
    if (status == HAL_OK)
    {
        power->vdd_dr = (float)raw_value * ST25R300_DIAG_CONV_VOLTAGE_HIGH / 1000.0f;
    }

    // Measure VDD_A
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_VDD_A, &raw_value);
    if (status == HAL_OK)
    {
        power->vdd_a = (float)raw_value * ST25R300_DIAG_CONV_VOLTAGE_HIGH / 1000.0f;
    }

    // Measure VDD_D
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_VDD_D, &raw_value);
    if (status == HAL_OK)
    {
        power->vdd_d = (float)raw_value * ST25R300_DIAG_CONV_VOLTAGE_LOW / 1000.0f;
    }

    // Measure AGD
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_AGD, &raw_value);
    if (status == HAL_OK)
    {
        power->agd = (float)raw_value * ST25R300_DIAG_CONV_VOLTAGE_LOW / 1000.0f;
    }

    // Measure VDD_DR current
    status = ST25R300_DiagnosticMeasurement(dev, ST25R300_DIAG_CMD_I_VDD_DR, &raw_value);
    if (status == HAL_OK)
    {
        power->i_vdd_dr = (float)raw_value * ST25R300_DIAG_CONV_CURRENT_VDD_DR;
    }

    return HAL_OK;
}

