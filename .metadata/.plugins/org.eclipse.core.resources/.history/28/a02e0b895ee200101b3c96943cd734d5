/**
 * @brief  Write a single byte to a register
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Register address (0x00 to 0x57)
 * @param  data: Data byte to write
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_WriteRegister(ST25R300 *dev, uint8_t reg,
		uint8_t data) {
	HAL_StatusTypeDef status;
	uint8_t tx_buffer[2];

	// Validate register address
	if (reg > 0x57) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 0 for write)
	tx_buffer[0] = (reg & 0x7F);  // Clear bit 7 for write operation
	tx_buffer[1] = data;

	// SPI Transaction
	ST25R300_CS_Low(dev);
	status = HAL_SPI_Transmit(dev->hSPIx, tx_buffer, 2, ST25R300_SPI_TIMEOUT);
	ST25R300_CS_High(dev);

	return status;
}

/**
 * @brief  Write multiple bytes to consecutive registers (auto-increment)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Starting register address (0x00 to 0x57)
 * @param  data: Pointer to data buffer
 * @param  length: Number of bytes to write
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_WriteRegisters(ST25R300 *dev, uint8_t reg,
		uint8_t *data, uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd;

	// Validate parameters
	if (reg > 0x57 || data == NULL || length == 0) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 0 for write)
	cmd = (reg & 0x7F);

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send command byte
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Send data bytes (address auto-increments)
		status = HAL_SPI_Transmit(dev->hSPIx, data, length,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	return status;
}

/**
 * @brief  Read a single byte from a register
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Register address (0x00 to 0x57)
 * @param  data: Pointer to store read data
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_ReadRegister(ST25R300 *dev, uint8_t reg,
		uint8_t *data) {
	HAL_StatusTypeDef status;
	uint8_t cmd;
	uint8_t dummy = 0x00;

	// Validate parameters
	if (reg > 0x57 || data == NULL) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 1 for read)
	cmd = (reg | 0x80);  // Set bit 7 for read operation

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send command byte
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Send dummy byte and receive data
		status = HAL_SPI_TransmitReceive(dev->hSPIx, &dummy, data, 1,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	return status;
}

/**
 * @brief  Read multiple bytes from consecutive registers (auto-increment)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Starting register address (0x00 to 0x57)
 * @param  data: Pointer to buffer to store read data
 * @param  length: Number of bytes to read
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 */
HAL_StatusTypeDef ST25R300_ReadRegisters(ST25R300 *dev, uint8_t reg,
		uint8_t *data, uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd;

	// Validate parameters
	if (reg > 0x57 || data == NULL || length == 0) {
		return HAL_ERROR;
	}

	// Prepare command byte (bit 7 = 1 for read)
	cmd = (reg | 0x80);

	// Prepare dummy buffer for transmit
	uint8_t *dummy_tx = (uint8_t*) calloc(length, sizeof(uint8_t));
	if (dummy_tx == NULL) {
		return HAL_ERROR;
	}

	// SPI Transaction
	ST25R300_CS_Low(dev);

	// Send command byte
	status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);

	if (status == HAL_OK) {
		// Send dummy bytes and receive data (address auto-increments)
		status = HAL_SPI_TransmitReceive(dev->hSPIx, dummy_tx, data, length,
				ST25R300_SPI_TIMEOUT);
	}

	ST25R300_CS_High(dev);

	free(dummy_tx);

	return status;
}

/**
 * @brief  Modify specific bits in a register (Read-Modify-Write)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  reg: Register address (0x00 to 0x57)
 * @param  mask: Bit mask for bits to modify
 * @param  value: New value for masked bits
 * @retval HAL_StatusTypeDef: HAL_OK if success, HAL_ERROR or HAL_TIMEOUT otherwise
 *
 * @note   Example: To set bit 3 and clear bit 1:
 *         ST25R300_ModifyRegister(dev, reg, 0x0A, 0x08)
 *         mask = 0b00001010, value = 0b00001000
 */
HAL_StatusTypeDef ST25R300_ModifyRegister(ST25R300 *dev, uint8_t reg,
		uint8_t mask, uint8_t value) {
	HAL_StatusTypeDef status;
	uint8_t reg_value;

	// Read current register value
	status = ST25R300_ReadRegister(dev, reg, &reg_value);

	if (status == HAL_OK) {
		// Clear bits to modify and set new values
		reg_value = (reg_value & ~mask) | (value & mask);

		// Write modified value back
		status = ST25R300_WriteRegister(dev, reg, reg_value);
	}

	return status;
}


HAL_StatusTypeDef ST25R300_SendCommand(ST25R300 *dev, uint8_t cmd) {
    HAL_StatusTypeDef status;

    if (dev == NULL || dev->hSPIx == NULL) {
        return HAL_ERROR;
    }

    ST25R300_CS_Low(dev);
    status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);
    ST25R300_CS_High(dev);

    return status;
}
