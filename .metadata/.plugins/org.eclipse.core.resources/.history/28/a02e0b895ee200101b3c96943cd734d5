/**
 * @brief  Check system status
 * @param  dev: Pointer to ST25R300 device structure
 * @param  sys_status: Pointer to store system status
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_CheckSystemStatus(ST25R300 *dev, ST25R300_SystemStatus_t *sys_status)
{
    HAL_StatusTypeDef status;
    uint8_t reg_value;

    memset(sys_status, 0, sizeof(ST25R300_SystemStatus_t));

    // Read IC identity
    status = ST25R300_ReadRegister(dev, ST25R300_REG_IC_IDENTITY, &reg_value);
    if (status != HAL_OK) return status;

    sys_status->ic_identity = (reg_value >> 3) & 0x1F;
    sys_status->ic_revision = reg_value & 0x07;

    // Check if identity is correct (should be 0x16 for ST25R300)
    sys_status->spi_ok = (sys_status->ic_identity == 0x16) ? 1 : 0;

    // Check oscillator status
    status = ST25R300_ReadRegister(dev, ST25R300_REG_STATUS_1, &reg_value);
    if (status != HAL_OK) return status;

    sys_status->oscillator_ok = (reg_value & 0x10) ? 1 : 0;

    // Check current limiter
    status = ST25R300_ReadRegister(dev, ST25R300_REG_ANALOG_DISPLAY_1, &reg_value);
    if (status != HAL_OK) return status;

    sys_status->current_limit = (reg_value & 0x80) ? 1 : 0;

    // Check if regulators are within expected range (by reading voltages)
    ST25R300_PowerMeasurements_t power;
    status = ST25R300_MeasurePower(dev, &power);
    if (status == HAL_OK)
    {
        sys_status->regulators_ok = 1;

        // Check VDD_A (should be ~3.0V)
        if (power.vdd_a < 2.85f || power.vdd_a > 3.15f)
            sys_status->regulators_ok = 0;

        // Check VDD_D (should be ~1.15V)
        if (power.vdd_d < 1.05f || power.vdd_d > 1.25f)
            sys_status->regulators_ok = 0;

        // Check AGD (should be ~1.5V)
        if (power.agd < 1.44f || power.agd > 1.56f)
            sys_status->regulators_ok = 0;
    }

    return HAL_OK;
}

