/**
 * @brief  Measure RSSI (Received Signal Strength Indicator)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  rf: Pointer to store RF measurements
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_MeasureRSSI(ST25R300 *dev, ST25R300_RFMeasurements_t *rf)
{
    HAL_StatusTypeDef status;

    // 1. Disparar comando direto 0xF9 (Measure Amplitude)
    // Este comando força o ADC interno a amostrar o nível de RF atual.
    status = ST25R300_SendCommand(dev, 0xF9);
    if (status != HAL_OK) return status;

    // 2. Pequeno delay para permitir a conversão do ADC (100us a 1ms é suficiente)
    HAL_Delay(1);

    // 3. Ler RSSI do Canal I (In-phase)
    status = ST25R300_ReadRegister(dev, ST25R300_REG_RSSI_I, &rf->rssi_i);
    if (status != HAL_OK) return status;

    // 4. Ler RSSI do Canal Q (Quadrature)
    status = ST25R300_ReadRegister(dev, ST25R300_REG_RSSI_Q, &rf->rssi_q);
    if (status != HAL_OK) return status;

    // 5. Conversão para dBm aproximado (Cálculo empírico)
    // Se você não habilitou o suporte a float no printf, o DEBUG_PRINT ignorará estes valores.
    rf->rssi_i_dbm = -90.0f + ((float)rf->rssi_i * 0.5f);
    rf->rssi_q_dbm = -90.0f + ((float)rf->rssi_q * 0.5f);

    return HAL_OK;
}

/**
 * @brief  Perform RF self-test (loopback test)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  rf: Pointer to store RF measurements
 * @retval HAL_StatusTypeDef
 *
 * @note   This test measures the field generated by the antenna
 */
HAL_StatusTypeDef ST25R300_RFSelfTest(ST25R300 *dev, ST25R300_RFMeasurements_t *rf)
{
    HAL_StatusTypeDef status;

    // Enable transmitter and receiver
    uint8_t op_reg = 0x78;  // en=1, vdddr_en=1, rx_en=1, tx_en=1
    status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, op_reg);
    if (status != HAL_OK) return status;

    // Wait for field to stabilize
    HAL_Delay(10);

    // Measure I/Q ADC values with field on
    status = ST25R300_ReadRegister(dev, ST25R300_REG_I_CHANNEL_ADC, &rf->i_adc);
    if (status != HAL_OK) return status;

    status = ST25R300_ReadRegister(dev, ST25R300_REG_Q_CHANNEL_ADC, &rf->q_adc);
    if (status != HAL_OK) return status;

    // Measure RSSI
    status = ST25R300_MeasureRSSI(dev, rf);
    if (status != HAL_OK) return status;

    // Check external field detector
    uint8_t status_reg;
    status = ST25R300_ReadRegister(dev, ST25R300_REG_STATUS_1, &status_reg);
    if (status != HAL_OK) return status;

    rf->field_detected = (status_reg & 0x01) ? 1 : 0;

    return HAL_OK;
}

/**
 * @brief  Estimate antenna Q-factor
 * @param  dev: Pointer to ST25R300 device structure
 * @param  q_factor: Pointer to store Q-factor
 * @retval HAL_StatusTypeDef
 *
 * @note   This is a simplified estimation based on decay time
 */
HAL_StatusTypeDef ST25R300_EstimateAntennaQ(ST25R300 *dev, float *q_factor)
{
    HAL_StatusTypeDef status;
    uint8_t rssi_on, rssi_off;

    // Turn on field and measure RSSI
    uint8_t op_reg = 0x78;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, op_reg);
    if (status != HAL_OK) return status;
    HAL_Delay(1);

    status = ST25R300_ReadRegister(dev, ST25R300_REG_RSSI_I, &rssi_on);
    if (status != HAL_OK) return status;

    // Turn off field quickly and measure decay
    op_reg = 0x28;  // Keep receiver on, turn off TX
    status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, op_reg);
    if (status != HAL_OK) return status;

    HAL_Delay(1);  // Small delay for decay

    status = ST25R300_ReadRegister(dev, ST25R300_REG_RSSI_I, &rssi_off);
    if (status != HAL_OK) return status;

    // Estimate Q-factor based on decay rate
    // Q ≈ π × f0 × τ, where τ is the decay time constant
    // Simplified estimation
    if (rssi_on > 0)
    {
        float decay_ratio = (float)rssi_off / (float)rssi_on;
        *q_factor = 20.0f * decay_ratio;  // Empirical approximation
    }
    else
    {
        *q_factor = 0.0f;
    }

    return HAL_OK;
}

