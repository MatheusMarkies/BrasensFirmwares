/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void) {

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* MCU Configuration--------------------------------------------------------*/

	/* Reset of all peripherals, Initializes the Flash interface and the Systick. */
	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* Configure the system clock */
	SystemClock_Config();

	/* USER CODE BEGIN SysInit */
	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_LPUART1_UART_Init();
	MX_I2C1_Init();
	/* USER CODE BEGIN 2 */

	int32_t offset = 0;

	int32_t sum = 0;
	int count = 0;
	/* USER CODE END 2 */

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {
		/* USER CODE END WHILE */
		int16_t raw_adc = ADS1115_Read() * -1;

		if (abs(raw_adc) > 0) {
			if (count < 10) {
				sum += raw_adc;
				count++;
				offset = sum / count;
			} else {
				int32_t delta_bits = (int32_t) raw_adc - offset;
				voltage_uV = delta_bits * LSB_UV;

				debug_print_int(voltage_uV);
				DEBUG_PRINT(" uV\r\n");

				int32_t strain_uE_x1000 = delta_bits * USTRAIN_PER_BIT_x1000;
				strain_uE = strain_uE_x1000 / 1000;

				debug_print_int(strain_uE);
				DEBUG_PRINT(" uE\r\n");
			}
		}

		HAL_Delay(250);
		/* USER CODE BEGIN 3 */
	}
	/* USER CODE END 3 */
}

