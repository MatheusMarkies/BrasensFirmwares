HAL_StatusTypeDef KX122_CheckCommunication(SPI_HandleTypeDef *hspi) {
	uint8_t who_am_i;
	if (KX122_ReadRegister(hspi, 0x0F, &who_am_i) != HAL_OK) {
		return HAL_ERROR;
	}
	if (who_am_i != 0x1B) { // Assuming 0x1B is the correct response for WHO_AM_I
		return HAL_ERROR;
	}
	return HAL_OK;
}

HAL_StatusTypeDef KX122_ReadRegisters(SPI_HandleTypeDef *hspi, uint8_t reg,
		uint8_t *data, uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t regAddr = reg | 0x80;

	HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_RESET);

	status = HAL_SPI_Transmit(hspi, &regAddr, 1, 200);
	if (status != HAL_OK) {
		HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_SET);
		return status;
	}

	status = HAL_SPI_Receive(hspi, data, length, 200);

	HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_SET);

	return status;
}

static HAL_StatusTypeDef KX122_WriteRegister(SPI_HandleTypeDef *hspi,
		uint8_t reg, uint8_t value) {
	HAL_StatusTypeDef status;
	uint8_t data[2] = { reg & 0x7F, value }; // Clear MSB to indicate write operation

	HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_RESET);

	status = HAL_SPI_Transmit(hspi, data, 2, 200);

	HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_SET);

	return status;
}

static HAL_StatusTypeDef KX122_ReadRegister(SPI_HandleTypeDef *hspi,
		uint8_t reg, uint8_t *data) {
	HAL_StatusTypeDef status;
	uint8_t regAddr = reg | 0x80;

	HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_RESET);
	status = HAL_SPI_Transmit(hspi, &regAddr, 1, 200);
	if (status != HAL_OK) {
		HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_SET);
		return status;
	}

	status = HAL_SPI_Receive(hspi, data, 1, 200);

	HAL_GPIO_WritePin(KX122_CS_PORT, KX122_CS_PIN, GPIO_PIN_SET);

	return status;
}

