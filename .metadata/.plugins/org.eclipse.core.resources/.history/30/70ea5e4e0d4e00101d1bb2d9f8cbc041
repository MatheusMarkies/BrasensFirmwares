void loop() {
	//HAL_IWDG_Refresh(&hiwdg);

	switch (current_state) {

	case STATE_IDLE:
		if (HAL_GetTick() - last_cycle_start_timestamp >= CYCLE_INTERVAL_MS) {
			last_cycle_start_timestamp = HAL_GetTick();
			DEBUG_PRINT("Iniciando ciclo de medição...\r\n");

			buffer_head = 0;
			buffer_tail = 0;
			total_samples_processed = 0;

			FRAM_Format(&hi2c1, &metadata);

			HAL_TIM_Base_Start_IT(&htim21);
			current_state = STATE_SAMPLING;
		}
		break;

	case STATE_SAMPLING:
		while (buffer_head != buffer_tail) {
			Vibration sample = accel_buffer[buffer_tail];
			FRAM_WriteFloat(&hi2c1, &metadata, metadata.nextFreeAddress,
					sqrt(
							sample.x * sample.x + sample.y * sample.y
									+ sample.z * sample.z));

			buffer_tail = (buffer_tail + 1) % ACCEL_BUFFER_SIZE;

			total_samples_processed++;

			if (total_samples_processed >= SAMPLES) {
				HAL_TIM_Base_Stop_IT(&htim21);
				current_state = STATE_PROCESSING;
				break;
			}
		}
		break;

	case STATE_PROCESSING:
		DEBUG_PRINT(
				"Gravação na FRAM concluída. Finalizando processamento...\r\n");
		// Os cálculos de RMS poderiam ser feitos incrementalmente no estado SAMPLING
		// ou finalizados aqui.
		// Ex: data.rms_accel[0] = sqrt(data.rms_accel[0] / SAMPLES);

		current_package_to_send = 0;
		current_state = STATE_TRANSMITTING_VP;
		break;
	case STATE_TRANSMITTING_VP:
		if (current_package >= package_factor) {
			current_state = STATE_TRANSMITTING_DATA;
		} else
			readAndSendFRAMData();
		break;
	case STATE_TRANSMITTING_DATA:
		char msg[64];

		double temp = 0.0;
		readTemperature(&hi2c1, &temp);
		DEBUG_PRINT("Temp:\r\n");
		printFloat(temp);

		data.temperature = temp;
		strncpy(data.key, SENSOR_KEY, sizeof(data.key));

		data.type = 'D';

		DEBUG_PRINT("Size: ");
		snprintf(msg, sizeof(msg), "%d\r\n", sizeof(data));
		DEBUG_PRINT(msg);

		int trycount = 0;
		while (1) {
			if (LoRa_transmit(&myLoRa, (uint8_t*) &data, sizeof(data), 100)
					== 1) {
				DEBUG_PRINT("Success!\r\n");
				current_state = STATE_IDLE;
				current_package = 0;
				break;
			} else {
				DEBUG_PRINT("Fail!\r\n");
				trycount++;
			}
			if (trycount > 20)
				break;
		}
		break;
	}
}

