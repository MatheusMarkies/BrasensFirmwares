		data.rms_vel[0] = sqrt((data.rms_vel[0] * 1000) / SAMPLES);
		data.rms_vel[1] = sqrt((data.rms_vel[1] * 1000) / SAMPLES);
		data.rms_vel[2] = sqrt((data.rms_vel[2] * 1000) / SAMPLES);

		char buffer[256];
		snprintf(buffer, sizeof(buffer),

		"RMS Accel: %.2f, %.2f, %.2f\r\nRMS Vel: %.4f, %.4f, %.4f\r\n",
				data.rms_accel[0], data.rms_accel[1], data.rms_accel[2],
				data.rms_vel[0], data.rms_vel[1], data.rms_vel[2]);

		DEBUG_PRINT(buffer);

		DEBUG_PRINT("Amostragem concluída.\r\n");
		process_data_values = 1;
	}
}

void loop() {
	static uint32_t last_run_timestamp = 0;
	static uint8_t first_run = 1;

	// Aborta se o hardware não respondeu no setup
	if (sensor_ok == 0) {
		if (first_run || (HAL_GetTick() - last_run_timestamp >= 5000)) {
			last_run_timestamp = HAL_GetTick();
			DEBUG_PRINT("Acelerômetro off. Tentando reconectar...\r\n");
			if (KX122_Init(&hspi2) != HAL_ERROR)
				sensor_ok = 1;
		}
		return;
	}

	if (first_run || (HAL_GetTick() - last_run_timestamp >= 60000)) {
		last_run_timestamp = HAL_GetTick();
		first_run = 0;

		DEBUG_PRINT("\r\n=== INICIANDO CICLO DE 1 MINUTO ===\r\n");
		reset_FRAM_and_start_processing();
		DEBUG_PRINT("Amostrando em alta velocidade (RAM)...\r\n");

		// Buffer estático alocado na RAM para evitar estouro de Stack
		static VibrationRaw raw_buffer[SAMPLES];

		uint32_t last_micros_tick = micros();

		// ==========================================================
		// ETAPA 1: AMOSTRAGEM CRÍTICA (Nenhuma operação lenta aqui)
		// ==========================================================
		for (int i = 0; i < SAMPLES; i++) {
			// Aguarda 78us exatos (~12.8 kHz) usando o timer TIM2
			while ((micros() - last_micros_tick) < 78) {
				__NOP();
			}
			last_micros_tick += 78;

			// Salva os 16 bits puros direto na RAM
			KX122_ReadAccelRaw(&hspi2, &raw_buffer[i]);
		}

		DEBUG_PRINT("Amostragem concluída. Processando e gravando na FRAM...\r\n");

		// ==========================================================
		// ETAPA 2: PROCESSAMENTO FLOAT E I2C (Fora do caminho crítico)
		// ==========================================================

		// Correção crucial: dt para 12.800 Hz é ~78 microssegundos (0.000078s)
		float dt = 0.000078125f;

		// Setup inicial dos filtros baseado na primeira amostra lida
		accel_dc[0] = (float)raw_buffer[0].x / _g_sens;
		accel_dc[1] = (float)raw_buffer[0].y / _g_sens;
		accel_dc[2] = (float)raw_buffer[0].z / _g_sens;
		vel_integ[0] = 0.0f;
		vel_integ[1] = 0.0f;
		vel_integ[2] = 0.0f;

		for (int i = 0; i < SAMPLES; i++) {
			Vibration vib;

			// Conversão "lazy" dos inteiros para gravidade (g)
			vib.x = (float)raw_buffer[i].x / _g_sens;
			vib.y = (float)raw_buffer[i].y / _g_sens;
			vib.z = (float)raw_buffer[i].z / _g_sens;

			data.rms_accel[0] += (vib.x * vib.x);
			data.rms_accel[1] += (vib.y * vib.y);
			data.rms_accel[2] += (vib.z * vib.z);

			float a[3] = { vib.x, vib.y, vib.z };
			for (int j = 0; j < 3; j++) {
				accel_dc[j] = DC_ALPHA * accel_dc[j] + (1.0f - DC_ALPHA) * a[j];
				float a_ac = (a[j] - accel_dc[j]) * GRAVITY_MS2;
				vel_integ[j] = vel_integ[j] * VEL_LEAK + a_ac * dt;
				data.rms_vel[j] += vel_integ[j] * vel_integ[j];
			}

			// Salva o dado já convertido (float) na FRAM
			uint16_t address = i * sizeof(Vibration);
			FRAM_WriteStruct(&hi2c1, &metadata, address, &vib, sizeof(Vibration));
		}

		process_data_values = 0;
		sampling(); // Finaliza cálculos de RMS

		DEBUG_PRINT("Gravação concluída. Iniciando transmissão via USART1...\r\n");

		current_package = 0;
		while (current_package < package_factor) {
			readAndSendFRAMData();
		}

		DEBUG_PRINT("\r\n=== CICLO CONCLUÍDO. AGUARDANDO 1 MINUTO... ===\r\n");
	}
}

