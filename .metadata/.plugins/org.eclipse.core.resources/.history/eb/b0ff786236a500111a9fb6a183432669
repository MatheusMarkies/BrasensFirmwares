void delayMicroseconds(uint32_t us) {
	/* contador de 16 bits: mascarar a diferenca (us deve ser < 65535) */
	uint16_t start = (uint16_t) micros();
	while ((uint16_t) ((uint16_t) micros() - start) < us) {
