 *
 *  Created on: Jun 7, 2024
 *      Author: Matheus Markies
 */
HAL_StatusTypeDef KX122_Init(SPI_HandleTypeDef *hspi) {
	HAL_StatusTypeDef rc;
	unsigned char reg;
	unsigned char gsel;
	int i;

	rc = KX122_ReadRegister(hspi, KX122_WHO_AM_I, &reg);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't access KX122 \r\n");
		return (rc);
	}

	DEBUG_PRINT("KX122_WHO_AMI Register Value = 0x \r\n");
	DEBUG_PRINT_REGISTER(KX122_WHO_AM_I, reg);

	if (reg != KX122_WAI_VAL) {
		DEBUG_PRINT("Can't find KX122 \r\n");
		return HAL_ERROR;
	}

	reg = KX122_CNTL1_VAL;
	rc = KX122_WriteRegister(hspi, KX122_CNTL1, KX122_CNTL1_VAL);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't write KX122 CNTL1 register at first \r\n");
		return (rc);
	}

	reg = KX122_ODCNTL_VAL;
	rc = KX122_WriteRegister(hspi, KX122_ODCNTL, KX122_ODCNTL_VAL);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't write KX122 ODCNTL register \r\n");
		return (rc);
	}

	rc = KX122_ReadRegister(hspi, KX122_CNTL1, &reg);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't read KX122 CNTL1 register \r\n");
		return (rc);
	}
	gsel = reg & KX122_CNTL1_GSELMASK;

	reg |= KX122_CNTL1_PC1;
	rc = KX122_WriteRegister(hspi, KX122_CNTL1, reg);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't write KX122 CNTL1 register at second \r\n");
		return (rc);
	}

	switch (gsel) {
	case KX122_CNTL1_GSEL_2G:
		_g_sens = 16384;
		break;
	case KX122_CNTL1_GSEL_4G:
		_g_sens = 8192;
		break;
	case KX122_CNTL1_GSEL_8G:
		_g_sens = 4096;
		break;
	default:
		break;
	}

	return HAL_OK;
}

HAL_StatusTypeDef KX122_StartBuffer(SPI_HandleTypeDef *hspi) {
	HAL_StatusTypeDef rc;
	int8_t cntlreg;
	int8_t reg;

	rc = KX122_ReadRegister(hspi, KX122_CNTL1, &cntlreg);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't read KX122 CNTL1 register \r\n");
		return (rc);
	}

	DEBUG_PRINT_REGISTER(KX122_CNTL1, cntlreg);

	reg = 0x00;
	rc = KX122_WriteRegister(hspi, KX122_CNTL1, reg);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't write KX122 CNTL1 register \r\n");
		return (rc);
	}

	if (KX122_WriteRegister(hspi, BUF_CNTL2, 0xC0) != HAL_OK)
		return HAL_ERROR; // 16 bits FILO
	if (KX122_WriteRegister(hspi, BUF_CLEAR, 0x80) != HAL_OK)
		return HAL_ERROR; // Clear buffer

	//rc = KX122_WriteRegister(&hi2c1, BUF_CNTL1, 681);  // Set watermark level to 681 samples (3 axes per sample)

	rc = KX122_WriteRegister(hspi, KX122_CNTL1, cntlreg);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't write KX122 CNTL1 register \r\n");
		return (rc);
	}

	DEBUG_PRINT("Start buffer! \r\n");
	return HAL_OK;
}

HAL_StatusTypeDef KX122_GetBufferSize(SPI_HandleTypeDef *hspi, uint8_t *data) {
	HAL_StatusTypeDef rc;
	rc = KX122_ReadRegister(hspi, BUF_STATUS_1, data);
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't read KX122 BUF_STATUS_1 register \r\n");
	}
	return rc;
}

HAL_StatusTypeDef KX122_ReadBufferData(SPI_HandleTypeDef *hspi, float *data,
		int index) {
	HAL_StatusTypeDef rc;
	uint8_t bufferSize = 0;
	KX122_GetBufferSize(&hi2c1, bufferSize);
	uint8_t val[8];
	signed short acc[3];

	rc = KX122_ReadRegisters(hspi, BUF_READ, val, sizeof(val));
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't get KX122 accel value \r\n");
	}

	acc[0] = ((int16_t) val[index + 1] << 8) | (val[index]);
	acc[1] = ((int16_t) val[index + 3] << 8) | (val[index + 2]);
	acc[2] = ((int16_t) val[index + 5] << 8) | (val[index + 4]);

	// Convert LSB to g
	data[0] = (float) acc[0] / _g_sens;
	data[1] = (float) acc[1] / _g_sens;
	data[2] = (float) acc[2] / _g_sens;

	//printFloat(data[0]);
	//printFloat(data[1]);
	//printFloat(data[2]);

	return (rc);
}

#define MAX_FIFO_SAMPLES 681
#define TOTAL_SAMPLES 2048

HAL_StatusTypeDef KX122_ReadFIFOData(SPI_HandleTypeDef *hspi, float *data,
		uint16_t samples) {
	HAL_StatusTypeDef rc;
	uint8_t val[MAX_FIFO_SAMPLES * 6];
	uint16_t samples_to_read;
	uint16_t total_samples_read = 0;
	uint16_t index = 0;

	while (total_samples_read < samples) {
		samples_to_read =
				(samples - total_samples_read > MAX_FIFO_SAMPLES) ?
						MAX_FIFO_SAMPLES : (samples - total_samples_read);
		rc = KX122_ReadRegisters(hspi, BUF_READ, val, samples_to_read * 6);
		if (rc != HAL_OK) {
			DEBUG_PRINT("Can't get KX122 FIFO buffer value \r\n");
			return rc;
		}

		for (uint16_t i = 0; i < samples_to_read; i++) {
			int16_t acc_x = (int16_t) (val[i * 6 + 1] << 8 | val[i * 6]);
			int16_t acc_y = (int16_t) (val[i * 6 + 3] << 8 | val[i * 6 + 2]);
			int16_t acc_z = (int16_t) (val[i * 6 + 5] << 8 | val[i * 6 + 4]);

			data[index++] = (float) acc_x / _g_sens;
			data[index++] = (float) acc_y / _g_sens;
			data[index++] = (float) acc_z / _g_sens;
		}

		total_samples_read += samples_to_read;
	}
	return HAL_OK;
}

HAL_StatusTypeDef KX122_ReadAccelRaw(SPI_HandleTypeDef *hspi, VibrationRaw *vib) {
	HAL_StatusTypeDef rc;
	uint8_t val[6];

	// Lê apenas 6 bytes sequenciais começando do XOUT_L (0x06)
	rc = KX122_ReadRegisters(hspi, KX122_XOUT_L, val, 6);
	if (rc != HAL_OK) {
		return rc;
	}

	// Concatena os bytes (sem casting para float e sem divisão)
	vib->x = (int16_t)((val[1] << 8) | val[0]);
	vib->y = (int16_t)((val[3] << 8) | val[2]);
	vib->z = (int16_t)((val[5] << 8) | val[4]);

	return HAL_OK;
}

HAL_StatusTypeDef KX122_ReadAccelData(SPI_HandleTypeDef *hspi, float *data,
		Vibration *vib) {
	HAL_StatusTypeDef rc;
	uint8_t val[6];
	signed short acc[3];

	rc = KX122_ReadRegisters(hspi, KX122_XOUT_L, val, sizeof(val));
	if (rc != HAL_OK) {
		DEBUG_PRINT("Can't get KX122 accel value \r\n");
	}

	acc[0] = ((int16_t) val[1] << 8) | (val[0]);
	acc[1] = ((int16_t) val[3] << 8) | (val[2]);
	acc[2] = ((int16_t) val[5] << 8) | (val[4]);

	// Convert LSB to g
	data[0] = (float) acc[0] / _g_sens;
	data[1] = (float) acc[1] / _g_sens;
	data[2] = (float) acc[2] / _g_sens;

	vib->x = data[0];
	vib->y = data[1];
	vib->z = data[2];

	return (rc);
}

