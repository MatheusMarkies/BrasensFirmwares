void readAndSendFRAMData() {
	int start = TRANSMISSION_DATA_PACKAGE * current_package;
	int end = start + TRANSMISSION_DATA_PACKAGE;
	int realEnd = MIN(end, SAMPLES);

	/* Envia a tag de INÍCIO e o cabeçalho no primeiro pacote do ciclo */
	if (current_package == 0) {
		const char *start_tag = "<START_CSV>\r\nIndex,X_g,Y_g,Z_g\r\n";
		HAL_UART_Transmit(&huart1, (uint8_t*) start_tag, strlen(start_tag),
				1000);
	}

	for (int i = start; i < end; i++) {
		if (i < realEnd) {
			Vibration vib = { 0.0f, 0.0f, 0.0f };
			uint16_t address = i * sizeof(Vibration);

			if (address < metadata.nextFreeAddress) {
				FRAM_ReadStruct(&hi2c1, address, &vib, sizeof(Vibration));

				/* Formata os 3 eixos como texto e envia via USART1 */
				char buffer[64];
				snprintf(buffer, sizeof(buffer), "%d,%.4f,%.4f,%.4f\r\n", i,
						vib.x, vib.y, vib.z);
				HAL_UART_Transmit(&huart1, (uint8_t*) buffer, strlen(buffer),
						100);
			}
		}
	}

	/* Envia o RMS nas últimas linhas do CSV e a tag de TÉRMINO */
	if (current_package == (package_factor - 1)) {
		char rms_buffer[256];
		snprintf(rms_buffer, sizeof(rms_buffer),
				"RMS_Accel,%.4f,%.4f,%.4f\r\nRMS_Vel,%.4f,%.4f,%.4f\r\n<END_CSV>\r\n",
				data.rms_accel[0], data.rms_accel[1], data.rms_accel[2],
				data.rms_vel[0], data.rms_vel[1], data.rms_vel[2]);
		HAL_UART_Transmit(&huart1, (uint8_t*) rms_buffer, strlen(rms_buffer),
				1000);
	}

	current_package++;
}

