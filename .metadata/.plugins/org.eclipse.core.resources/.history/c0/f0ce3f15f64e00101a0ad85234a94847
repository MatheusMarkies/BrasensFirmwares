void GSM_PDP_Context_Activate(char *apn, char *user, char *pwd) {
	uint8_t ATisOK = 0;
	uint8_t CGREGisOK = 0;
	uint8_t CGDCONTisOK = 0;
	uint8_t CGACTisOK = 0;

	if (sendAT("AT\r\n", "OK")) {
		ATisOK = 1;
		DEBUG_PRINT("AT is OK\r\n");
	}

	if (ATisOK) {

		GSM_Disconnect_TCP();

		sendAT("AT+CPIN?\r\n", "OK");
		DEBUG_PRINT((char*) GSM_RX_Buffer);

		sendAT("AT+CSQ\r\n", "OK");
		DEBUG_PRINT((char*) GSM_RX_Buffer);

		if (sendAT("AT+CGREG?\r\n", "+CGREG: 0,1")) {
			CGREGisOK = 1;
			DEBUG_PRINT("CGREG is OK\r\n");
		}
	}

	sendAT("AT+CPSI?\r\n", "OK");
	DEBUG_PRINT((char*) GSM_RX_Buffer);

	if (ATisOK && CGREGisOK) {
		CGDCONTisOK = GSM_Setup_PDP_Context(apn, user, pwd);
	}

	if (ATisOK && CGREGisOK && CGDCONTisOK) {
		directTransmit("AT+CGATT=1\r\n");
		directTransmit("AT+CGACT=1,1\r\n");

		if (sendAT("AT+CGACT=?\r\n", "OK")) {
			CGACTisOK = 1;
			DEBUG_PRINT("CGACT is OK\r\n");
		}
		sendAT("AT+CGACT=?\r\n", "OK");
		DEBUG_PRINT((char*) GSM_RX_Buffer);
	}
}

uint8_t GSM_Connect_TCP(char *apn, char *user, char *pwd) {
	GSM_Disconnect_TCP();

	if (!GSM_Setup_PDP_Context(apn, user, pwd))
		return 0;

	if (!sendAT("AT+CIPMODE=0\r\n", "OK"))
		return 0;

	if (!sendAT("AT+CIPSENDMODE=0\r\n", "OK"))
		return 0;

	if (!sendAT("AT+CIPCCFG=10,0,0,0,1,0,75000\r\n", "OK"))
		return 0;

	if (!sendAT("AT+CIPTIMEOUT=75000,15000,15000\r\n", "OK"))
		return 0;

	if (!sendAT("AT+NETOPEN\r\n", "+NETOPEN: 0"))
		return 0;

	return 1;
}

uint8_t GSM_Disconnect_TCP() {
	if (!sendAT("AT+NETCLOSE\r\n", "+NETCLOSE: 0")) {
		return 0;
	}

	return 1;
}

uint8_t GSM_Modem_Connect(char *host, uint16_t port) {
	if (!sendAT("AT+CIPRXGET=1\r\n", "OK")) {
		return 0;
	}

	// Estabelecer uma conexão em modo multi-socket
	char cmd[128];
	snprintf(cmd, sizeof(cmd), "AT+CIPOPEN=1,\"TCP\",\"%s\",%d\r\n", host,
			port);
	if (sendAT(cmd, "OK")) {
		DEBUG_PRINT("CIPOPEN!...");
		return 1;
	}

	return 0;
}

