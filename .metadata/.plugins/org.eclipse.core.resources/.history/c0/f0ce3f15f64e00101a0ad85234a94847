		Transmission_Data data = defaultTransmissionData();
		if (FRAM_ReadStruct(&hi2c1, 0, &data, sizeof(Transmission_Data))
				== HAL_OK) {
			address = sizeof(Transmission_Data);

			cJSON *data_json = transmission_data_to_json(&data);

			if (cJSON_PrintPreallocated(data_json, jsonDataBuffer, 220, 0)) {
				GSM_Send_HTTP_POST(jsonDataBuffer);
			} else {
				DEBUG_PRINT("JSON Buffer Overflow\r\n");
			}

			cJSON_Delete(data_json);
			nextScript = 1;
		} else {
			DEBUG_PRINT("MEM EXCEPTION D\r\n");
		}
	} else if (next == 'P') {
		DEBUG_PRINT("Vp\r\n");
		Transmission_VibrationPackage vibrationPackage =
				defaultTransmissionVibrationPackage();
		if (FRAM_ReadStruct(&hi2c1, 0, &vibrationPackage,
				sizeof(Transmission_VibrationPackage)) == HAL_OK) {
			DEBUG_PRINT("Vp Read\r\n");
			address = sizeof(Transmission_VibrationPackage);

			cJSON *vib_data_json = transmission_vibrationpackage_to_json(
					&vibrationPackage);

			if (cJSON_PrintPreallocated(vib_data_json, jsonVPBuffer, 180, 0)) {
				GSM_Send_HTTP_POST(jsonVPBuffer);
			} else {
				DEBUG_PRINT("JSON Buffer Overflow\r\n");
			}

			cJSON_Delete(vib_data_json);
			nextScript = 1;
		} else {
			DEBUG_PRINT("MEM EXCEPTION VP\r\n");
		}
	} else {
		DEBUG_PRINT("CHAR_NOT_FOUND_EXCEPTION\r\n");
		CHAR_NOT_FOUND_EXCEPTION();
	}

	return address;
}

uint16_t BEHAVIOR_Calculate_FRAM_Address() {
	uint16_t nextAddress = 0;

	for (int i = 0; i < dataIndicesSize; i++) {
		if (dataIndices[i] == 'D') {
			nextAddress += sizeof(Transmission_Data);
		} else if (dataIndices[i] == 'P') {
			nextAddress += sizeof(Transmission_VibrationPackage);
		} else {
			CHAR_NOT_FOUND_EXCEPTION();
		}
	}

	return nextAddress;
}

void BEHAVIOR_Reorganize_FRAM() {
	uint16_t nextAddress = reorganizeStartAddress;
	uint16_t oldAddress = 0;

	if (dataIndicesSize > 1) {
		for (int i = 0; i < dataIndicesSize; i++) {
			if (dataIndices[i] == 'D') {
				Transmission_Data data;
				FRAM_ReadStruct(&hi2c1, nextAddress, &data,
						sizeof(Transmission_Data));
				FRAM_WriteStruct(&hi2c1, &metadata, oldAddress, &data,
						sizeof(Transmission_Data));

				nextAddress += sizeof(Transmission_Data);
				oldAddress += sizeof(Transmission_Data);
			} else if (dataIndices[i] == 'P') {
				Transmission_VibrationPackage vibrationPackage;
				FRAM_ReadStruct(&hi2c1, nextAddress, &vibrationPackage,
						sizeof(Transmission_VibrationPackage));
				FRAM_WriteStruct(&hi2c1, &metadata, oldAddress,
						&vibrationPackage,
						sizeof(Transmission_VibrationPackage));

				nextAddress += sizeof(Transmission_VibrationPackage);
				oldAddress += sizeof(Transmission_VibrationPackage);
			} else {
				CHAR_NOT_FOUND_EXCEPTION();
			}
		}
	} else
		FRAM_Format(&hi2c1, &metadata);
}

void CHAR_NOT_FOUND_EXCEPTION() {
	DEBUG_PRINT("Char not found\r\n");
	BEHAVIOR_REMOVE_First_Item_From_DataIndices();
}

