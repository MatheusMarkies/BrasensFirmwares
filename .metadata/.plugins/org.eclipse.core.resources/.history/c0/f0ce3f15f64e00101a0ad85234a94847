// Função para realizar POST request
uint8_t GSM_Modem_HTTP_Post(char *host, uint16_t port, char *path,
		char *json_data) {
	if (!GSM_Modem_Connect(host, port)) {
		return 0;
	}

	char header[256];
	snprintf(header, sizeof(header), "POST %s HTTP/1.1\r\n"
			"Host: %s:%d\r\n"
			"Content-Type: application/json\r\n"
			"Content-Length: %d\r\n\r\n", path, host, port, strlen(json_data));

	if (GSM_Modem_Send(header) == 0) {
		return 0;
	}

	if (GSM_Modem_Send(json_data) == 0) {
		return 0;
	}

	size_t response_size = GMS_GET_MODEM_AVAILABLE_SIZE();
	if (response_size > 0) {
		char response[response_size + 1];
		GSM_Modem_Read(response_size);
		response[response_size] = '\0';
	}

	return 1;
}

