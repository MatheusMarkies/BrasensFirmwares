char* float_to_two_char_string(float value) {
	static char buffer[10];
	snprintf(buffer, sizeof(buffer), "%.2g", value);
	return buffer;
}

cJSON* transmission_data_to_json(const Transmission_Data *data) {
	cJSON *json = cJSON_CreateObject();
	char temp_float_buffer_rms_accel[10];
	char temp_float_buffer_rms_vel[10];

	if (json != NULL) {
		cJSON_AddStringToObject(json, "type", "D");
		cJSON_AddStringToObject(json, "key", data->key);

		cJSON *rms_accel = cJSON_CreateArray();
		for (int i = 0; i < 3; i++) {
			snprintf(temp_float_buffer_rms_accel,
					sizeof(temp_float_buffer_rms_accel), "%.2f",
					data->rms_accel[i]);
			cJSON_AddItemToArray(rms_accel,
					cJSON_CreateString(temp_float_buffer_rms_accel));
		}
		cJSON_AddItemToObject(json, "rms_accel", rms_accel);

		cJSON *rms_vel = cJSON_CreateArray();
		for (int i = 0; i < 3; i++) {
			snprintf(temp_float_buffer_rms_vel,
					sizeof(temp_float_buffer_rms_vel), "%.2f",
					data->rms_vel[i]);
			cJSON_AddItemToArray(rms_vel,
					cJSON_CreateString(temp_float_buffer_rms_vel));
		}
		cJSON_AddItemToObject(json, "rms_vel", rms_vel);

		cJSON_AddNumberToObject(json, "temperature", data->temperature);
		cJSON_AddNumberToObject(json, "battery", data->battery);
	}

	return json;
}

cJSON* transmission_vibrationpackage_to_json(
		const Transmission_VibrationPackage *data) {
	cJSON *json = cJSON_CreateObject();

	if (json != NULL) {
		cJSON_AddStringToObject(json, "type", "P");
		cJSON_AddStringToObject(json, "key", data->key);
		cJSON_AddNumberToObject(json, "axis", data->axis);

		cJSON *dataPackage = cJSON_CreateArray();
		for (int i = 0; i < TRANSMISSION_DATA_PACKAGE; i++) {
			cJSON_AddItemToArray(dataPackage,
					cJSON_CreateString(
							float_to_two_char_string(data->dataPackage[i])));
		}
		cJSON_AddItemToObject(json, "dataPackage", dataPackage);

		cJSON_AddNumberToObject(json, "start", data->start);
		cJSON_AddNumberToObject(json, "end", data->end);
	}

	return json;
}

char* generateTransmissionDataJSON(Transmission_Data *data) {
