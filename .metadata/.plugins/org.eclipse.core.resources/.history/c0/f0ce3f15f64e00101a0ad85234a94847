void SENDING_ACK(char *ack_key) {
	int tryCount = 0;
	const int MAX_TRIES = 10;
	while (tryCount < MAX_TRIES) {
		DEBUG_PRINT("Enviando ACK para a chave: ");
		DEBUG_PRINT(ack_key);

		uint8_t key_length = strlen(ack_key);

		if (LoRa_transmit(&myLoRa, (uint8_t*) ack_key, key_length, 200) == 1) {
			DEBUG_PRINT("... Sucesso no envio do ACK!\r\n");
			LoRa_startReceiving(&myLoRa);
			return;
		} else {
			DEBUG_PRINT("... Falha no envio do ACK!\r\n");
			tryCount++;
		}
		HAL_Delay(100);
	}

	DEBUG_PRINT(
			"Falha ao enviar o ACK após várias tentativas. Desistindo.\r\n");
	LoRa_startReceiving(&myLoRa);
}

