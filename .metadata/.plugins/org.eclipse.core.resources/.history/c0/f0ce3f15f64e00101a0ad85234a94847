void I2C_Scan() {
	char msg[64];
	HAL_StatusTypeDef result;
	uint8_t i;

	DEBUG_PRINT("Scanning I2C bus:\r\n");

	for (i = 1; i < 128; i++) {

		result = HAL_I2C_IsDeviceReady(&hi2c1, (uint16_t) (i << 1), 1, 10);
		if (result == HAL_OK) {
			snprintf(msg, sizeof(msg), "Device found at 0x%02X\r\n", i);
			DEBUG_PRINT(msg);
		} else {

		}
	}
	DEBUG_PRINT("I2C scan completed.\r\n");
}

void INIT_GSM_K() {
	HAL_GPIO_WritePin(K_GPIO_Port, K_Pin, GPIO_PIN_RESET);
	HAL_Delay(100);
	HAL_GPIO_WritePin(K_GPIO_Port, K_Pin, GPIO_PIN_SET);
	HAL_Delay(1000);
