void READ_MSP_Serial_Commands() {
	if (mspStatus == FREE_STATUS)
		resetMSPBuffers();

	HAL_UART_Receive_IT(&huart1, &MSP_RX_Stream_Data, 1);

	if (mspStatus == RECEIVING) {
		uint32_t previousTick = HAL_GetTick();
		while (previousTick + MSP_TIMEOUT > HAL_GetTick()) {

			if (HAL_GetTick() - last_read_serial_timestamp
					>= READ_SERIAL_INTERVAL_MS) {
				last_read_serial_timestamp = HAL_GetTick();

				if (strstr((char*) MSP_RX_Buffer, "OK")) {

					BEHAVIOR_REMOVE_First_Item_From_DataIndices();
					BEHAVIOR_Reorganize_FRAM();

					if (dataIndicesSize > 0)
						sendReady();
					break;
				} else if (strstr((char*) MSP_RX_Buffer, "NX")) {
					reorganizeStartAddress = BEHAVIOR_Send_Next_Struct_In_FRAM(
							BEHAVIOR_GET_Next_Send_Item());
					break;
				} else if (strstr((char*) MSP_RX_Buffer, "RD")) {
					sendReady();
					break;
				}

			}
		}
		mspStatus = FREE_STATUS;
	}
}

