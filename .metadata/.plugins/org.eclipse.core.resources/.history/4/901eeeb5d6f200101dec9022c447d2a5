/**
 * @file st25r300_hal.c
 * @brief ST25R300 NFC Reader HAL Driver Implementation
 */

#include "st25r300_hal.h"
#include <string.h>

/* ============================================================================
 * MACROS E DEFINIÇÕES PRIVADAS
 * ============================================================================ */

// Timeouts
#define DEFAULT_SPI_TIMEOUT     100     // ms
#define OSC_STABILIZE_TIMEOUT   10      // ms (datasheet: tBOOT max 900µs)
#define REGULATOR_STABILIZE_US  10      // µs (datasheet: mín 10µs)
#define FIELD_ON_TIMEOUT        50      // ms

// SPI Operation Codes (Seção 5.15.2.1)
#define SPI_OP_WRITE            0x00
#define SPI_OP_READ             0x80
#define SPI_OP_COMMAND          0xC0

// Máscaras
#define SPI_ADDR_MASK           0x7F

/* ============================================================================
 * FUNÇÕES AUXILIARES PRIVADAS
 * ============================================================================ */

/**
 * @brief Controla pino NSS
 */
static inline void ST25R300_NSS_Low(ST25R300_Handle *dev) {
	HAL_GPIO_WritePin(dev->hw.nss_port, dev->hw.nss_pin, GPIO_PIN_RESET);
}

static inline void ST25R300_NSS_High(ST25R300_Handle *dev) {
	HAL_GPIO_WritePin(dev->hw.nss_port, dev->hw.nss_pin, GPIO_PIN_SET);
}

static inline void ST25R300_RST_High(ST25R300_Handle *dev) {
	// Verifica se a porta foi definida para evitar HardFault
	if (dev->hw.rst_port != NULL) {
		HAL_GPIO_WritePin(dev->hw.rst_port, dev->hw.rst_pin, GPIO_PIN_SET);
	}
}

static inline void ST25R300_RST_Low(ST25R300_Handle *dev) {
	if (dev->hw.rst_port != NULL) {
		HAL_GPIO_WritePin(dev->hw.rst_port, dev->hw.rst_pin, GPIO_PIN_RESET);
	}
}

/**
 * @brief Delay em microsegundos
 */
static void DelayUs(uint32_t us) {
	uint32_t start = DWT->CYCCNT;
	uint32_t cycles = us * (SystemCoreClock / 1000000);
	while ((DWT->CYCCNT - start) < cycles)
		;
}

/* ============================================================================
 * FUNÇÕES SPI DE BAIXO NÍVEL
 * ============================================================================ */

HAL_StatusTypeDef ST25R300_WriteRegister(ST25R300_Handle *dev, uint8_t addr,
		uint8_t data) {
	HAL_StatusTypeDef status;
	uint8_t tx_buf[2];

	// Formato: [0|ADDR6:0][DATA7:0] (página 29-31)
	tx_buf[0] = SPI_OP_WRITE | (addr & SPI_ADDR_MASK);
	tx_buf[1] = data;

	ST25R300_NSS_Low(dev);
	status = HAL_SPI_Transmit(dev->hw.hspi, tx_buf, 2, dev->hw.spi_timeout);
	ST25R300_NSS_High(dev);

	return status;
}

HAL_StatusTypeDef ST25R300_ReadRegister(ST25R300_Handle *dev, uint8_t addr,
		uint8_t *data) {
	HAL_StatusTypeDef status;
	uint8_t tx_buf[2];
	uint8_t rx_buf[2];

	// Formato: [1|ADDR6:0][dummy] -> [DATA7:0] (página 32)
	tx_buf[0] = SPI_OP_READ | (addr & SPI_ADDR_MASK);
	tx_buf[1] = 0x00; // Dummy byte

	ST25R300_NSS_Low(dev);
	status = HAL_SPI_TransmitReceive(dev->hw.hspi, tx_buf, rx_buf, 2,
			dev->hw.spi_timeout);
	ST25R300_NSS_High(dev);

	if (status == HAL_OK) {
		*data = rx_buf[1];
	}

	return status;
}

HAL_StatusTypeDef ST25R300_DirectCommand(ST25R300_Handle *dev, uint8_t cmd) {
	HAL_StatusTypeDef status;

	// Formato: [C7|1|1|C4:0] (página 33)
	ST25R300_NSS_Low(dev);
	status = HAL_SPI_Transmit(dev->hw.hspi, &cmd, 1, dev->hw.spi_timeout);
	ST25R300_NSS_High(dev);

	return status;
}

HAL_StatusTypeDef ST25R300_WriteFIFO(ST25R300_Handle *dev, const uint8_t *data,
		uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd;

	if (length > 256) {
		return HAL_ERROR;
	}

	// Endereço FIFO: 0x5F (página 34)
	cmd = SPI_OP_WRITE | ST25R300_FIFO_ADDRESS;

	ST25R300_NSS_Low(dev);

	// Envia comando
	status = HAL_SPI_Transmit(dev->hw.hspi, &cmd, 1, dev->hw.spi_timeout);

	if (status == HAL_OK) {
		// Envia dados
		status = HAL_SPI_Transmit(dev->hw.hspi, (uint8_t*) data, length,
				dev->hw.spi_timeout);
	}

	ST25R300_NSS_High(dev);

	return status;
}

HAL_StatusTypeDef ST25R300_ReadFIFO(ST25R300_Handle *dev, uint8_t *data,
		uint16_t length) {
	HAL_StatusTypeDef status;
	uint8_t cmd;
	uint8_t dummy = 0x00;

	if (length > 256) {
		return HAL_ERROR;
	}

	cmd = SPI_OP_READ | ST25R300_FIFO_ADDRESS;

	ST25R300_NSS_Low(dev);

	// Envia comando
	status = HAL_SPI_Transmit(dev->hw.hspi, &cmd, 1, dev->hw.spi_timeout);

	if (status == HAL_OK) {
		// Lê dados (página 34)
		status = HAL_SPI_TransmitReceive(dev->hw.hspi, &dummy, data, length,
				dev->hw.spi_timeout);
	}

	ST25R300_NSS_High(dev);

	return status;
}

/* ============================================================================
 * FUNÇÕES DE INICIALIZAÇÃO
 * ============================================================================ */

HAL_StatusTypeDef ST25R300_Init(ST25R300_Handle *dev,
		const ST25R300_HW_Config *hw_config) {
	HAL_StatusTypeDef status;
	uint8_t reg_val;

	// Copia configuração de hardware
	memcpy(&dev->hw, hw_config, sizeof(ST25R300_HW_Config));
	dev->state = ST25R300_STATE_RESET;
	dev->irq_pending = false;

	// Define timeout padrão se não especificado
	if (dev->hw.spi_timeout == 0) {
		dev->hw.spi_timeout = DEFAULT_SPI_TIMEOUT;
	}

	// Habilita DWT para delays em µs
	CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
	DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;

	// Garante NSS alto
	ST25R300_NSS_High(dev);
	HAL_Delay(10);

	ST25R300_RST_High(dev);

	HAL_Delay(10);
	ST25R300_RST_Low(dev);

	HAL_Delay(2);

	// ========================================================================
	// PASSO 1: Executar Set Default Command (página 36)
	// ========================================================================
	status = ST25R300_DirectCommand(dev, ST25R300_CMD_SET_DEFAULT);
	if (status != HAL_OK)
		return status;

	HAL_Delay(2); // Aguarda reset completar

	// ========================================================================
	// PASSO 2: Verificar identidade do chip
	// ========================================================================
	status = ST25R300_CheckIdentity(dev);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// PASSO 3: Configurar modo Ready (página 11, Seção 5.2)
	// ========================================================================

	// 3.1 - Habilitar modo Ready (en=1)
	reg_val = ST25R300_OP_EN;
	status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, reg_val);
	if (status != HAL_OK)
		return status;

	// 3.2 - Aguardar oscilador estabilizar (I_osc interrupt)
	status = ST25R300_WaitIRQ(dev, ST25R300_IRQ_OSC, OSC_STABILIZE_TIMEOUT);
	if (status != HAL_OK)
		return status;

	dev->state = ST25R300_STATE_READY;

	// ========================================================================
	// PASSO 4: Habilitar VDD_DR e aguardar 10µs
	// ========================================================================
	reg_val |= ST25R300_OP_VDDDR_EN;
	status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, reg_val);
	if (status != HAL_OK)
		return status;

	DelayUs(REGULATOR_STABILIZE_US);

	// ========================================================================
	// PASSO 5: Habilitar TX e RX
	// ========================================================================
	reg_val |= ST25R300_OP_TX_EN | ST25R300_OP_RX_EN;
	status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, reg_val);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// PASSO 6: Executar Adjust Regulator (página 36)
	// ========================================================================
	status = ST25R300_DirectCommand(dev, ST25R300_CMD_ADJUST_REGULATORS);
	if (status != HAL_OK)
		return status;

	// Aguardar comando completar
	status = ST25R300_WaitIRQ(dev, ST25R300_IRQ_DCT, 50);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// PASSO 7: Executar Calibrate RC (página 39)
	// ========================================================================
	status = ST25R300_DirectCommand(dev, ST25R300_CMD_CALIBRATE_RC);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// PASSO 8: Configuração adicional
	// ========================================================================

	// Configurar antenna (single-ended no seu caso - veja schematic)
	// Baseado no X-NUCLEO-NFC12A1, usa differential por padrão
	reg_val = 0x00; // Differential mode
	status = ST25R300_WriteRegister(dev, ST25R300_REG_GENERAL_CONFIG, reg_val);
	if (status != HAL_OK)
		return status;

	// Configurar driver de transmissão (página 46)
	// regd=2 (300mV drop), d_res=0 (mínima resistência)
	reg_val = 0x20; // regd=2
	status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_DRIVER_CONFIG,
			reg_val);
	if (status != HAL_OK)
		return status;

	// Mascarar IRQs não utilizadas inicialmente
	status = ST25R300_WriteRegister(dev, ST25R300_REG_IRQ_MASK1, 0xFF);
	if (status != HAL_OK)
		return status;

	status = ST25R300_WriteRegister(dev, ST25R300_REG_IRQ_MASK2, 0xFF);
	if (status != HAL_OK)
		return status;

	return HAL_OK;
}

HAL_StatusTypeDef ST25R300_CheckIdentity(ST25R300_Handle *dev) {
	HAL_StatusTypeDef status;
	uint8_t ic_id;

	// Ler registrador de identidade (0x3F) (página 73)
	status = ST25R300_ReadRegister(dev, ST25R300_REG_IC_IDENTITY, &ic_id);
	if (status != HAL_OK)
		return status;

	// IC Type: bits 7:3 = 0x16 (10110b) para ST25R300
	dev->ic_type = (ic_id >> 3) & 0x1F;
	dev->ic_revision = ic_id & 0x07;

	if (dev->ic_type != 0x16) {
		return HAL_ERROR; // Chip errado
	}

	return HAL_OK;
}

HAL_StatusTypeDef ST25R300_ConfigureNFCV(ST25R300_Handle *dev,
		const ST25R300_NFCV_Config *config) {
	HAL_StatusTypeDef status;
	uint8_t reg_val;

	// Salvar configuração
	memcpy(&dev->nfcv, config, sizeof(ST25R300_NFCV_Config));

	// ========================================================================
	// Configurar Protocol Register 1 (0x14) - Página 54
	// ========================================================================
	// om[3:0] = 0x5 (ISO15693/NFC-V)
	// tx_rate[1:0] = config->tx_rate
	// rx_rate[1:0] = config->rx_rate

	reg_val = ST25R300_PROT_OM_NFCV | ((config->tx_rate & 0x03) << 4)
			| ((config->rx_rate & 0x03) << 6);

	status = ST25R300_WriteRegister(dev, ST25R300_REG_PROTOCOL1, reg_val);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// Configurar TX Protocol Register 1 (0x15) - Página 55
	// ========================================================================
	// a_tx_par=1 (gerar paridade)
	// tx_crc=1 (gerar CRC)
	// tr_am=0 (OOK modulation para NFC-V)
	// p_len conforme bitrate

	reg_val = 0x60; // a_tx_par=1, tx_crc=1, tr_am=0

	// p_len para NFC-V depende da taxa (página 56)
	switch (config->tx_rate) {
	case 0:
		reg_val |= 0x00;
		break; // 26kbps: 100 períodos
	case 1:
		reg_val |= 0x03;
		break; // 53kbps: 112 períodos
	case 2:
		reg_val |= 0x07;
		break; // 106kbps: 128 períodos
	default:
		reg_val |= 0x00;
	}

	status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_PROTOCOL1, reg_val);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// Configurar RX Protocol Register 1 (0x17) - Página 57
	// ========================================================================
	// a_rx_par=1, rx_crc=1, rx_nbtx=0, antcl=0
	reg_val = 0x0C;
	status = ST25R300_WriteRegister(dev, ST25R300_REG_RX_PROTOCOL1, reg_val);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// Configurar No-Response Timer (páginas 19, 61-62)
	// ========================================================================
	// NRT em steps de 64/fC = 4.72µs
	// Exemplo: 300ms = 300000µs / 4.72µs = 63559 ≈ 0xF847

	uint16_t nrt_value = (config->no_response_time_ms * 1000) / 5; // aprox

	// NRT[15:8]
	status = ST25R300_WriteRegister(dev, ST25R300_REG_NRT_GPT_CONFIG2,
			(nrt_value >> 8) & 0xFF);
	if (status != HAL_OK)
		return status;

	// NRT[7:0]
	status = ST25R300_WriteRegister(dev, ST25R300_REG_NRT_GPT_CONFIG3,
			nrt_value & 0xFF);
	if (status != HAL_OK)
		return status;

	// NRT config: nrt_emv=0, nrt_step=0 (64/fC)
	status = ST25R300_WriteRegister(dev, ST25R300_REG_NRT_GPT_CONFIG1, 0x00);
	if (status != HAL_OK)
		return status;

	// ========================================================================
	// Configurar Mask Receive Timer (páginas 19, 59-60)
	// ========================================================================
	// Mask 50µs após TX (típico para NFC-V)
	// mrt_step = 64/fC, sq_en=1, sq_del=0

	reg_val = 0x21; // mrt_step=10b (64/fC), sq_en=1
	status = ST25R300_WriteRegister(dev, ST25R300_REG_MASK_RX_TIMER1, reg_val);
	if (status != HAL_OK)
		return status;

	// MRT = 50µs / 4.72µs ≈ 11
	status = ST25R300_WriteRegister(dev, ST25R300_REG_MASK_RX_TIMER2, 11);
	if (status != HAL_OK)
		return status;

	return HAL_OK;
}

/* ============================================================================
 * CONTROLE DE CAMPO RF
 * ============================================================================ */

HAL_StatusTypeDef ST25R300_FieldOn(ST25R300_Handle *dev) {
	HAL_StatusTypeDef status;

	// Executar NFC Field On command (página 37)
	// Este comando:
	// 1. Ativa o detector de campo externo
	// 2. Verifica colisão RF
	// 3. Liga o transmissor se não houver colisão

	status = ST25R300_DirectCommand(dev, ST25R300_CMD_NFC_FIELD_ON);
	if (status != HAL_OK)
		return status;

	// Aguardar comando completar (I_dct)
	status = ST25R300_WaitIRQ(dev, ST25R300_IRQ_DCT, FIELD_ON_TIMEOUT);
	if (status != HAL_OK)
		return status;

	// Verificar se transmissor foi ligado
	uint8_t status_reg;
	status = ST25R300_ReadRegister(dev, ST25R300_REG_STATUS2, &status_reg);
	if (status != HAL_OK)
		return status;

	if (!(status_reg & 0x02)) { // tx_on bit
		return HAL_ERROR; // Campo não foi ligado (colisão RF?)
	}

	// Aguardar guard time (5ms para ISO15693)
	HAL_Delay(dev->nfcv.guard_time_ms);

	return HAL_OK;
}

HAL_StatusTypeDef ST25R300_FieldOff(ST25R300_Handle *dev) {
	HAL_StatusTypeDef status;
	uint8_t reg_val;

	// Ler registrador de operação
	status = ST25R300_ReadRegister(dev, ST25R300_REG_OPERATION, &reg_val);
	if (status != HAL_OK)
		return status;

	// Desligar TX
	reg_val &= ~ST25R300_OP_TX_EN;
	status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, reg_val);

	return status;
}

/* ============================================================================
 * FUNÇÕES DE IRQ
 * ============================================================================ */

void ST25R300_IRQ_Handler(ST25R300_Handle *dev) {
	dev->irq_pending = true;
}

HAL_StatusTypeDef ST25R300_WaitIRQ(ST25R300_Handle *dev, uint8_t irq_mask,
		uint32_t timeout_ms) {
	uint32_t start_tick = HAL_GetTick();
	uint8_t irq_status;
	HAL_StatusTypeDef status;

	while ((HAL_GetTick() - start_tick) < timeout_ms) {

		if (dev->irq_pending) {
			// Ler IRQ status register
			status = ST25R300_ReadRegister(dev, ST25R300_REG_IRQ_STATUS1,
					&irq_status);
			if (status != HAL_OK)
				return status;

			if (irq_status & irq_mask) {
				dev->irq_pending = false;
				return HAL_OK;
			}

			// Ler segundo registrador de IRQ se necessário
			if (irq_mask & 0xFF00) {
				status = ST25R300_ReadRegister(dev, ST25R300_REG_IRQ_STATUS2,
						&irq_status);
				if (status != HAL_OK)
					return status;

				if (irq_status & (irq_mask >> 8)) {
					dev->irq_pending = false;
					return HAL_OK;
				}
			}

			dev->irq_pending = false;
		}

		HAL_Delay(1);
	}

	return HAL_TIMEOUT;
}

HAL_StatusTypeDef ST25R300_ClearIRQ(ST25R300_Handle *dev) {
	HAL_StatusTypeDef status;
	uint8_t dummy;

	// Ler IRQ status limpa as flags (página 28)
	status = ST25R300_ReadRegister(dev, ST25R300_REG_IRQ_STATUS1, &dummy);
	if (status != HAL_OK)
		return status;

	status = ST25R300_ReadRegister(dev, ST25R300_REG_IRQ_STATUS2, &dummy);
	if (status != HAL_OK)
		return status;

	dev->irq_pending = false;

	return HAL_OK;
}

/* ============================================================================
 * FUNÇÕES DE UTILIDADE
 * ============================================================================ */

HAL_StatusTypeDef ST25R300_GetFIFOLength(ST25R300_Handle *dev, uint16_t *bytes) {
	HAL_StatusTypeDef status;
	uint8_t fifo_low, fifo_high;

	// Ler FIFO status registers (página 69-70)
	status = ST25R300_ReadRegister(dev, ST25R300_REG_FIFO_STATUS1, &fifo_low);
	if (status != HAL_OK)
		return status;

	status = ST25R300_ReadRegister(dev, ST25R300_REG_FIFO_STATUS2, &fifo_high);
	if (status != HAL_OK)
		return status;

	// fifo_b[8:0] = fifo_high[6] | fifo_low[7:0]
	*bytes = fifo_low | ((fifo_high & 0x40) << 2);

	return HAL_OK;
}

HAL_StatusTypeDef ST25R300_Reset(ST25R300_Handle *dev) {
	dev->state = ST25R300_STATE_RESET;
	return ST25R300_DirectCommand(dev, ST25R300_CMD_SET_DEFAULT);
}
