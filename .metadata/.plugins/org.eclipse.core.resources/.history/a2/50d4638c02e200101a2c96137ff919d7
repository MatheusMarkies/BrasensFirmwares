/**
 * @brief  Example: Single card detection
 */
HAL_StatusTypeDef Example_SingleCardDetection(ST25R300 *dev, CardInfo_t *card)
{
    HAL_StatusTypeDef status;

    // Initialize reader
    status = ST25R300_InitISO14443A(dev);
    if (status != HAL_OK) return status;

    // Try to detect card (with timeout)
    uint8_t attempts = 10;
    while (attempts--)
    {
        status = ST25R300_DetectCreditCard(dev, card);
        if (status == HAL_OK)
        {
            return HAL_OK;  // Card detected successfully
        }
        HAL_Delay(100);
    }

    return HAL_TIMEOUT;  // No card detected
}
