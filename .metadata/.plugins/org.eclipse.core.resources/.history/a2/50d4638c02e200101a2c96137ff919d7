// Direct Command Codes (from datasheet Table 6)
#define ST25R300_CMD_SET_DEFAULT                    0x60
#define ST25R300_CMD_STOP_ALL                       0x62
#define ST25R300_CMD_CLEAR_FIFO                     0x64
#define ST25R300_CMD_TRANSMIT_DATA                  0x6A
#define ST25R300_CMD_NFC_FIELD_ON                   0x6E
#define ST25R300_CMD_ADJUST_REGULATORS              0x68
#define ST25R300_CMD_CALIBRATE_RC                   0xEE

/**
 * @brief  Send direct command to ST25R300
 * @param  dev: Pointer to ST25R300 device structure
 * @param  cmd: Command code
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_SendCommand(ST25R300 *dev, uint8_t cmd)
{
    HAL_StatusTypeDef status;

    ST25R300_CS_Low(dev);
    status = HAL_SPI_Transmit(dev->hSPIx, &cmd, 1, ST25R300_SPI_TIMEOUT);
    ST25R300_CS_High(dev);

    return status;
}

