/**
 * @brief  Initialize ST25R300 for ISO14443A card detection (credit cards)
 * @param  dev: Pointer to ST25R300 device structure
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_InitISO14443A(ST25R300 *dev)
{
    HAL_StatusTypeDef status;
    uint8_t reg_value;

    // 1. Set default state
    status = ST25R300_SendCommand(dev, ST25R300_CMD_SET_DEFAULT);
    if (status != HAL_OK) return status;
    HAL_Delay(10);

    // 2. Configure Operation Register (0x00)
    // Enable: en=1 (bit 3), rx_en=1 (bit 5), tx_en=1 (bit 6), vdddr_en=1 (bit 4)
    reg_value = 0x78;  // 0b01111000
    status = ST25R300_WriteRegister(dev, ST25R300_REG_OPERATION, reg_value);
    if (status != HAL_OK) return status;

    // Wait for oscillator to stabilize
    HAL_Delay(5);

    // 3. Check oscillator ready
    uint8_t status_reg;
    uint8_t timeout = 100;
    do {
        status = ST25R300_ReadRegister(dev, ST25R300_REG_STATUS_1, &status_reg);
        if (status != HAL_OK) return status;
        HAL_Delay(1);
    } while ((status_reg & 0x10) == 0 && --timeout > 0);  // Wait for osc_ok bit

    if (timeout == 0) return HAL_TIMEOUT;

    // 4. Configure Protocol Register 1 (0x14)
    // Set operation mode: om=0x1 (NFC-A/ISO14443A), tx_rate=0, rx_rate=0 (106 kbps)
    reg_value = 0x01;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_PROTOCOL_1, reg_value);
    if (status != HAL_OK) return status;

    // 5. Configure TX Protocol Register 1 (0x15)
    // Enable: a_tx_par=1 (bit 6), tx_crc=1 (bit 5), tr_am=0 (OOK modulation)
    reg_value = 0x60;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_PROTOCOL_1, reg_value);
    if (status != HAL_OK) return status;

    // 6. Configure RX Protocol Register 1 (0x17)
    // Enable: a_rx_par=1 (bit 3), rx_crc=1 (bit 2), b_rx_sof=1 (bit 5), b_rx_eof=1 (bit 4)
    reg_value = 0x3C;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_RX_PROTOCOL_1, reg_value);
    if (status != HAL_OK) return status;

    // 7. Configure No-Response Timer (500ms timeout for card response)
    // NRT = 500ms / 4.72μs = 105932 = 0x19DEC
    status = ST25R300_WriteRegister(dev, ST25R300_REG_NRT_CONFIG_MSB, 0x01);
    if (status != HAL_OK) return status;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_NRT_CONFIG_LSB, 0x9D);
    if (status != HAL_OK) return status;

    // 8. Configure Mask Receive Timer (minimum delay before reception)
    status = ST25R300_WriteRegister(dev, ST25R300_REG_MRT_CONFIG_2, 0x0B);
    if (status != HAL_OK) return status;

    // 9. Adjust regulators
    status = ST25R300_SendCommand(dev, ST25R300_CMD_ADJUST_REGULATORS);
    if (status != HAL_OK) return status;
    HAL_Delay(10);

    // 10. Calibrate RC oscillator for AWS
    status = ST25R300_SendCommand(dev, ST25R300_CMD_CALIBRATE_RC);
    if (status != HAL_OK) return status;
    HAL_Delay(5);

    // 11. Enable RF field with collision avoidance
    status = ST25R300_SendCommand(dev, ST25R300_CMD_NFC_FIELD_ON);
    if (status != HAL_OK) return status;

    // Wait for field to stabilize (guard time)
    HAL_Delay(5);

    return HAL_OK;
}

