/**
 * @brief  Request Type A - Detect ISO14443A cards (including credit cards)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  atqa: Buffer to store ATQA (2 bytes)
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_REQA(ST25R300 *dev, uint8_t *atqa)
{
    HAL_StatusTypeDef status;

    // Send REQA command (7-bit short frame)
    status = ST25R300_SendShortFrame(dev, ISO14443A_CMD_REQA);
    if (status != HAL_OK) return status;

    // Wait for response
    HAL_Delay(5);

    // Check for RX interrupt
    uint8_t irq_status;
    status = ST25R300_ReadRegister(dev, ST25R300_REG_IRQ_STATUS_1, &irq_status);
    if (status != HAL_OK) return status;

    if (!(irq_status & 0x08))  // No I_rxe
    {
        return HAL_ERROR;  // No card detected
    }

    // Read ATQA (2 bytes)
    uint8_t fifo_bytes;
    status = ST25R300_ReadRegister(dev, ST25R300_REG_FIFO_STATUS_1, &fifo_bytes);
    if (status != HAL_OK) return status;

    if (fifo_bytes < 2)
    {
        return HAL_ERROR;
    }

    status = ST25R300_ReadFIFO(dev, atqa, 2);

    return status;
}

/**
 * @brief  Anti-collision and Select for ISO14443A
 * @param  dev: Pointer to ST25R300 device structure
 * @param  cascade_level: Cascade level (1, 2, or 3)
 * @param  uid: Buffer to store UID bytes (4 bytes per level)
 * @param  sak: Pointer to store SAK byte
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_AnticollisionSelect(ST25R300 *dev,
                                               uint8_t cascade_level,
                                               uint8_t *uid,
                                               uint8_t *sak)
{
    HAL_StatusTypeDef status;
    uint8_t cmd;
    uint8_t tx_buffer[7];
    uint8_t rx_buffer[5];
    uint16_t rx_len;

    // Determine cascade level command
    switch (cascade_level)
    {
        case 1: cmd = ISO14443A_CMD_ANTICOLL_CL1; break;
        case 2: cmd = ISO14443A_CMD_ANTICOLL_CL2; break;
        case 3: cmd = ISO14443A_CMD_ANTICOLL_CL3; break;
        default: return HAL_ERROR;
    }

    // Anti-collision command
    tx_buffer[0] = cmd;
    tx_buffer[1] = 0x20;  // NVB = 0x20 (no known bits)

    status = ST25R300_Transceive(dev, tx_buffer, 2, rx_buffer, &rx_len, 100);
    if (status != HAL_OK || rx_len != 5) return HAL_ERROR;

    // Store UID bytes (4 bytes)
    memcpy(uid, rx_buffer, 4);

    // SELECT command
    tx_buffer[0] = cmd;
    tx_buffer[1] = 0x70;  // NVB = 0x70 (all 40 bits known)
    memcpy(&tx_buffer[2], rx_buffer, 5);  // UID + BCC

    status = ST25R300_Transceive(dev, tx_buffer, 7, rx_buffer, &rx_len, 100);
    if (status != HAL_OK || rx_len != 1) return HAL_ERROR;

    *sak = rx_buffer[0];

    return HAL_OK;
}

/**
 * @brief  Detect and read credit card UID
 * @param  dev: Pointer to ST25R300 device structure
 * @param  card_info: Pointer to CardInfo structure to store card information
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_DetectCreditCard(ST25R300 *dev, CardInfo_t *card_info)
{
    HAL_StatusTypeDef status;
    uint8_t sak;

    // Clear card info structure
    memset(card_info, 0, sizeof(CardInfo_t));

    // Step 1: Send REQA to detect card
    status = ST25R300_REQA(dev, card_info->atqa);
    if (status != HAL_OK)
    {
        return HAL_ERROR;  // No card detected
    }

    // Step 2: Anti-collision Cascade Level 1
    status = ST25R300_AnticollisionSelect(dev, 1, card_info->uid, &sak);
    if (status != HAL_OK) return status;

    card_info->sak = sak;

    // Check if UID is complete or needs more cascade levels
    if (sak & ISO14443A_SAK_INCOMPLETE)
    {
        // UID not complete, need cascade level 2
        card_info->uid_size = 7;

        // Shift UID bytes
        memmove(&card_info->uid[3], card_info->uid, 4);

        // Get remaining UID bytes
        status = ST25R300_AnticollisionSelect(dev, 2, &card_info->uid[3], &sak);
        if (status != HAL_OK) return status;

        card_info->sak = sak;

        if (sak & ISO14443A_SAK_INCOMPLETE)
        {
            // Need cascade level 3 (triple size UID)
            card_info->uid_size = 10;

            memmove(&card_info->uid[6], &card_info->uid[3], 4);

            status = ST25R300_AnticollisionSelect(dev, 3, &card_info->uid[6], &sak);
            if (status != HAL_OK) return status;

            card_info->sak = sak;
        }
    }
    else
    {
        // Single size UID (4 bytes)
        card_info->uid_size = 4;
    }

    // Check if card is ISO14443-4 compliant (credit cards are)
    if (sak & ISO14443A_SAK_COMPLIANT)
    {
        card_info->is_iso14443_4 = 1;

        // Send RATS (Request for Answer To Select) to get ATS
        uint8_t rats_cmd[2] = {ISO14443A_CMD_RATS, 0x50};  // FSDI=5 (64 bytes), CID=0
        uint16_t ats_len;

        status = ST25R300_Transceive(dev, rats_cmd, 2, card_info->ats, &ats_len, 100);
        if (status == HAL_OK)
        {
            card_info->ats_length = (ats_len < 32) ? ats_len : 32;
        }

        // Identify as EMV payment card
        card_info->type = CARD_TYPE_EMV_PAYMENT;
    }
    else
    {
        card_info->type = CARD_TYPE_ISO14443A_GENERIC;
    }

    return HAL_OK;
}

/**
 * @brief  Get card type string
 * @param  type: Card type
 * @retval Const char pointer to card type name
 */
const char* ST25R300_GetCardTypeName(CardType_t type)
{
    switch (type)
    {
        case CARD_TYPE_MIFARE_ULTRALIGHT:    return "MIFARE Ultralight";
        case CARD_TYPE_MIFARE_CLASSIC_1K:    return "MIFARE Classic 1K";
        case CARD_TYPE_MIFARE_CLASSIC_4K:    return "MIFARE Classic 4K";
        case CARD_TYPE_MIFARE_DESFIRE:       return "MIFARE DESFire";
        case CARD_TYPE_EMV_PAYMENT:          return "EMV Payment Card (Credit/Debit)";
        case CARD_TYPE_ISO14443A_GENERIC:    return "ISO14443A Generic";
        default:                              return "Unknown";
    }
}

