// CREDIT CARD DETECTION - ISO14443A / EMVCo DEFINITIONS
// ============================================================================

// ISO14443A Commands
#define ISO14443A_CMD_REQA                          0x26  // Request Type A (short frame)
#define ISO14443A_CMD_WUPA                          0x52  // Wake-Up Type A
#define ISO14443A_CMD_ANTICOLL_CL1                  0x93  // Anti-collision Cascade Level 1
#define ISO14443A_CMD_SELECT_CL1                    0x93  // Select Cascade Level 1
#define ISO14443A_CMD_ANTICOLL_CL2                  0x95  // Anti-collision Cascade Level 2
#define ISO14443A_CMD_SELECT_CL2                    0x95  // Select Cascade Level 2
#define ISO14443A_CMD_ANTICOLL_CL3                  0x97  // Anti-collision Cascade Level 3
#define ISO14443A_CMD_SELECT_CL3                    0x97  // Select Cascade Level 3
#define ISO14443A_CMD_HLTA                          0x50  // Halt
#define ISO14443A_CMD_RATS                          0xE0  // Request for Answer To Select

// ATQA (Answer To Request Type A) - 2 bytes
#define ISO14443A_ATQA_LENGTH                       2

// SAK (Select AcKnowledge) values
#define ISO14443A_SAK_INCOMPLETE                    0x04  // UID not complete
#define ISO14443A_SAK_COMPLETE                      0x00  // UID complete
#define ISO14443A_SAK_COMPLIANT                     0x20  // ISO14443-4 compliant

// UID Sizes
#define ISO14443A_UID_SINGLE                        4     // Single size UID
#define ISO14443A_UID_DOUBLE                        7     // Double size UID
#define ISO14443A_UID_TRIPLE                        10    // Triple size UID

// Card Types
typedef enum {
    CARD_TYPE_UNKNOWN = 0,
    CARD_TYPE_MIFARE_ULTRALIGHT,
    CARD_TYPE_MIFARE_CLASSIC_1K,
    CARD_TYPE_MIFARE_CLASSIC_4K,
    CARD_TYPE_MIFARE_DESFIRE,
    CARD_TYPE_EMV_PAYMENT,          // Credit/Debit card
    CARD_TYPE_ISO14443A_GENERIC
} CardType_t;

// Card Information Structure
typedef struct {
    uint8_t     uid[10];            // UID (4, 7, or 10 bytes)
    uint8_t     uid_size;           // UID size
    uint8_t     atqa[2];            // Answer To Request A
    uint8_t     sak;                // Select Acknowledge
    CardType_t  type;               // Detected card type
    uint8_t     ats[32];            // Answer To Select (ISO14443-4)
    uint8_t     ats_length;         // ATS length
    uint8_t     is_iso14443_4;      // ISO14443-4 compliant flag
} CardInfo_t;

