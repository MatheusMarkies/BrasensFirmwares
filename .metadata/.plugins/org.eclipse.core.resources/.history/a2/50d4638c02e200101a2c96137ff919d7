/**
 * @brief  Send ISO14443A short frame command (7 bits)
 * @param  dev: Pointer to ST25R300 device structure
 * @param  cmd: Command byte (REQA or WUPA)
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_SendShortFrame(ST25R300 *dev, uint8_t cmd)
{
    HAL_StatusTypeDef status;

    // Clear FIFO
    status = ST25R300_SendCommand(dev, ST25R300_CMD_CLEAR_FIFO);
    if (status != HAL_OK) return status;

    // Configure for 7-bit frame (short frame)
    // TX Frame Config: 0 bytes + 7 bits
    status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_FRAME_CONFIG_1, 0x00);
    if (status != HAL_OK) return status;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_FRAME_CONFIG_2, 0x07);
    if (status != HAL_OK) return status;

    // Write command to FIFO
    status = ST25R300_WriteFIFO(dev, &cmd, 1);
    if (status != HAL_OK) return status;

    // Disable CRC and parity for short frame
    uint8_t tx_protocol;
    status = ST25R300_ReadRegister(dev, ST25R300_REG_TX_PROTOCOL_1, &tx_protocol);
    if (status != HAL_OK) return status;

    tx_protocol &= ~0x60;  // Clear tx_crc and a_tx_par bits
    status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_PROTOCOL_1, tx_protocol);
    if (status != HAL_OK) return status;

    // Transmit
    status = ST25R300_SendCommand(dev, ST25R300_CMD_TRANSMIT_DATA);
    if (status != HAL_OK) return status;

    // Restore CRC and parity
    tx_protocol |= 0x60;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_PROTOCOL_1, tx_protocol);

    return status;
}

/**
 * @brief  Send standard ISO14443A command and receive response
 * @param  dev: Pointer to ST25R300 device structure
 * @param  tx_data: Transmit data buffer
 * @param  tx_len: Transmit data length
 * @param  rx_data: Receive data buffer
 * @param  rx_len: Pointer to receive data length
 * @param  timeout_ms: Timeout in milliseconds
 * @retval HAL_StatusTypeDef
 */
HAL_StatusTypeDef ST25R300_Transceive(ST25R300 *dev,
                                     uint8_t *tx_data, uint16_t tx_len,
                                     uint8_t *rx_data, uint16_t *rx_len,
                                     uint32_t timeout_ms)
{
    HAL_StatusTypeDef status;
    uint32_t start_tick = HAL_GetTick();

    // Clear FIFO
    status = ST25R300_SendCommand(dev, ST25R300_CMD_CLEAR_FIFO);
    if (status != HAL_OK) return status;

    // Configure TX frame for standard frame (8-bit bytes)
    status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_FRAME_CONFIG_1, (tx_len >> 5) & 0xFF);
    if (status != HAL_OK) return status;
    status = ST25R300_WriteRegister(dev, ST25R300_REG_TX_FRAME_CONFIG_2, (tx_len & 0x1F) << 3);
    if (status != HAL_OK) return status;

    // Write data to FIFO
    status = ST25R300_WriteFIFO(dev, tx_data, tx_len);
    if (status != HAL_OK) return status;

    // Transmit
    status = ST25R300_SendCommand(dev, ST25R300_CMD_TRANSMIT_DATA);
    if (status != HAL_OK) return status;

    // Wait for response or timeout
    uint8_t irq_status;
    while (1)
    {
        // Check timeout
        if ((HAL_GetTick() - start_tick) > timeout_ms)
        {
            return HAL_TIMEOUT;
        }

        // Read IRQ status
        status = ST25R300_ReadRegister(dev, ST25R300_REG_IRQ_STATUS_1, &irq_status);
        if (status != HAL_OK) return status;

        // Check for RX complete
        if (irq_status & 0x08)  // I_rxe bit
        {
            break;
        }

        // Check for errors
        if (irq_status & 0x01)  // I_rx_err bit
        {
            return HAL_ERROR;
        }

        HAL_Delay(1);
    }

    // Read FIFO status to get received bytes count
    uint8_t fifo_status[2];
    status = ST25R300_ReadRegisters(dev, ST25R300_REG_FIFO_STATUS_1, fifo_status, 2);
    if (status != HAL_OK) return status;

    *rx_len = fifo_status[0] | ((fifo_status[1] & 0x40) << 2);

    if (*rx_len > 0)
    {
        // Read data from FIFO
        status = ST25R300_ReadFIFO(dev, rx_data, *rx_len);
    }

    return status;
}

