// Habilita Mailbox de forma permanente (grava na EEPROM)
// Esta configuração persiste mesmo sem alimentação do MCU
int32_t ST25DV_MB_Enable_Static(st25dv_io_t *io) {
    uint8_t reg_val;

    // 1. Ler o valor atual do registro MB_MODE (0x000D) na área de sistema
    int32_t status = io->i2c_read(ST25DV_ADDR_SYSCFG, ST25DV_REG_MB_MODE, &reg_val, 1);
    if (status != 0) return status;

    // 2. Setar bit 0 (MB_EN) para habilitar permanentemente
    reg_val |= ST25DV_MB_MODE_RW; // bit 0 = 1

    // 3. Escrever de volta no registro (EEPROM)
    status = io->i2c_write(ST25DV_ADDR_SYSCFG, ST25DV_REG_MB_MODE, &reg_val, 1);
    if (status != 0) return status;

    // 4. Aguardar tempo de gravação na EEPROM (típico: 5ms, máx: 10ms)
    io->delay_ms(10);

    return 0;
}

// Desabilita Mailbox de forma permanente (grava na EEPROM)
int32_t ST25DV_MB_Disable_Static(st25dv_io_t *io) {
    uint8_t reg_val;

    // 1. Ler o valor atual do registro MB_MODE (0x000D)
    int32_t status = io->i2c_read(ST25DV_ADDR_SYSCFG, ST25DV_REG_MB_MODE, &reg_val, 1);
    if (status != 0) return status;

    // 2. Limpar bit 0 (MB_EN) para desabilitar permanentemente
    reg_val &= ~ST25DV_MB_MODE_RW; // bit 0 = 0

    // 3. Escrever de volta no registro (EEPROM)
    status = io->i2c_write(ST25DV_ADDR_SYSCFG, ST25DV_REG_MB_MODE, &reg_val, 1);
    if (status != 0) return status;

    // 4. Aguardar tempo de gravação na EEPROM
    io->delay_ms(10);

    return 0;
}

// Lê a configuração permanente do Mailbox (EEPROM)
// Retorna: 0 = Desabilitado, 1 = Habilitado
int32_t ST25DV_MB_ReadConfig_Static(st25dv_io_t *io, uint8_t *mb_enabled) {
    uint8_t reg_val;

    // Ler o registro MB_MODE (0x000D) na área de sistema
    int32_t status = io->i2c_read(ST25DV_ADDR_SYSCFG, ST25DV_REG_MB_MODE, &reg_val, 1);
    if (status != 0) return status;

    // Verificar bit 0
    *mb_enabled = (reg_val & ST25DV_MB_MODE_RW) ? 1 : 0;

    return 0;
}

// Habilita Mailbox no modo dinâmico (volátil - precisa ser chamado toda vez)
int32_t ST25DV_MB_Enable_Dyn(st25dv_io_t *io) {
    uint8_t reg_val;

    // Ler MB_CTRL_Dyn (0x2006)
    int32_t status = io->i2c_read(ST25DV_ADDR_USER_DYN, ST25DV_REG_MB_CTRL_DYN, &reg_val, 1);
    if (status != 0) return status;

    // Setar bit 0 (MB_EN)
    reg_val |= ST25DV_MB_EN_MASK;

    return io->i2c_write(ST25DV_ADDR_USER_DYN, ST25DV_REG_MB_CTRL_DYN, &reg_val, 1);
}

// Versão melhorada do MB_Init que verifica antes de gravar
int32_t ST25DV_MB_Init_Smart(st25dv_io_t *io) {
    uint8_t mb_config;
    int32_t status;

    // 1. Verificar se Mailbox já está configurado permanentemente
    status = ST25DV_MB_ReadConfig_Static(io, &mb_config);

    if (status == 0 && mb_config == 1) {
        // Já está configurado - não precisa regravar na EEPROM
    } else {
        // Primeira vez ou estava desabilitado - configurar agora
        status = ST25DV_MB_Enable_Static(io);
        if (status != 0) return status;
    }

    // 2. Habilitar no modo dinâmico (sempre necessário após boot)
    return ST25DV_MB_Enable_Dyn(io);
}

// Definição do endereço do comando Present Password (System area)
#define ST25DV_I2C_PWD_REG  0x0900
#define ST25DV_VALIDATION_CODE 0x09

int32_t ST25DV_I2C_PresentPassword(st25dv_io_t *io) {
    uint8_t payload[17];
    uint8_t password[8] = {0,0,0,0,0,0,0,0}; // Senha padrão (64 bits de 0)

    // 1. Primeiros 8 bytes da senha
    memcpy(&payload[0], password, 8);

    // 2. Código de Validação para "Present Password" é 0x09 (Não confundir com 0x07 de Write) [cite: 2157]
    payload[8] = 0x09;

    // 3. Repetição da senha (8 bytes)
    memcpy(&payload[9], password, 8);

    // Envia para o registro 0x0900 na área de sistema (0xAE)
    return io->i2c_write(ST25DV_ADDR_SYSCFG, 0x0900, payload, 17);
}

// Nova função para verificar se a sessão realmente abriu
// Lê o registro I2C_SSO_Dyn (0x2004) [cite: 614]
bool ST25DV_I2C_IsSessionOpen(st25dv_io_t *io) {
    uint8_t reg_val = 0;
    // Endereço 0x2004 fica na memória do usuário/dinâmica (E2=0 -> 0xA6/0x53)
    io->i2c_read(ST25DV_ADDR_USER_DYN, 0x2004, &reg_val, 1);

    // Bit 0 = 1 significa Sessão Aberta [cite: 1595]
    return (reg_val & 0x01) ? true : false;
}
