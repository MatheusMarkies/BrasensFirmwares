#ifndef INC_ECU_CONFIG_H_
#define INC_ECU_CONFIG_H_

#include <stdint.h>

typedef enum {
    SENSOR_TYPE_NONE = 0,
    SENSOR_TYPE_TPS,      // Posição da Borboleta
	SENSOR_TYPE_CKP,      // Posição do Virabrequin
	SENSOR_TYPE_CMP,      // Posição do Comando
    SENSOR_TYPE_CLT,      // Temperatura do Motor
    SENSOR_TYPE_IAT,      // Temperatura do Ar
} SensorType_e;

typedef struct {
    uint32_t config_version;
    SensorType_e sensor_channel_map[12];
    // sensor_channel_map[0] = SENSOR_TYPE_TPS significa que o canal 1 é o TPS
} EcuConfig_t;

// Estrutura para armazenar os dados lidos em tempo real.
typedef struct {
    float tps_percent;
    float clt_celsius;
    float position;
    float cmp_position;
    float iat_celsius;
    float map_kpa;
    float o2_lambda;
    float battery_voltage;
} EngineData_t;


#endif /* INC_ECU_CONFIG_H_ */
