#include "main.h"
#include <stdarg.h>
#include <stdio.h>
#include <string.h>

/* Private variables ---------------------------------------------------------*/
I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef hlpuart1;
RTC_HandleTypeDef hrtc;

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_LPUART1_UART_Init(void);
void UART_Test_Raw(void);

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  /* IMPORTANTE: Habilitar clocks ANTES de configurar GPIO */
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_LPUART1_CLK_ENABLE();

  MX_GPIO_Init();
  MX_LPUART1_UART_Init();

  /* USER CODE BEGIN 2 */

  // Aguardar 2 segundos para abrir o Tera Term
  HAL_Delay(2000);

  // TESTE 1: Transmissão RAW sem HAL
  UART_Test_Raw();

  HAL_Delay(500);

  // TESTE 2: Transmissão com HAL - byte único
  uint8_t byte = 'X';
  HAL_StatusTypeDef status;

  for(int i = 0; i < 20; i++) {
    status = HAL_UART_Transmit(&hlpuart1, &byte, 1, 100);
    HAL_Delay(100);
  }

  HAL_Delay(500);

  // TESTE 3: String completa
  uint8_t msg[] = "\r\n=== UART TESTE ===\r\n";
  status = HAL_UART_Transmit(&hlpuart1, msg, strlen((char*)msg), 1000);

  HAL_Delay(500);

  // TESTE 4: Informações de debug
  char buffer[128];

  snprintf(buffer, sizeof(buffer), "LPUART1->CR1: 0x%08lX\r\n", LPUART1->CR1);
  HAL_UART_Transmit(&hlpuart1, (uint8_t*)buffer, strlen(buffer), 1000);

  snprintf(buffer, sizeof(buffer), "LPUART1->ISR: 0x%08lX\r\n", LPUART1->ISR);
  HAL_UART_Transmit(&hlpuart1, (uint8_t*)buffer, strlen(buffer), 1000);

  snprintf(buffer, sizeof(buffer), "RCC->APB1ENR: 0x%08lX\r\n", RCC->APB1ENR);
  HAL_UART_Transmit(&hlpuart1, (uint8_t*)buffer, strlen(buffer), 1000);

  snprintf(buffer, sizeof(buffer), "GPIOA->MODER: 0x%08lX\r\n", GPIOA->MODER);
  HAL_UART_Transmit(&hlpuart1, (uint8_t*)buffer, strlen(buffer), 1000);

  snprintf(buffer, sizeof(buffer), "Status HAL: %d\r\n", status);
  HAL_UART_Transmit(&hlpuart1, (uint8_t*)buffer, strlen(buffer), 1000);

  /* USER CODE END 2 */

  /* Infinite loop */
  uint32_t counter = 0;
  while (1)
  {
    // Loop simples enviando contador
    snprintf(buffer, sizeof(buffer), "CNT: %lu\r\n", counter++);
    HAL_UART_Transmit(&hlpuart1, (uint8_t*)buffer, strlen(buffer), 1000);

    // Toggle do pino LPD para debug visual (se tiver LED/osciloscópio)
    HAL_GPIO_TogglePin(LPD_GPIO_Port, LPD_Pin);

    HAL_Delay(1000);
  }
}

/**
  * @brief Teste RAW - escreve diretamente no registrador da UART
  */
void UART_Test_Raw(void)
{
  // Enviar caractere 'R' diretamente pelo registrador TDR
  char testChars[] = "RRRRR";

  for(int i = 0; i < 5; i++) {
    // Aguardar TXE (Transmit Data Register Empty)
    while(!(LPUART1->ISR & USART_ISR_TXE));

    // Escrever dado no registrador
    LPUART1->TDR = testChars[i];

    // Aguardar transmissão completa
    while(!(LPUART1->ISR & USART_ISR_TC));

    HAL_Delay(100);
  }
}

