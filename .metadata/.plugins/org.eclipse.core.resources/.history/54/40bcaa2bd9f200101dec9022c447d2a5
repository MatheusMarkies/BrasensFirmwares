void ST25R300_Debug_DEBUG_PRINT(const char *format, ...) {
	char buffer[256];
	va_list args;
	va_start(args, format);

	int len = vsnprintf(buffer, sizeof(buffer), format, args);
	va_end(args);

	if (len > 0) {
		HAL_UART_Transmit(&huart2, (uint8_t*) buffer, len, 200);
	}
}

