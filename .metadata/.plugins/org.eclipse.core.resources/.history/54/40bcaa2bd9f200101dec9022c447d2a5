	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_USART2_UART_Init();
	MX_SPI1_Init();
	/* USER CODE BEGIN 2 */
	HAL_StatusTypeDef status;

	LOG("\r\n\r\n");
	LOG("╔══════════════════════════════════════════╗\r\n");
	LOG("║  ST25R300 + ST25DV Demo Application     ║\r\n");
	LOG("║  MailBox & Energy Harvesting System     ║\r\n");
	LOG("║  Version 1.0 - 2026-01-15               ║\r\n");
	LOG("╚══════════════════════════════════════════╝\r\n");

	// Inicializar sistema NFC
	// 1. Configurar a estrutura com os pinos definidos no CubeMX
	  nfcReader.hSPIx = &hspi1; // Ponteiro para o handle da SPI configurada

	  // Pinos de Chip Select (CS)
	  nfcReader.CS_port = NFC_NSS_GPIO_Port; // Defina esses nomes no CubeMX (Label)
	  nfcReader.CS_pin = NFC_NSS_Pin;

	  // Pinos de Reset
	  nfcReader.reset_port = RESET_GPIO_Port;
	  nfcReader.reset_pin = RESET_Pin;

	  // Pinos de Interrupção (IRQ)
	  nfcReader.IRQ_port = IRQ_GPIO_Port;
	  nfcReader.IRQ_pin = IRQ_Pin;

	  // 2. Inicializar o Chip
	  LOG("Iniciando ST25R300...\r\n");
	  if (ST25R300_Init(&nfcReader)) {
		  LOG("ST25R300 Inicializado com Sucesso! ID: 0x%02X\r\n", ST25R300_ReadID(&nfcReader));

	      // 3. Configurar para modo de recepção (NFC-A padrão conforme library)
	      ST25R300_ConfigureRxMode(&nfcReader);
	      ST25R300_EnableRx(&nfcReader);

	      ST25R300_OptimizeForEnergyHarvesting_Single(&nfcReader);

	          // Opcional: Monitorar se houve estouro de corrente
	          uint8_t analog_stat;
	          ST25R300_ReadRegister(&nfcReader, 0x48, &analog_stat);
	          if (analog_stat & (1 << 7)) { // bit i_lim [cite: 2160]
	        	  LOG("Aviso: Limite de corrente de 500mA atingido!\r\n");
	          }
	  } else {
		  LOG("Falha na inicialização do ST25R300.\r\n");
	      Error_Handler();
	  }
	// Loop principal
	uint32_t last_detection = 0;
	/* USER CODE END 2 */

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {

		/* USER CODE END WHILE */

