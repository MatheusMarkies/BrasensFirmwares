#include "stm32l053xx.h"

reg_val = ST25_ReadReg(ST25_REG_IC_IDENTITY);
    if ((reg_val & 0xF8) != 0xB0) {
        sprintf(uart_buf, "[ERRO] Chip ID Invalido: 0x%02X\r\n", reg_val);
        DEBUG_PRINT(uart_buf);
        return; // Aborta se não achar o chip
    }
    DEBUG_PRINT("[OK] Chip Detectado.\r\n");


    uint16_t ST25R300_init(ST25R300* _st25){

    			read = LoRa_read(_st25, RegVersion);
    			if(read == 0x12)
    				return LORA_OK;
    			else
    				return LORA_NOT_FOUND;

    }
