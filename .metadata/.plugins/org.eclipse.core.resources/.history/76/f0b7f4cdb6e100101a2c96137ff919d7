void ST25_WriteReg(uint8_t reg, uint8_t value) {
    // Protocolo: Bit 7 = 0 (Write) | Bits 6-0 = Endereço
    uint8_t addr_byte = reg & 0x7F;

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET); // CS Low
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Transmit(&hspi2, &value, 1, 10);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);   // CS High
}

/**
 * @brief Lê um registrador do ST25R300
 * @param reg Endereço do registrador
 * @return Valor lido (byte)
 */
uint8_t ST25_ReadReg(uint8_t reg) {
    // Protocolo: Bit 7 = 1 (Read) | Bits 6-0 = Endereço
    uint8_t addr_byte = (reg & 0x7F) | 0x80;
    uint8_t rx_data = 0;

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET); // CS Low
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Receive(&hspi2, &rx_data, 1, 10);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);   // CS High

    return rx_data;
}

/**
 * @brief Envia um Comando Direto (Direct Command)
 * @param cmd Código do comando (ex: 0x60 para Set Default)
 */
void ST25_SendDirectCommand(uint8_t cmd) {
    // Comandos diretos são bytes únicos (0x60 a 0xFC)
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET); // CS Low
    HAL_SPI_Transmit(&hspi2, &cmd, 1, 10);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);   // CS High
}

/**
 * @brief Escreve múltiplos bytes no FIFO
 */
void ST25_WriteFIFO(uint8_t *pData, uint16_t size) {
    uint8_t addr_byte = REG_FIFO_DATA & 0x7F; // 0x5F (Write)

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Transmit(&hspi2, pData, size, 100);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);
}

/**
 * @brief Lê múltiplos bytes do FIFO
 */
void ST25_ReadFIFO(uint8_t *pDest, uint16_t size) {
    uint8_t addr_byte = (REG_FIFO_DATA & 0x7F) | 0x80; // 0xDF (Read 0x5F)

    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi2, &addr_byte, 1, 10);
    HAL_SPI_Receive(&hspi2, pDest, size, 100);
    HAL_GPIO_WritePin(GPIOB, ST25_CS_Pin, GPIO_PIN_SET);
}

void ST25_TestCommunication(void) {
    uint8_t reg_val;

    // 1. Resetar o Chip via Software para garantir estado inicial
    ST25_SendDirectCommand(CMD_SET_DEFAULT);
    HAL_Delay(10);

    // 2. Leitura de Identidade (IC Identity Register 0x3F)
    // O ST25R300 deve retornar 0xB0 ou similar (Type 0x16 << 3)
    reg_val = ST25_ReadReg(REG_IC_IDENTITY);
    sprintf(uart_buf, "[TEST] ID Lido: 0x%02X (Esperado: 0xB0-0xB7)\r\n", reg_val);
    HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, strlen(uart_buf), 100);

    // Verificação simples
    if ((reg_val & 0xF8) == 0xB0) { // Mascara a revisão
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] SPI OK! Chip Detectado.\r\n", 32, 100);
    } else {
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] FALHA SPI ou Chip Errado!\r\n", 34, 100);
        return;
    }

    // 3. Teste de Escrita e Leitura (Read/Write Verify)
    // Vamos usar o registrador General Configuration (0x01) para teste
    // Valor padrão é 0x00. Vamos escrever 0x55.

    uint8_t old_val = ST25_ReadReg(REG_GEN_CONFIG);
    ST25_WriteReg(REG_GEN_CONFIG, 0x55);
    uint8_t new_val = ST25_ReadReg(REG_GEN_CONFIG);

    // Restaurar valor original
    ST25_WriteReg(REG_GEN_CONFIG, old_val);

    sprintf(uart_buf, "[TEST] RW Teste: Escrito 0x55, Lido 0x%02X\r\n", new_val);
    HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, strlen(uart_buf), 100);

    if (new_val == 0x55) {
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] Integridade de Registros OK.\r\n", 37, 100);
    } else {
        HAL_UART_Transmit(&huart1, (uint8_t*)"[TEST] Erro de Escrita/Leitura!\r\n", 33, 100);
    }
}

void ST25R300_Init(void) {
    uint8_t reg_val;

    DEBUG_PRINT("\r\n--- INICIANDO ST25R300 (RFO1 / 27.12MHz) ---\r\n");

    // 1. HARDWARE RESET (Obrigatório)
    // O ST25R300 tem Reset ATIVO EM NÍVEL ALTO (High)
    HAL_GPIO_WritePin(GPIOB, SIG_Pin, GPIO_PIN_SET);   // Reset ON
    HAL_Delay(5);
    HAL_GPIO_WritePin(GPIOB, SIG_Pin, GPIO_PIN_RESET); // Reset OFF
    HAL_Delay(5); // Tempo de boot (t_boot típico 138us, max 900us)

    // 2. SOFT RESET & DEFAULT
    // Garante que registradores estão limpos
    ST25_SendDirectCommand(CMD_SET_DEFAULT);
    HAL_Delay(2);

    // 3. VERIFICAÇÃO DE ID (Sanity Check)
    // ST25R300 ID deve começar com '10110' (0x16 << 3 = 0xB0)
    reg_val = ST25_ReadReg(ST25_REG_IC_IDENTITY);
    if ((reg_val & 0xF8) != 0xB0) {
        sprintf(uart_buf, "[ERRO] Chip ID Invalido: 0x%02X\r\n", reg_val);
        DEBUG_PRINT(uart_buf);
        return; // Aborta se não achar o chip
    }
    DEBUG_PRINT("[OK] Chip Detectado.\r\n");

    // 4. HABILITAR OSCILADOR E REGULADORES
    // Reg 0x00 (Operation): Bit 3 (en) = 1, Bit 4 (vdddr_en) = 1
    // Isso liga o Cristal 27.12MHz e o regulador do driver
    ST25_WriteReg(ST25_REG_OP_CONTROL, 0x18);

    // Aguardar estabilização do Oscilador (Bit osc_ok no Status1)
    uint8_t timeout = 100;
    do {
        HAL_Delay(1);
        reg_val = ST25_ReadReg(ST25_REG_STATUS1);
        timeout--;
    } while (!(reg_val & 0x10) && timeout > 0); // Bit 4 = osc_ok

    if (timeout == 0) {
        DEBUG_PRINT("[ERRO] Oscilador 27.12MHz nao estabilizou!\r\n");
    } else {
        DEBUG_PRINT("[OK] Oscilador Estavel.\r\n");
    }

    // 5. CONFIGURAÇÃO DE ANTENA (RFO1 Single Ended)
    // Reg 0x01 (General Config):
    // Bit 5 (Single) = 1 (Single Ended)
    // Bit 4 (rfo2)   = 0 (Usa RFO1)
    ST25_WriteReg(ST25_REG_GEN_CONFIG, 0x20);

    // 6. POTÊNCIA MÁXIMA (Driver Resistance)
    // Reg 0x03 (Tx Driver): d_res = 0x0 (Mínima resistência ~1 Ohm -> Max Corrente)
    // Crucial para Energy Harvesting eficiente
    ST25_WriteReg(ST25_REG_TX_DRIVER, 0x00);

    // 7. CONFIGURAÇÃO DE PROTOCOLO (ISO15693 / NFC-V)
    // Reg 0x14 (Protocol): 0x01 (ISO15693)
    ST25_WriteReg(ST25_REG_PROTOCOL, 0x01);

    // 8. CONFIGURAÇÃO DE MODULAÇÃO (AM vs OOK) - CRÍTICO PARA HARVESTING
    // Se usarmos OOK (100%), o campo desliga nos bits '0', cortando energia do sensor.
    // Usaremos AM (Amplitude Modulation) com profundidade ~10-20%.

    // Reg 0x15 (Tx Protocol 1): Bit 4 (tr_am) = 1 (Habilita AM)
    ST25_WriteReg(ST25_REG_TX_PROTOCOL1, 0x10);

    // Reg 0x04 (Tx Mod 1): Bits 7:4 (am_mod) = 0x2 (Index ~10-14%)
    ST25_WriteReg(ST25_REG_TX_MOD1, 0x20);

    // 9. CALIBRAÇÃO INTERNA
    // Ajusta os reguladores internos e o oscilador RC para melhor performance
    ST25_SendDirectCommand(CMD_ADJUST_REGULATORS);
    HAL_Delay(1);
    ST25_SendDirectCommand(CMD_CALIBRATE_RC);
    HAL_Delay(1);

    DEBUG_PRINT("[OK] ST25R300 Inicializado: Single-Ended RFO1, ISO15693, AM Mod.\r\n");
}
