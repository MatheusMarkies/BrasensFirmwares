void sendAT(char command[], char answer[], int waitForAnswer) {
	char ATcommand[200];
	uint8_t commandBuffer[200] = { 0 };

	uint8_t ATisOK = 0;

	snprintf(ATcommand, sizeof(ATcommand), "AT%s\r\n", command);

	memcpy(commandBuffer, (uint8_t*)ATcommand, strlen(ATcommand) + 1);

    DEBUG_PRINT("Sending AT Command: \r\n");
    DEBUG_PRINT(ATcommand);

    while (!ATisOK) {

    	if(gsmState == 0){
    		HAL_UART_Transmit_IT(&huart2, commandBuffer, sizeof(commandBuffer));
    	}

		if(gsmState == 1){
			if(HAL_GetTick() >= sendTick + 2000){
				DEBUG_PRINT("TimeOut\r\n");
				gsmState = 0;
			}
		}

		if(gsmState == 1){
			HAL_UART_Receive(&huart2, buffer, sizeof(buffer) - 1, 2000);
			buffer[sizeof(buffer) - 1] = '\0';

			ATisOK = !waitForAnswer;

			if (strstr((char*) buffer, "OK")) {
				gsmState = 0;
				ATisOK = 1;
			}else{
				//gsmState = 0;
			}

			DEBUG_PRINT("GSM: \r\n");
			DEBUG_PRINT((char*) buffer);
			memset(buffer, 0, sizeof(buffer));
		}
		HAL_Delay(1000);
	}
}

void modemStart(char *apn, char *user, char *pwd) {
	sendAT("AT", "OK", 1);

	HAL_Delay(1000);
	sendAT("AT+CPIN?", "", 0);

	HAL_Delay(1000);
	sendAT("AT+CREG?", "", 0);

	HAL_Delay(1000);
	sendAT("AT+CGATT?", "", 0);

	HAL_Delay(1000);
	sendAT("AT+CSQ", "", 0);

	HAL_Delay(1000);
    char command[200];
    snprintf(command, sizeof(command), "+CGDCONT=1,\"IP\",\"%s\"", apn);
    sendAT(command, "OK", 1);
    memset(command, 0, sizeof(command));

    HAL_Delay(1000);
    sendAT("+CGATT=1", "OK", 0);
    HAL_Delay(1000);
    sendAT("AT+CSTT?", "", 0);

    HAL_Delay(1000);
    snprintf(command, sizeof(command), "+CSTT=\"%s\",\"%s\",\"%s\"", apn, user, pwd);
    sendAT(command, "OK", 1);
    memset(command, 0, sizeof(command));

	HAL_Delay(1000);
	sendAT("AT+CIICR", "", 0);

	HAL_Delay(1000);
	sendAT("AT+CIFSR", "", 0);

	HAL_Delay(1000);
	sendAT("AT+CIPMUX=1", "", 0);

	/*
	 AT+CPIN?: Verifica o status do PIN do SIM.
	 AT+CREG?: Verifica o status de registro na rede.

	 Sequência de Inicialização:

	 AT+NETCLOSE: Fecha qualquer conexão de rede existente.
	 AT+CGATT=0: Desativa o GPRS.
	 AT+CGATT=1: Ativa o GPRS.
	 AT+CGDCONT: Define o contexto PDP.
	 AT+CSTT: Define o APN, usuário e senha.
	 AT+CIICR: Inicia a conexão sem fio.
	 AT+CIFSR: Obtém o endereço IP.
	 AT+CIPMUX=1: Habilita o modo de múltiplas conexões.
	*/
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
	if (GPIO_Pin == DIO_Pin && started == 1) {
		char msg[256];
		uint8_t rxBuffer[250];
		uint8_t packet_size = LoRa_receive(&myLoRa, rxBuffer, sizeof(rxBuffer));

		DEBUG_PRINT("Size: ");
		snprintf(msg, sizeof(msg), "%d\r\n", packet_size);
		DEBUG_PRINT(msg);

		if (rxBuffer[0] == 'P') {
			DEBUG_PRINT("VP\r\n");

			Transmission_VibrationPackage *receivedPackage =
					(Transmission_VibrationPackage*) rxBuffer;

			DEBUG_PRINT("Key: ");
			DEBUG_PRINT(receivedPackage->key);
			DEBUG_PRINT("\r\n");

			DEBUG_PRINT("Axis: ");
			snprintf(msg, sizeof(msg), "%d\r\n", receivedPackage->axis);
			DEBUG_PRINT(msg);

			DEBUG_PRINT("Start: ");
			snprintf(msg, sizeof(msg), "%d\r\n", receivedPackage->start);
			DEBUG_PRINT(msg);

			DEBUG_PRINT("End: ");
			snprintf(msg, sizeof(msg), "%d\r\n", receivedPackage->end);
			DEBUG_PRINT(msg);

			if (FRAM_WriteStruct(&hi2c1, &metadata, metadata.nextFreeAddress,
					receivedPackage, sizeof(Transmission_VibrationPackage))
					== HAL_OK) {
				DEBUG_PRINT("VP Saved in FRAM\r\n");
			}

		} else if (rxBuffer[0] == 'D') {
			DEBUG_PRINT("Data\r\n");
			Transmission_Data *receivedData = (Transmission_Data*) rxBuffer;

			if (FRAM_WriteStruct(&hi2c1, &metadata, metadata.nextFreeAddress,
					receivedData, sizeof(Transmission_Data)) == HAL_OK) {
				DEBUG_PRINT("Data Saved in FRAM\r\n");
			}
		} else {
			DEBUG_PRINT("Received packet size mismatch.\r\n");
		}

	}
}

