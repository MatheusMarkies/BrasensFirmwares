/* USER CODE BEGIN 0 */
void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim) {
	if (htim->Instance == TIM2 && htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1) {
		if (capture_count < NUM_CAPTURES) {
			captures[capture_count++] = HAL_TIM_ReadCapturedValue(htim,
					TIM_CHANNEL_1);

			if (capture_count >= NUM_CAPTURES) {
				HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);
				capture_done = 1;
			}
		}
	}
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_TIM22_Init();
  /* USER CODE BEGIN 2 */
	HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_1);

	printf("\r\n=== NFC Inductance Meter ===\r\n");
	printf("C = %d pF | TIM2 = %lu Hz\r\n\r\n", (int) (C_KNOWN * 1e12),
	TIM2_CLK_HZ);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	while (1) {
		capture_count = 0;
		capture_done = 0;

		__HAL_TIM_SET_COUNTER(&htim2, 0);
		HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_1);

		HAL_GPIO_WritePin(Signal_GPIO_Port, Signal_Pin, GPIO_PIN_SET);
		__NOP();
		__NOP();
		__NOP();
		__NOP();//250 ns
		HAL_GPIO_WritePin(Signal_GPIO_Port, Signal_Pin, GPIO_PIN_RESET);

		uint32_t t0 = HAL_GetTick();
		while (!capture_done && (HAL_GetTick() - t0) < 100);

		if (!capture_done)
			HAL_TIM_IC_Stop_IT(&htim2, TIM_CHANNEL_1);

		if (capture_done && capture_count >= 2) {
			uint32_t total = 0;
			uint16_t valid = 0;

			for (uint8_t i = 1; i < capture_count; i++) {
				uint32_t diff = captures[i] - captures[i - 1];
				if (diff >= 2 && diff <= 8000) {
					total += diff;
					valid++;
				}
			}

			if (valid > 0) {
				double period = (double) total / valid / TIM2_CLK_HZ;
				double f_res = 1.0 / period;
				double L = 1.0 / (4.0 * M_PI * M_PI * f_res * f_res * C_KNOWN);

				printf("L = %.3f uH | f = %.3f MHz | %d amostras\r\n", L * 1e6,
						f_res / 1e6, valid);
			} else
				printf("ERRO: capturas fora da faixa\r\n");
		} else
			printf("TIMEOUT: %d/%d capturas\r\n", capture_count, NUM_CAPTURES);

		HAL_Delay(1000);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	}
  /* USER CODE END 3 */
}

